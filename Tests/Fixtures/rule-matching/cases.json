    {"name": "an option's value outside", "rules": "main", "command": "ls --dir=/etc",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "outside-path"}},
    {"name": "a path glued to a short option", "rules": "main", "command": "ls -o/tmp/x",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "glued-option"}},
    {"name": "a bare .env", "rules": "main", "command": "cat .env",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "never:.env"}},
    {"name": "a key under ~", "rules": "main", "command": "cat ~/.ssh/id_rsa",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "never:/.ssh/"}},
    {"name": "the repository's git config", "rules": "main", "command": "cat /work/proj/.git/config",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "never:/.git/config"}},

    {"name": "an environment assignment in front", "rules": "main", "command": "FOO=1 git status",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "env"}},
    {"name": "an assignment behind env", "rules": "main", "command": "env FOO=1 git status",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "env"}},
    {"name": "env alone in front is stepped over", "rules": "main", "command": "env git status",
     "expect": {"shape": "bash:git status", "answer": "allow", "would": null, "rule": "r-git-status", "refusal": null}},
    {"name": "command in front is stepped over", "rules": "main", "command": "command git status",
     "expect": {"shape": "bash:git status", "answer": "allow", "would": null, "rule": "r-git-status", "refusal": null}},
    {"name": "env in front of a binary from elsewhere", "rules": "main", "command": "env /tmp/evil/ls",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "outside-command"}},
    {"name": "env and nothing else", "rules": "main", "command": "env",
     "expect": {"shape": "bash:", "answer": "none", "would": null, "rule": null, "refusal": "untokenisable"}},

    {"name": "a tool from a system directory", "rules": "main", "command": "/usr/bin/git status",
     "expect": {"shape": "bash:git status", "answer": "allow", "would": null, "rule": "r-git-status", "refusal": null}},
    {"name": "a tool by the same name from anywhere else", "rules": "main", "command": "/tmp/evil/npm test",
     "expect": {"shape": "bash:npm test", "answer": "none", "would": null, "rule": null, "refusal": "outside-command"}},
    {"name": "a tool inside the directory", "rules": "main", "command": "./bin/ls",
     "expect": {"shape": "bash:ls", "answer": "allow", "would": null, "rule": "r-ls", "refusal": null}},
    {"name": "the root directory as a command", "rules": "main", "command": "/",
     "expect": {"shape": "bash:/", "answer": "none", "would": null, "rule": null, "refusal": "outside-command"}},

    {"name": "an unterminated single quote", "rules": "main", "command": "git status 'unterminated",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "untokenisable"}},
    {"name": "an unterminated double quote", "rules": "main", "command": "git status \"also",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "untokenisable"}},
    {"name": "an apostrophe inside double quotes is closed", "rules": "main", "command": "echo \"it's fine\"",
     "expect": {"shape": "bash:echo", "answer": "allow", "would": null, "rule": "r-echo", "refusal": null}},
    {"name": "a double quote inside single quotes is closed", "rules": "main", "command": "echo 'a\"b'",
     "expect": {"shape": "bash:echo", "answer": "allow", "would": null, "rule": "r-echo", "refusal": null}},
    {"name": "an empty quoted word", "rules": "main", "command": "git status \"\"",
     "expect": {"shape": "bash:git status", "answer": "allow", "would": null, "rule": "r-git-status", "refusal": null}},
    {"name": "a quoted flag is still the flag", "rules": "main", "command": "rm '-rf' x",
     "expect": {"shape": "bash:rm", "answer": "none", "would": null, "rule": null, "refusal": "never:rm -rf"}},
    {"name": "curly quotes around a flag", "rules": "main", "command": "rm \u201c-rf\u201d x",
     "expect": {"shape": "bash:rm", "answer": "none", "would": null, "rule": null, "refusal": "never:rm -rf"}},

    {"name": "rm -rf", "rules": "main", "command": "rm -rf build",
     "expect": {"shape": "bash:rm", "answer": "none", "would": null, "rule": null, "refusal": "never:rm -rf"}},
    {"name": "rm -Rf, a spelling the table does not list", "rules": "main", "command": "rm -Rf build",
     "expect": {"shape": "bash:rm", "answer": "none", "would": null, "rule": null, "refusal": "never:rm -Rf"}},
    {"name": "a long option abbreviated", "rules": "main", "command": "rm --rec x",
     "expect": {"shape": "bash:rm", "answer": "none", "would": null, "rule": null, "refusal": "never:rm --rec"}},
    {"name": "rm of one file inside", "rules": "main", "command": "rm build/x.o",
     "expect": {"shape": "bash:rm", "answer": "allow", "would": null, "rule": "r-rm", "refusal": null}},
    {"name": "a refused subcommand", "rules": "main", "command": "git push",
     "expect": {"shape": "bash:git push", "answer": "none", "would": null, "rule": null, "refusal": "never:git push"}},
    {"name": "a refused flag outranks the subcommand", "rules": "main", "command": "git push --force",
     "expect": {"shape": "bash:git push", "answer": "none", "would": null, "rule": null, "refusal": "never:git --force"}},
    {"name": "setuid by number", "rules": "main", "command": "chmod 4755 run.sh",
     "expect": {"shape": "bash:chmod", "answer": "none", "would": null, "rule": null, "refusal": "never:chmod 4755"}},
    {"name": "write for everybody by symbol", "rules": "main", "command": "chmod +w run.sh",
     "expect": {"shape": "bash:chmod", "answer": "none", "would": null, "rule": null, "refusal": "never:chmod +w"}},
    {"name": "recursive chmod", "rules": "main", "command": "chmod -R 755 .",
     "expect": {"shape": "bash:chmod", "answer": "none", "would": null, "rule": null, "refusal": "never:chmod -R"}},
    {"name": "an ordinary chmod", "rules": "main", "command": "chmod +x run.sh",
     "expect": {"shape": "bash:chmod", "answer": "allow", "would": null, "rule": "r-chmod", "refusal": null}},
    {"name": "an interpreter handed a snippet", "rules": "main", "command": "python3 -c \"print(1)\"",
     "expect": {"shape": "bash:python3", "answer": "none", "would": null, "rule": null, "refusal": "never:python3 -c"}},
    {"name": "an interpreter handed a file", "rules": "main", "command": "python3 script.py",
     "expect": {"shape": "bash:python3", "answer": "allow", "would": null, "rule": "r-python", "refusal": null}},
    {"name": "a search that deletes", "rules": "main", "command": "find . -delete",
     "expect": {"shape": "bash:find", "answer": "none", "would": null, "rule": null, "refusal": "never:find -delete"}},
    {"name": "a search", "rules": "main", "command": "find . -name x",
     "expect": {"shape": "bash:find", "answer": "allow", "would": null, "rule": "r-find", "refusal": null}},

    {"name": "an empty command", "rules": "main", "command": "",
     "expect": {"shape": "bash:", "answer": "none", "would": null, "rule": null, "refusal": "empty"}},
    {"name": "only blanks", "rules": "main", "command": "   ",
     "expect": {"shape": "bash:", "answer": "none", "would": null, "rule": null, "refusal": "empty"}},
    {"name": "a flag where the command should be", "rules": "main", "command": "-rf",
     "expect": {"shape": "bash:-rf", "answer": "none", "would": null, "rule": null, "refusal": "untokenisable"}},
    {"name": "a no-break space is a letter, not a word break", "rules": "main", "command": "git\u00a0status",
     "expect": {"shape": "bash:git\u00a0status", "answer": "none", "would": null, "rule": null, "refusal": null}},
    {"name": "a leading U+FEFF the reader drops: the command is not the one that runs", "rules": "main",
     "requestText": "{\"agent\":\"claude\",\"toolName\":\"Bash\",\"cwd\":\"/work/proj\",\"context\":{\"kind\":\"bash\",\"command\":\"\\ufeffgit status\"}}",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "invisible"}},
    {"name": "a leading U+FEFF written raw", "rules": "main",
     "requestText": "{\"agent\":\"claude\",\"toolName\":\"Bash\",\"cwd\":\"/work/proj\",\"context\":{\"kind\":\"bash\",\"command\":\"$FEFFgit status\"}}",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "invisible"}},
    {"name": "a leading U+FEFF does not stop a denial", "rules": "main",
