{
  "about": [
    "Which rule speaks for a permission request, and why an approval would not be given.",
    "Read by Tests/AgentBarTests/SharedFixtureTests.swift (RuleEngine.verdict, RuleEngine.refusal,",
    "DecisionLedger.shape) and by Scripts/test/shared-fixtures.js (the CLI's decisionShape, and",
    "readRules on every rule set). Only the app applies rules (docs/protocol.md), so the CLI",
    "half is the shape a rule is matched on and the rules file it is read from; the app half is",
    "every field. A case without `request` is a Bash request built from `command`, `cwd`",
    "(default /work/proj) and `agent` (default claude). `refusal` is the class of",
    "RuleEngine.refusal(for:cwd:) for the request whatever the rules say: `never:<x>` is",
    "\"`x` is never approved by a rule\". `answer` is what is written to answers.d; a watching",
    "rule answers none and says what it `would` have answered. The table may only grow.",
    "`requestText` is the request file's exact text instead. In it, and in every `file`, `$FEFF` is a raw U+FEFF:",
    "written as an escape it would never reach the file, because JSONSerialization drops a leading one while reading this fixture."
  ],
  "refusals": {
    "plan": "a plan review is approved in the terminal",
    "question": "a question is not a permission",
    "no-cwd": "nobody knows which directory",
    "invisible": "a request carrying a character the reader drops",
    "no-path": "this tool names nothing a rule can check",
    "not-permission": "not an ordinary permission",
    "empty": "an empty command",
    "chain": "more than one command, a redirect or a substitution",
    "rewrite": "a word the shell rewrites",
    "env": "an environment assignment in front of the command",
    "untokenisable": "a command that will not tokenise",
    "outside-command": "a command run from outside the directory",
    "glued-option": "an option with a path glued to it",
    "outside-path": "a path outside the directory the rule names"
  },
  "rulesets": {
    "main": [
      {"id": "r-git-status", "decision": "allow", "shape": "bash:git status", "cwd": "/work/proj"},
      {"id": "r-git-push", "decision": "allow", "shape": "bash:git push", "cwd": "/work/proj"},
      {"id": "r-ls", "decision": "allow", "shape": "bash:ls", "cwd": "/work/proj"},
      {"id": "r-cat", "decision": "allow", "shape": "bash:cat", "cwd": "/work/proj"},
      {"id": "r-rm", "decision": "allow", "shape": "bash:rm", "cwd": "/work/proj"},
      {"id": "r-echo", "decision": "allow", "shape": "bash:echo", "cwd": "/work/proj"},
      {"id": "r-chmod", "decision": "allow", "shape": "bash:chmod", "cwd": "/work/proj"},
      {"id": "r-python", "decision": "allow", "shape": "bash:python3", "cwd": "/work/proj"},
      {"id": "r-find", "decision": "allow", "shape": "bash:find", "cwd": "/work/proj"},
      {"id": "r-npm-test", "decision": "allow", "shape": "bash:npm test", "cwd": "/work/proj"},
      {"id": "r-curl", "decision": "deny", "shape": "bash:curl", "cwd": "", "tell": "use the fetch tool"},
      {"id": "r-diff", "decision": "allow", "shape": "bash:git diff", "cwd": "/work/proj", "mode": "watch"},
      {"id": "r-npm-install", "decision": "deny", "shape": "bash:npm install", "mode": "watch"},
      {"id": "r-make", "decision": "allow", "shape": "bash:make build", "cwd": "/work/proj", "mode": "off"},
      {"id": "r-pwd", "decision": "allow", "shape": "bash:pwd", "cwd": "/work/proj", "agent": "codex"},
      {"id": "r-edit", "decision": "allow", "shape": "edit:src/*.swift", "cwd": "/work/proj"},
      {"id": "r-edit-other", "decision": "allow", "shape": "edit:other/*.swift", "cwd": "/work/proj"},
      {"id": "r-git-dir", "decision": "allow", "shape": "edit:.git/*", "cwd": "/work/proj"},
      {"id": "r-fetch", "decision": "allow", "shape": "tool:WebFetch", "cwd": "/work/proj"},
      {"id": "r-plan", "decision": "allow", "shape": "tool:ExitPlanMode", "cwd": "/work/proj"},
      {"id": "r-ask", "decision": "allow", "shape": "tool:AskUserQuestion", "cwd": "/work/proj"}
    ],
    "both": [
      {"id": "r-allow-status", "decision": "allow", "shape": "bash:git status", "cwd": "/work/proj"},
      {"id": "r-deny-status", "decision": "deny", "shape": "bash:git status", "cwd": "/work"}
    ]
  },
  "cases": [
    {"name": "the rule's own shape in its own directory", "rules": "main", "command": "git status",
     "expect": {"shape": "bash:git status", "answer": "allow", "would": null, "rule": "r-git-status", "refusal": null}},
    {"name": "trailing blanks are not a second word", "rules": "main", "command": "git status   ",
     "expect": {"shape": "bash:git status", "answer": "allow", "would": null, "rule": "r-git-status", "refusal": null}},
    {"name": "a tab is a word break", "rules": "main", "command": "git\tstatus",
     "expect": {"shape": "bash:git status", "answer": "allow", "would": null, "rule": "r-git-status", "refusal": null}},

    {"name": "chained with ;", "rules": "main", "command": "git status; rm -rf /",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "chained with &&", "rules": "main", "command": "git status && echo hi",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "chained with ||", "rules": "main", "command": "git status || true",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "piped", "rules": "main", "command": "git status | cat",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "backgrounded", "rules": "main", "command": "git status &",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "a leading separator does not empty the shape", "rules": "main", "command": ";git status",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "a newline is a second command", "rules": "main", "command": "ls x\nreboot",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "CRLF is a second command too (one Character to Swift)", "rules": "main", "command": "ls x\r\nreboot",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "a lone carriage return is a second command", "rules": "main", "command": "ls x\rreboot",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "CRLF inside a multiplexer's verb", "rules": "main", "command": "git status\r\ngit push --force",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "$() substitution", "rules": "main", "command": "ls $(whoami)",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "backtick substitution", "rules": "main", "command": "ls `whoami`",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "redirect out", "rules": "main", "command": "ls > out.txt",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "redirect in", "rules": "main", "command": "cat < in.txt",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},
    {"name": "stderr folded into stdout", "rules": "main", "command": "ls 2>&1",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "chain"}},

    {"name": "sudo in front", "rules": "main", "command": "sudo git status",
     "expect": {"shape": "bash:git status", "answer": "none", "would": null, "rule": null, "refusal": "never:sudo"}},
    {"name": "sudo with its own flags", "rules": "main", "command": "sudo -u root ls",
     "expect": {"shape": "bash:-u", "answer": "none", "would": null, "rule": null, "refusal": "never:sudo"}},
    {"name": "doas", "rules": "main", "command": "doas ls",
     "expect": {"shape": "bash:doas", "answer": "none", "would": null, "rule": null, "refusal": "never:doas"}},

    {"name": "a glob star", "rules": "main", "command": "ls *.swift",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "rewrite"}},
    {"name": "a glob question mark", "rules": "main", "command": "ls src/?.swift",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "rewrite"}},
    {"name": "a glob bracket", "rules": "main", "command": "ls [ab].txt",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "rewrite"}},
    {"name": "a brace expansion", "rules": "main", "command": "cat {a,b}.txt",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "rewrite"}},
    {"name": "a parameter", "rules": "main", "command": "cat $HOME/x",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "rewrite"}},
    {"name": "a braced parameter", "rules": "main", "command": "cat ${HOME}",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "rewrite"}},
    {"name": "a backslash escape", "rules": "main", "command": "rm \\-rf x",
     "expect": {"shape": "bash:rm", "answer": "none", "would": null, "rule": null, "refusal": "rewrite"}},

    {"name": "a path in /etc", "rules": "main", "command": "cat /etc/passwd",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "never:/etc/"}},
    {"name": "a path in the parent", "rules": "main", "command": "cat ../other/file.txt",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "outside-path"}},
    {"name": "the parent itself", "rules": "main", "command": "ls ..",
     "expect": {"shape": "bash:ls", "answer": "none", "would": null, "rule": null, "refusal": "outside-path"}},
    {"name": "the directory itself", "rules": "main", "command": "ls .",
     "expect": {"shape": "bash:ls", "answer": "allow", "would": null, "rule": "r-ls", "refusal": null}},
    {"name": "dot-dot climbing out through a subdirectory", "rules": "main", "command": "cat src/../../x",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "outside-path"}},
    {"name": "dot-dot that stays inside", "rules": "main", "command": "cat src/../README.md",
     "expect": {"shape": "bash:cat", "answer": "allow", "would": null, "rule": "r-cat", "refusal": null}},
    {"name": "a sibling whose name starts with the directory's", "rules": "main", "command": "cat /work/project/x",
     "expect": {"shape": "bash:cat", "answer": "none", "would": null, "rule": null, "refusal": "outside-path"}},
    {"name": "an absolute path outside", "rules": "main", "command": "ls /usr/bin",
