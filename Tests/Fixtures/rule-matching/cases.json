    {"name": "a denial anywhere, with no directory at all", "rules": "main", "command": "curl x", "cwd": "",
     "expect": {"shape": "bash:curl", "answer": "deny", "would": null, "rule": "r-curl", "refusal": "no-cwd"}},
    {"name": "a denial wins over an approval", "rules": "both", "command": "git status",
