{
  "about": [
    "What switching one agent off leaves of its config. Each case puts `files` (path under a",
    "temporary HOME -> exact text) in place and unwires `agent`: the app through",
    "HookInstaller.runPass with that agent disabled (Tests/AgentBarTests/SharedFixtureTests.swift),",
    "the CLI through `agentbar unwire <agent>` (Scripts/test/shared-fixtures.js). Then for each",
    "path in `expect`: `json` \u2014 the file parses to exactly this (the two halves format JSON",
    "differently and always have; what is in it may not differ) and a backup sits beside it;",
    "`text` \u2014 these exact bytes, and a backup; `unchanged` \u2014 the same bytes and NO backup (a",
    "file holding nothing of AgentBar's is never rewritten); `removed` \u2014 gone, and kept beside",
    "itself first."
  ],
  "cases": [
    {"name": "claude: our rule out of an event the person shares, theirs stays", "agent": "claude",
     "files": {".claude/settings.json": "{\"model\":\"opus\",\"env\":{\"FOO\":\"1\"},\"hooks\":{\"Stop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"say done\"}]},{\"hooks\":[{\"type\":\"command\",\"command\":\"\\\"/opt/homebrew/bin/node\\\" \\\"/home/u/.agentbar/hooks/claude/update.js\\\" stop\"}]}]}}"},
     "expect": {".claude/settings.json": {"json": {"model": "opus", "env": {"FOO": "1"}, "hooks": {"Stop": [{"hooks": [{"type": "command", "command": "say done"}]}]}}}}},
    {"name": "claude: an event left empty goes, and an emptied hooks goes", "agent": "claude",
     "files": {".claude/settings.json": "{\"theme\":\"dark\",\"hooks\":{\"PermissionRequest\":[{\"matcher\":\"*\",\"hooks\":[{\"type\":\"command\",\"command\":\"node /home/u/.agentbar/hooks/claude/permission.js\",\"timeout\":630}]}],\"Stop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"node /home/u/.agentbar/hooks/claude/update.js stop\"}]}]}}"},
     "expect": {".claude/settings.json": {"json": {"theme": "dark"}}}},
    {"name": "claude: a group of ours that the person added to goes whole", "agent": "claude",
     "files": {".claude/settings.json": "{\"hooks\":{\"Stop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"node /home/u/.agentbar/hooks/claude/update.js stop\"},{\"type\":\"command\",\"command\":\"say done\"}]}],\"PreToolUse\":[{\"matcher\":\"Bash\",\"hooks\":[{\"type\":\"command\",\"command\":\"mine.sh\"}]}]}}"},
     "expect": {".claude/settings.json": {"json": {"hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "mine.sh"}]}]}}}}},
    {"name": "claude: an event that is not a list of rules is left as it is", "agent": "claude",
     "files": {".claude/settings.json": "{\"hooks\":{\"Notes\":\"node /home/u/.agentbar/hooks/claude/x.js\",\"Mixed\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js\"}]},5],\"Stop\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js stop\"}]}]}}"},
     "expect": {".claude/settings.json": {"json": {"hooks": {"Notes": "node /home/u/.agentbar/hooks/claude/x.js", "Mixed": [{"hooks": [{"command": "node /home/u/.agentbar/hooks/claude/update.js"}]}, 5]}}}}},
    {"name": "claude: nested hooks that are not all objects are not read", "agent": "claude",
     "files": {".claude/settings.json": "{\"hooks\":{\"Stop\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js stop\"},\"x\"]}]}}"},
     "expect": {".claude/settings.json": {"unchanged": true}}},
    {"name": "claude: our marker outside a command is not ours", "agent": "claude",
     "files": {".claude/settings.json": "{\n  \"hooks\": {\"Stop\": [{\"description\": \"/.agentbar/hooks/claude/\", \"hooks\": [{\"command\": \"say done\"}]}]}\n}\n"},
     "expect": {".claude/settings.json": {"unchanged": true}}},
    {"name": "claude: another agent's marker is not Claude's", "agent": "claude",
     "files": {".claude/settings.json": "{\"hooks\":{\"Stop\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/gemini/gemini.js\"}]}]}}"},
     "expect": {".claude/settings.json": {"unchanged": true}}},
    {"name": "claude: nothing of ours is never reformatted", "agent": "claude",
     "files": {".claude/settings.json": "{ \"model\":   \"opus\" }"},
     "expect": {".claude/settings.json": {"unchanged": true}}},
    {"name": "claude: hooks that are not an object", "agent": "claude",
     "files": {".claude/settings.json": "{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js\"}]}"},
     "expect": {".claude/settings.json": {"unchanged": true}}},
    {"name": "claude: a file with a comment in it is not JSON and is left alone", "agent": "claude",
     "files": {".claude/settings.json": "{\n  // mine\n  \"hooks\": {\"Stop\": [{\"hooks\": [{\"command\": \"node /home/u/.agentbar/hooks/claude/update.js\"}]}]}\n}\n"},
     "expect": {".claude/settings.json": {"unchanged": true}}},
    {"name": "claude: a trailing comma is not JSON, whatever JSONSerialization says", "agent": "claude",
     "files": {".claude/settings.json": "{\"hooks\":{\"Stop\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js\"}]}]},}"},
     "expect": {".claude/settings.json": {"unchanged": true}}},
    {"name": "claude: a list at the top is left alone", "agent": "claude",
     "files": {".claude/settings.json": "[{\"hooks\":{\"Stop\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js\"}]}}]"},
     "expect": {".claude/settings.json": {"unchanged": true}}},
    {"name": "claude: slashes and non-ASCII survive", "agent": "claude",
     "files": {".claude/settings.json": "{\"statusLine\":{\"command\":\"~/bin/line \\u00e9t\\u00e9 \\ud83d\\ude80\"},\"hooks\":{\"Stop\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js\"}]}]}}"},
     "expect": {".claude/settings.json": {"json": {"statusLine": {"command": "~/bin/line \u00e9t\u00e9 \ud83d\ude80"}}}}},

    {"name": "qwen: runs the claude scripts, so the claude marker", "agent": "qwen",
     "files": {".qwen/settings.json": "{\"hooks\":{\"Stop\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js stop\"}]},{\"hooks\":[{\"command\":\"mine\"}]}]},\"general\":{\"vimMode\":1}}"},
     "expect": {".qwen/settings.json": {"json": {"hooks": {"Stop": [{"hooks": [{"command": "mine"}]}]}, "general": {"vimMode": 1}}}}},
    {"name": "qwen: unwiring Qwen leaves Claude alone", "agent": "qwen",
     "files": {".qwen/settings.json": "{\"hooks\":{\"Stop\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js\"}]}]}}",
               ".claude/settings.json": "{\"hooks\":{\"Stop\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js\"}]}]}}"},
     "expect": {".qwen/settings.json": {"json": {}},
                ".claude/settings.json": {"unchanged": true}}},

    {"name": "gemini: its own marker", "agent": "gemini",
     "files": {".gemini/settings.json": "{\"theme\":\"x\",\"hooks\":{\"AfterAgent\":[{\"matcher\":\"*\",\"hooks\":[{\"type\":\"command\",\"command\":\"node /home/u/.agentbar/hooks/gemini/gemini.js AfterAgent\"}]}],\"BeforeTool\":[{\"hooks\":[{\"command\":\"mine\"}]}]}}"},
     "expect": {".gemini/settings.json": {"json": {"theme": "x", "hooks": {"BeforeTool": [{"hooks": [{"command": "mine"}]}]}}}}},
    {"name": "gemini: the claude marker is not Gemini's", "agent": "gemini",
     "files": {".gemini/settings.json": "{\"hooks\":{\"AfterAgent\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/claude/update.js\"}]}]}}"},
     "expect": {".gemini/settings.json": {"unchanged": true}}},
    {"name": "gemini: unwiring Gemini leaves Antigravity alone", "agent": "gemini",
     "files": {".gemini/settings.json": "{\"hooks\":{\"AfterAgent\":[{\"hooks\":[{\"command\":\"node /home/u/.agentbar/hooks/gemini/gemini.js\"}]}]}}",
               ".gemini/antigravity/hooks.json": "{\"agentbar\":{\"PostToolUse\":[]}}"},
     "expect": {".gemini/settings.json": {"json": {}},
                ".gemini/antigravity/hooks.json": {"unchanged": true}}},

    {"name": "cursor: the flat shape, version kept", "agent": "cursor",
     "files": {".cursor/hooks.json": "{\"version\":1,\"hooks\":{\"beforeShellExecution\":[{\"command\":\"/home/u/.agentbar/hooks/cursor/cursor.js before\"},{\"command\":\"./mine.sh\"}],\"stop\":[{\"command\":\"/home/u/.agentbar/hooks/cursor/cursor.js stop\"}]}}"},
     "expect": {".cursor/hooks.json": {"json": {"version": 1, "hooks": {"beforeShellExecution": [{"command": "./mine.sh"}]}}}}},
    {"name": "cursor: all of it ours", "agent": "cursor",
     "files": {".cursor/hooks.json": "{\"version\":1,\"hooks\":{\"stop\":[{\"command\":\"/home/u/.agentbar/hooks/cursor/cursor.js stop\"}]}}"},
     "expect": {".cursor/hooks.json": {"json": {"version": 1}}}},

    {"name": "antigravity: our one top-level key, in both directories", "agent": "antigravity",
     "files": {".gemini/antigravity/hooks.json": "{\"agentbar\":{\"PostToolUse\":[{\"command\":\"/home/u/.agentbar/hooks/antigravity/antigravity.js\"}]},\"mine\":{\"PostToolUse\":[]}}",
               ".gemini/antigravity-cli/hooks.json": "{\"agentbar\":{}}"},
     "expect": {".gemini/antigravity/hooks.json": {"json": {"mine": {"PostToolUse": []}}},
                ".gemini/antigravity-cli/hooks.json": {"json": {}}}},
    {"name": "antigravity: a key of null is still our key", "agent": "antigravity",
     "files": {".gemini/antigravity/hooks.json": "{\"agentbar\":null,\"x\":1}"},
     "expect": {".gemini/antigravity/hooks.json": {"json": {"x": 1}}}},
    {"name": "antigravity: no key of ours", "agent": "antigravity",
     "files": {".gemini/antigravity/hooks.json": "{\"mine\": {}}"},
     "expect": {".gemini/antigravity/hooks.json": {"unchanged": true}}},
    {"name": "antigravity: our name nested is not our key", "agent": "antigravity",
     "files": {".gemini/antigravity/hooks.json": "{\"mine\":{\"agentbar\":1}}"},
     "expect": {".gemini/antigravity/hooks.json": {"unchanged": true}}},

    {"name": "codex: the block, the blank line above it and our notify go", "agent": "codex",
     "files": {".codex/config.toml": "model = \"o3\"\nnotify = [\"/opt/homebrew/bin/node\", \"/home/u/.agentbar/hooks/codex/notify.js\"]\n\n[profiles.mine]\nmodel = \"o4\"\n\n# >>> agentbar >>> written by AgentBar; edit outside these two lines\n[[hooks.Stop]]\n[[hooks.Stop.hooks]]\ntype = \"command\"\ncommand = \"\\\"/opt/homebrew/bin/node\\\" \\\"/home/u/.agentbar/hooks/codex/hook.js\\\" update.js stop\"\ntimeout = 30\n\n# <<< agentbar <<<\n"},
     "expect": {".codex/config.toml": {"text": "model = \"o3\"\n\n[profiles.mine]\nmodel = \"o4\"\n"}}},
    {"name": "codex: someone else's notify stays", "agent": "codex",
     "files": {".codex/config.toml": "notify = [\"terminal-notifier\", \"-title\", \"Codex\"]\n\n# >>> agentbar >>> written by AgentBar; edit outside these two lines\n[[hooks.Stop]]\n# <<< agentbar <<<\n"},
     "expect": {".codex/config.toml": {"text": "notify = [\"terminal-notifier\", \"-title\", \"Codex\"]\n"}}},
    {"name": "codex: our marker in a comment is not our notify", "agent": "codex",
     "files": {".codex/config.toml": "# notify = [\"node\", \"/home/u/.agentbar/hooks/codex/notify.js\"]\nmodel = \"o3\"\n"},
     "expect": {".codex/config.toml": {"unchanged": true}}},
    {"name": "codex: an indented notify of ours, split over lines", "agent": "codex",
     "files": {".codex/config.toml": "model = \"o3\"\n  notify = [\n  \"node\",\n  \"/home/u/.agentbar/hooks/codex/notify.js\",\n]\n[tui]\nx = 1\n"},
     "expect": {".codex/config.toml": {"text": "model = \"o3\"\n[tui]\nx = 1\n"}}},
    {"name": "codex: a begin marker with no end is not a block", "agent": "codex",
     "files": {".codex/config.toml": "model = \"o3\"\n# >>> agentbar >>> written by AgentBar; edit outside these two lines\n[[hooks.Stop]]\n"},
     "expect": {".codex/config.toml": {"unchanged": true}}},
    {"name": "codex: no final newline after the block", "agent": "codex",
     "files": {".codex/config.toml": "model = \"o3\"\n\n# >>> agentbar >>> written by AgentBar; edit outside these two lines\n[[hooks.Stop]]\n# <<< agentbar <<<"},
     "expect": {".codex/config.toml": {"text": "model = \"o3\"\n"}}},
    {"name": "codex: CRLF line ends", "agent": "codex",
     "files": {".codex/config.toml": "model = \"o3\"\r\nnotify = [\"node\", \"/home/u/.agentbar/hooks/codex/notify.js\"]\r\n# >>> agentbar >>> written by AgentBar; edit outside these two lines\r\n[[hooks.Stop]]\r\n# <<< agentbar <<<\r\nx = 1\r\n"},
     "expect": {".codex/config.toml": {"text": "model = \"o3\"\r\n\r\n\r\nx = 1\r\n"}}},
    {"name": "codex: nothing of ours", "agent": "codex",
     "files": {".codex/config.toml": "model = \"o3\"\n"},
     "expect": {".codex/config.toml": {"unchanged": true}}},

    {"name": "copilot: the file is ours, so it goes; the person's stays", "agent": "copilot",
     "files": {".copilot/hooks/agentbar.json": "{\"version\":1,\"hooks\":{\"sessionStart\":[{\"type\":\"command\",\"bash\":\"node /home/u/.agentbar/hooks/claude/update.js\"}]}}",
               ".copilot/hooks/mine.json": "{\"version\":1,\"hooks\":{}}"},
     "expect": {".copilot/hooks/agentbar.json": {"removed": true},
                ".copilot/hooks/mine.json": {"unchanged": true}}},
    {"name": "opencode: the plugin is ours, so it goes", "agent": "opencode",
     "files": {".config/opencode/plugins/agentbar.js": "export const AgentBar = async () => ({});\n",
               ".config/opencode/plugins/mine.js": "export const Mine = async () => ({});\n"},
     "expect": {".config/opencode/plugins/agentbar.js": {"removed": true},
                ".config/opencode/plugins/mine.js": {"unchanged": true}}}
  ]
}
