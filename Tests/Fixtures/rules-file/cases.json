{
  "about": [
    "Whether ~/.agentbar/rules.json is in force, and if not, which refusal says why.",
    "Read by Tests/AgentBarTests/SharedFixtureTests.swift (RulesStore.load) and by",
    "Scripts/test/shared-fixtures.js (the CLI's readRules). `file` is the file's exact text;",
    "null means there is no file. A refusal is matched by the needle each half's message",
    "carries (`classes`). The app refuses the WHOLE file on any refusal (docs/protocol.md),",
    "so a check one half makes and the other does not is a file `agentbar rules` lists as in",
    "force while the app applies none of it \u2014 or the other way round. `$FEFF` in a file is a raw U+FEFF (see rule-matching)."
  ],
  "classes": {
    "json":           {"swift": "is not valid JSON",               "cli": "not valid JSON"},
    "version":        {"swift": "says version",                    "cli": "version "},
    "duplicate-key":  {"swift": "repeats the key",                 "cli": "repeats the key"},
    "list":           {"swift": "has no `rules` list",             "cli": "no `rules` list"},
    "missing":        {"swift": "is missing `id`, `decision` or `shape`", "cli": "is missing `id`, `decision` or `shape`"},
    "not-text":       {"swift": "that is not text",                "cli": "that is not text"},
    "empty-id":       {"swift": "has an empty `id`",               "cli": "an empty id"},
    "duplicate-id":   {"swift": "repeats an `id` used above",      "cli": "repeats an id used above"},
    "decision":       {"swift": "it must be \"allow\" or \"deny\"", "cli": "decision is not allow or deny"},
    "empty-shape":    {"swift": "has an empty `shape`",            "cli": "has an empty shape"},
    "unscoped-allow": {"swift": "approves without naming a directory", "cli": "approves without naming a directory"},
    "relative-cwd":   {"swift": "is not an absolute path",         "cli": "is not an absolute path"},
    "unplain-cwd":    {"swift": "is not written plainly",          "cli": "is not written plainly"},
    "allow-tell":     {"swift": "approves and carries `tell`",     "cli": "approves and carries tell"},
    "mode":           {"swift": "it must be \"on\", \"watch\" or \"off\"", "cli": "mode is not on, watch or off"}
  },
  "cases": [
    {"name": "no file is no rules, not an error", "file": null, "expect": {"state": "none"}},
    {"name": "an empty list", "file": "{\"v\":1,\"rules\":[]}", "expect": {"state": "rules", "ids": []}},
    {"name": "two rules, in file order",
     "file": "{\"v\":1,\"rules\":[{\"id\":\"r-b\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/w\"},{\"id\":\"r-a\",\"decision\":\"deny\",\"shape\":\"bash:curl\"}]}",
     "expect": {"state": "rules", "ids": ["r-b", "r-a"]}},
    {"name": "every field the app writes",
     "file": "{\n  \"rules\" : [\n    {\n      \"agent\" : \"\",\n      \"created\" : 1789646400,\n      \"cwd\" : \"\\/work\\/proj\",\n      \"decision\" : \"allow\",\n      \"id\" : \"r-1\",\n      \"mode\" : \"watch\",\n      \"note\" : \"read-only\",\n      \"shape\" : \"bash:git status\",\n      \"tell\" : \"\"\n    }\n  ],\n  \"v\" : 1\n}",
     "expect": {"state": "rules", "ids": ["r-1"]}},
    {"name": "a byte-order mark in front", "file": "$FEFF{\"v\":1,\"rules\":[]}", "expect": {"state": "rules", "ids": []}},
    {"name": "1.0 is the number 1", "file": "{\"v\":1.0,\"rules\":[]}", "expect": {"state": "rules", "ids": []}},
    {"name": "a cwd of / is plain", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"cwd\":\"/\"}]}",
     "expect": {"state": "rules", "ids": ["r"]}},
    {"name": "a tell of blanks says nothing", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:x\",\"cwd\":\"/w\",\"tell\":\" \\t\\n\"}]}",
     "expect": {"state": "rules", "ids": ["r"]}},
    {"name": "a tell of no-break spaces says nothing", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:x\",\"cwd\":\"/w\",\"tell\":\"\\u00a0\"}]}",
     "expect": {"state": "rules", "ids": ["r"]}},
    {"name": "a key name that appears as a value is not a repeat",
     "file": "{\"v\":1,\"rules\":[{\"note\":\"id\",\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\"},{\"id\":\"s\",\"decision\":\"deny\",\"shape\":\"bash:y\"}]}",
     "expect": {"state": "rules", "ids": ["r", "s"]}},
    {"name": "quotes and braces inside a string", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"note\":\"a \\\"}\\\" {,\\\\\",\"decision\":\"deny\",\"shape\":\"bash:x\"}]}",
     "expect": {"state": "rules", "ids": ["r"]}},

    {"name": "an empty file", "file": "", "expect": {"state": "invalid", "class": "json"}},
    {"name": "not JSON", "file": "not json", "expect": {"state": "invalid", "class": "json"}},
    {"name": "a trailing comma", "file": "{\"v\":1,\"rules\":[],}", "expect": {"state": "invalid", "class": "json"}},
    {"name": "a list at the top", "file": "[]", "expect": {"state": "invalid", "class": "json"}},
    {"name": "null at the top", "file": "null", "expect": {"state": "invalid", "class": "json"}},
    {"name": "a newer version", "file": "{\"v\":2,\"rules\":[]}", "expect": {"state": "invalid", "class": "version"}},
    {"name": "no version", "file": "{\"rules\":[]}", "expect": {"state": "invalid", "class": "version"}},
    {"name": "a version as text", "file": "{\"v\":\"1\",\"rules\":[]}", "expect": {"state": "invalid", "class": "version"}},
    {"name": "a fractional version", "file": "{\"v\":1.5,\"rules\":[]}", "expect": {"state": "invalid", "class": "version"}},
    {"name": "a version of true", "file": "{\"v\":true,\"rules\":[]}", "expect": {"state": "invalid", "class": "version"}},
    {"name": "no rules list", "file": "{\"v\":1}", "expect": {"state": "invalid", "class": "list"}},
    {"name": "rules as an object", "file": "{\"v\":1,\"rules\":{}}", "expect": {"state": "invalid", "class": "list"}},
    {"name": "a rule that is a number", "file": "{\"v\":1,\"rules\":[5]}", "expect": {"state": "invalid", "class": "list"}},
    {"name": "a rule that is null", "file": "{\"v\":1,\"rules\":[null]}", "expect": {"state": "invalid", "class": "list"}},

    {"name": "a key written twice in a rule: deny, then allow",
     "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:git push\",\"cwd\":\"/w\",\"decision\":\"allow\"}]}",
     "expect": {"state": "invalid", "class": "duplicate-key"}},
    {"name": "a mode written twice: watch, then on",
     "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/w\",\"mode\":\"watch\",\"mode\":\"on\"}]}",
     "expect": {"state": "invalid", "class": "duplicate-key"}},
    {"name": "a key written twice at the top", "file": "{\"v\":1,\"rules\":[],\"v\":1}", "expect": {"state": "invalid", "class": "duplicate-key"}},
    {"name": "the same key, once escaped",
     "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"\\u0064ecision\":\"allow\"}]}",
     "expect": {"state": "invalid", "class": "duplicate-key"}},

    {"name": "no id", "file": "{\"v\":1,\"rules\":[{\"decision\":\"deny\",\"shape\":\"bash:x\"}]}", "expect": {"state": "invalid", "class": "missing"}},
    {"name": "an id that is a number", "file": "{\"v\":1,\"rules\":[{\"id\":5,\"decision\":\"deny\",\"shape\":\"bash:x\"}]}", "expect": {"state": "invalid", "class": "missing"}},
    {"name": "no decision", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"shape\":\"bash:x\"}]}", "expect": {"state": "invalid", "class": "missing"}},
    {"name": "no shape", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\"}]}", "expect": {"state": "invalid", "class": "missing"}},
    {"name": "a shape that is a list", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":[\"bash:x\"]}]}", "expect": {"state": "invalid", "class": "missing"}},
    {"name": "an agent that is a number widened an approval to every agent",
     "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/w\",\"agent\":5}]}",
     "expect": {"state": "invalid", "class": "not-text"}},
    {"name": "a cwd of null", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"cwd\":null}]}", "expect": {"state": "invalid", "class": "not-text"}},
    {"name": "a note that is a list", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"note\":[]}]}", "expect": {"state": "invalid", "class": "not-text"}},
    {"name": "a tell that is an object", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"tell\":{}}]}", "expect": {"state": "invalid", "class": "not-text"}},
    {"name": "an empty id", "file": "{\"v\":1,\"rules\":[{\"id\":\"\",\"decision\":\"deny\",\"shape\":\"bash:x\"}]}", "expect": {"state": "invalid", "class": "empty-id"}},
    {"name": "an id used twice", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\"},{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:y\"}]}", "expect": {"state": "invalid", "class": "duplicate-id"}},
    {"name": "a decision that is neither", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"ask\",\"shape\":\"bash:x\"}]}", "expect": {"state": "invalid", "class": "decision"}},
    {"name": "a decision in capitals", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"Allow\",\"shape\":\"bash:x\",\"cwd\":\"/w\"}]}", "expect": {"state": "invalid", "class": "decision"}},
    {"name": "an empty shape", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"\"}]}", "expect": {"state": "invalid", "class": "empty-shape"}},
    {"name": "an approval with no cwd", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\"}]}", "expect": {"state": "invalid", "class": "unscoped-allow"}},
    {"name": "an approval with an empty cwd", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"\"}]}", "expect": {"state": "invalid", "class": "unscoped-allow"}},
    {"name": "a relative cwd", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"work/proj\"}]}", "expect": {"state": "invalid", "class": "relative-cwd"}},
    {"name": "a home-relative cwd", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:ls\",\"cwd\":\"~/proj\"}]}", "expect": {"state": "invalid", "class": "relative-cwd"}},
    {"name": "a trailing slash", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/work/proj/\"}]}", "expect": {"state": "invalid", "class": "unplain-cwd"}},
    {"name": "a doubled slash", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/work//proj\"}]}", "expect": {"state": "invalid", "class": "unplain-cwd"}},
    {"name": "a dot", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/work/./proj\"}]}", "expect": {"state": "invalid", "class": "unplain-cwd"}},
    {"name": "a dot-dot", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/work/x/../proj\"}]}", "expect": {"state": "invalid", "class": "unplain-cwd"}},
    {"name": "an approval that tells", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/w\",\"tell\":\"x\"}]}", "expect": {"state": "invalid", "class": "allow-tell"}},
    {"name": "a string's leading U+FEFF is dropped, so a tell of one says nothing", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/w\",\"tell\":\"\\ufeff\"}]}", "expect": {"state": "rules", "ids": ["r"]}},
    {"name": "two ids that differ by a leading U+FEFF are one id", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\"},{\"id\":\"\\ufeffr\",\"decision\":\"deny\",\"shape\":\"bash:y\"}]}", "expect": {"state": "invalid", "class": "duplicate-id"}},
    {"name": "a U+FEFF anywhere else in a string is kept", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\"},{\"id\":\"r\\ufeff\",\"decision\":\"deny\",\"shape\":\"bash:y\"}]}", "expect": {"state": "rules", "ids": ["r", "r\ufeff"]}},
    {"name": "a cwd behind a leading U+FEFF is that cwd", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"\\ufeff/w\"}]}", "expect": {"state": "rules", "ids": ["r"]}},
    {"name": "two keys that differ by a leading U+FEFF are one key", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"\\ufeffdecision\":\"allow\"}]}", "expect": {"state": "invalid", "class": "duplicate-key"}},
    {"name": "a trailing comma inside a rule", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",}]}", "expect": {"state": "invalid", "class": "json"}},
    {"name": "a trailing comma after the last rule", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\"} , ]}", "expect": {"state": "invalid", "class": "json"}},
    {"name": "a comma inside a string is not a trailing comma", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"note\":\",}\"}]}", "expect": {"state": "rules", "ids": ["r"]}},
    {"name": "a number too large to be one", "file": "{\"v\":1,\"rules\":[],\"x\":1e400}", "expect": {"state": "invalid", "class": "json"}},
    {"name": "half a surrogate pair", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\\ud800\",\"decision\":\"deny\",\"shape\":\"bash:x\"}]}", "expect": {"state": "invalid", "class": "json"}},
    {"name": "a mode that is a typo", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"mode\":\"yes\"}]}", "expect": {"state": "invalid", "class": "mode"}},
    {"name": "a mode in capitals", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"mode\":\"ON\"}]}", "expect": {"state": "invalid", "class": "mode"}},
    {"name": "a mode of null", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"mode\":null}]}", "expect": {"state": "invalid", "class": "mode"}},
    {"name": "a mode that is a number", "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"mode\":1}]}", "expect": {"state": "invalid", "class": "mode"}},

    {"name": "the first refusal is the one named: tell before mode",
     "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"allow\",\"shape\":\"bash:ls\",\"cwd\":\"/w\",\"tell\":\"x\",\"mode\":\"yes\"}]}",
     "expect": {"state": "invalid", "class": "allow-tell"}},
    {"name": "the first refusal is the one named: decision before shape",
     "file": "{\"v\":1,\"rules\":[{\"id\":\"r\",\"decision\":\"ask\",\"shape\":\"\"}]}",
     "expect": {"state": "invalid", "class": "decision"}},
    {"name": "the first refusal is the one named: a field before the id",
     "file": "{\"v\":1,\"rules\":[{\"id\":\"\",\"decision\":\"deny\",\"shape\":\"bash:x\",\"agent\":1}]}",
     "expect": {"state": "invalid", "class": "not-text"}},
    {"name": "one bad rule after good ones voids them all",
     "file": "{\"v\":1,\"rules\":[{\"id\":\"r-1\",\"decision\":\"deny\",\"shape\":\"bash:curl\"},{\"id\":\"r-2\",\"decision\":\"allow\",\"shape\":\"bash:ls\"}]}",
     "expect": {"state": "invalid", "class": "unscoped-allow"}}
  ]
}
