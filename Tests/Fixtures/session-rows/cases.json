{
  "about": [
    "What a frontend does with one ~/.agentbar/state.d row: `kept` (false: pruned, the file",
    "deleted), `visible` (listed), and the `agentName` it shows. `row` is the file's exact",
    "text, with $LIVE (a pid that is running: the test's own), $DEAD (one that is not) and",
    "$NOW (the current Unix time, $NOW-N for N seconds ago) filled in. Read by",
    "Tests/AgentBarTests/SharedFixtureTests.swift (Session, SessionStore.isLive) and by",
    "Scripts/test/shared-fixtures.js (the CLI's sessions()). docs/protocol.md: a row whose",
    "pid is dead or whose ts is older than 24 h is pruned; only an explicit `started: false`",
    "hides one; anything that is not a number of the right kind is no pid and no time."
  ],
  "cases": [
    {"name": "a live row", "row": "{\"agent\":\"claude\",\"state\":\"tool\",\"pid\":$LIVE,\"ts\":$NOW,\"started\":true}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "a dead pid is pruned", "row": "{\"agent\":\"claude\",\"state\":\"tool\",\"pid\":$DEAD,\"ts\":$NOW}",
     "expect": {"kept": false, "visible": false, "agentName": ""}},
    {"name": "a day-old row is pruned", "row": "{\"agent\":\"claude\",\"state\":\"idle\",\"pid\":$LIVE,\"ts\":$NOW-90000}",
     "expect": {"kept": false, "visible": false, "agentName": ""}},
    {"name": "no pid and no ts is kept", "row": "{\"agent\":\"x\",\"state\":\"idle\"}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "a pid written as text is no pid", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"pid\":\"123\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "a fractional pid is no pid", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"pid\":1.5,\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "a pid past 32 bits is no pid", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"pid\":99999999999,\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "a negative pid is no pid", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"pid\":-5,\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "a ts written as text is no time", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"ts\":\"5\"}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "a ts past the year 3000 is no time", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"ts\":1e300}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "started false hides it", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"pid\":$LIVE,\"ts\":$NOW,\"started\":false}",
     "expect": {"kept": true, "visible": false, "agentName": ""}},
    {"name": "started 0 is not false", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"pid\":$LIVE,\"ts\":$NOW,\"started\":0}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "started \"false\" is not false", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"ts\":$NOW,\"started\":\"false\"}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "started null is not false", "row": "{\"agent\":\"x\",\"state\":\"idle\",\"ts\":$NOW,\"started\":null}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "a list is not a row, and is not deleted either", "row": "[{\"agent\":\"x\",\"pid\":$DEAD}]",
     "expect": {"kept": true, "visible": false, "agentName": ""}},
    {"name": "a torn write is not a row, and is not deleted either", "row": "{\"agent\":\"x\",\"sta",
     "expect": {"kept": true, "visible": false, "agentName": ""}},

    {"name": "a plain name", "row": "{\"agent\":\"aider\",\"agent_name\":\"Aider\",\"state\":\"idle\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": "Aider"}},
    {"name": "an escape sequence cannot repaint a terminal", "row": "{\"agent\":\"x\",\"agent_name\":\"  \\u001b[31mBridge\\u001b[0m  \",\"state\":\"idle\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": "[31mBridge[0m"}},
    {"name": "a newline cannot split a row", "row": "{\"agent\":\"x\",\"agent_name\":\"two\\nlines\",\"state\":\"idle\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": "twolines"}},
    {"name": "format characters go too", "row": "{\"agent\":\"x\",\"agent_name\":\"zero\\u200bwidth\\u200e\",\"state\":\"idle\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": "zerowidth"}},
    {"name": "no-break spaces are trimmed", "row": "{\"agent\":\"x\",\"agent_name\":\"\\u00a0Name\\u00a0\",\"state\":\"idle\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": "Name"}},
    {"name": "twenty-four characters, and no blank left at the cut", "row": "{\"agent\":\"x\",\"agent_name\":\"abcdefghijklmnopqrstuvw xyz and more\",\"state\":\"idle\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": "abcdefghijklmnopqrstuvw"}},
    {"name": "characters, not code units, are counted", "row": "{\"agent\":\"x\",\"agent_name\":\"\\u00e9\\u00e9\\u00e9\\u00e9\\u00e9\\u00e9\\u00e9\\u00e9\\u00e9\\u00e9\\u00e9\\u00e9\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\\ud83d\\ude80\",\"state\":\"idle\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": "\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\ud83d\ude80\ud83d\ude80\ud83d\ude80\ud83d\ude80\ud83d\ude80\ud83d\ude80\ud83d\ude80\ud83d\ude80\ud83d\ude80\ud83d\ude80\ud83d\ude80\ud83d\ude80"}},
    {"name": "a name that is only blanks is none", "row": "{\"agent\":\"x\",\"agent_name\":\"   \",\"state\":\"idle\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": ""}},
    {"name": "a name that is not text is none", "row": "{\"agent\":\"x\",\"agent_name\":5,\"state\":\"idle\",\"ts\":$NOW}",
     "expect": {"kept": true, "visible": true, "agentName": ""}}
  ]
}
