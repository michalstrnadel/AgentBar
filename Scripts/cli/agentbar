  if (!customBase) return;
  console.error(`agentbar ${cmd}: not under AGENTBAR_HOME=${base} — it writes the real agent configs `
    + "in this HOME, which would point at hooks under that root; unset it, or borrow HOME instead (HOME=$(mktemp -d))");
  process.exit(2);
}

// `agentbar wire <id>` / `agentbar unwire <id>`: the choice is saved first — so the
// next install-hooks (and the macOS app's next launch) agrees with it even if this
// run fails part way — and then that one agent is wired or unwired, nobody else.
