const CODEX_BEGIN = "# >>> agentbar >>> written by AgentBar; edit outside these two lines";
const CODEX_END = "# <<< agentbar <<<";

// MARK: - Unwiring (an agent the person switched off)

// The rules in `hooks` that run one of our scripts, gone, and any event left empty
// with them — HookInstaller.strippingOurs. A rule is ours when the marker is in its
// own `command` (Cursor's flat shape) or in any nested `hooks[].command` (Claude,
// Qwen, Gemini). A value that is not a list of rules is left exactly as it is.
function strippingOurs(hooks, marker) {
  const has = (v) => typeof v === "string" && v.includes(marker);
  const ours = (rule) => has(rule.command) ||
    (Array.isArray(rule.hooks) && rule.hooks.every(isPlainObject) ? rule.hooks : []).some((h) => has(h.command));
  const out = Object.assign({}, hooks);
  let removed = false;
  for (const [event, value] of Object.entries(hooks)) {
    if (!Array.isArray(value) || !value.every(isPlainObject)) continue;
    const rules = value.filter((r) => !ours(r));
    if (rules.length === value.length) continue;
    removed = true;
    if (rules.length) out[event] = rules; else delete out[event];
  }
  return { hooks: out, removed };
}

// Our rules out of a config that keeps them among the person's under `hooks`; an
// emptied `hooks` goes; serialized exactly the way install-hooks serializes. A file
// holding nothing of ours is not rewritten at all — unwiring must never reformat a
// file it had no part in. Returns whether it wrote.
function unwireHooksJSON(file, marker) {
  if (!fs.existsSync(file)) return false;
  const root = readConfigFile(file);
  if (!isPlainObject(root) || !isPlainObject(root.hooks)) return false;
  const { hooks, removed } = strippingOurs(root.hooks, marker);
  if (!removed) return false;
  if (Object.keys(hooks).length) root.hooks = hooks; else delete root.hooks;
  return writeConfig(file, sortedStringify(root) + "\n");
}

// The config without AgentBar's hooks block and without AgentBar's own `notify`
// line — HookInstaller.codexUnwired, the inverse of what install-hooks writes, so
// wiring and then unwiring a file gives back the file (bar a final newline the
// install had to add). Someone else's notify is never touched, and neither is our
// marker in a shape the notify pattern cannot read (a comment, say).
function codexUnwired(config) {
  let text = config;
  const b = text.indexOf(CODEX_BEGIN);
  const e = b < 0 ? -1 : text.indexOf(CODEX_END, b + CODEX_BEGIN.length);
  if (b >= 0 && e >= 0) {
    let lower = b, upper = e + CODEX_END.length;
    if (upper < text.length && text[upper] === "\n") upper++;
    // The blank line install-hooks put above the block.
    if (text.slice(0, lower).endsWith("\n\n")) lower--;
    text = text.slice(0, lower) + text.slice(upper);
  }
  const line = /^[ \t]*notify[ \t]*=[ \t]*\[[^\]]*\/\.agentbar\/hooks\/codex\/[^\]]*\]/m.exec(text);
  if (line) {
    let end = line.index + line[0].length;
    if (end < text.length && text[end] === "\n") end++;
    text = text.slice(0, line.index) + text.slice(end);
  }
  return text;
}

const CLAUDE_MARK = "/.agentbar/hooks/claude/";
// One agent's settings without AgentBar in them. Each prints what it wrote (or
// that there was nothing of ours) under the same column install-hooks uses.
function unwireAgent(id, claudeDirs) {
  const H = os.homedir();
  const said = (name, changed) => console.log(`${changed ? "unwired" : "off    "}  ${name}`);
  switch (id) {
    case "claude-mod":
      unwireClaudeMod(claudeDirs);
      break;
    case "claude":
      for (const d of claudeDirs) {
        const file = path.join(d, "settings.json");
        said(`claude  ${file}`, unwireHooksJSON(file, CLAUDE_MARK));
      }
      break;
    case "qwen": {
      const file = path.join(H, ".qwen", "settings.json");
      said(`qwen    ${file}`, unwireHooksJSON(file, CLAUDE_MARK));
      break;
    }
    case "gemini": {
      const file = path.join(H, ".gemini", "settings.json");
      said(`gemini  ${file}`, unwireHooksJSON(file, "/.agentbar/hooks/gemini/"));
      break;
    }
    // `version` stays: install-hooks adds it only when missing, and Cursor wants it.
    case "cursor": {
      const file = path.join(H, ".cursor", "hooks.json");
      said(`cursor  ${file}`, unwireHooksJSON(file, "/.agentbar/hooks/cursor/"));
      break;
    }
    // We own exactly one top-level key in each Antigravity hooks.json.
    case "antigravity":
      for (const d of ["antigravity", "antigravity-cli"].map((x) => path.join(H, ".gemini", x))) {
        const file = path.join(d, "hooks.json");
        if (!fs.existsSync(d) || !fs.existsSync(file)) continue;
        const root = readConfigFile(file);
        let changed = false;
        if (isPlainObject(root) && Object.prototype.hasOwnProperty.call(root, "agentbar")) {
          delete root.agentbar;
          changed = writeConfig(file, sortedStringify(root) + "\n");
        }
        said(`antigr  ${file}`, changed);
      }
      break;
