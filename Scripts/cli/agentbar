  const readConfig = readConfigFile;
  // Every agent's settings go through writeConfig: the diff first, then the backup,
  // then the atomic write — and none of it when the content is already there.
  const writeIfChanged = (file, root) => writeConfig(file, sortedStringify(root) + "\n");
  const report = (name, changed) => console.log(`${changed ? "wired" : "ok   "}  ${name}`);

