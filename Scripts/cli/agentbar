  const want = (id) => !only || only === id;
  const off = (id) => want(id) && disabled.has(id);
  const on = (id) => want(id) && !disabled.has(id);
  const claudeDirs = claudeConfigDirs((msg) => console.error(msg));
  // Switched-off agents are unwired on every run, so a hand-edited wire-disabled
  // (or the app's) takes effect here too. Unwiring something already unwired
  // writes nothing.
  for (const id of WIRABLE) if (off(id)) unwireAgent(id, claudeDirs);
  if (!WIRABLE.some(on)) {
    if (backupsKept) console.log(`Each settings file changed above was kept as it was, beside itself (*${BACKUP_MARK}<time>; the last ${BACKUP_KEEP} stay).`);
    return;
  }

  const srcHooks = path.join(__dirname, "..", "hooks");
  if (!fs.existsSync(srcHooks)) { console.error("hooks/ not found next to this CLI — run from a repo checkout"); process.exit(1); }
