    if (e && e.code === "ENOENT") return "";
    console.error(`skip: ${file} exists but could not be read (${(e && e.code) || e}) — left untouched`);
    return null;
  }
  try { return new TextDecoder("utf-8", { fatal: true }).decode(buf); } catch {
    console.error(`skip: ${file} is not UTF-8 — left untouched`);
