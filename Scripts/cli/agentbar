  const ids = wireIds(argv.filter((a) => !a.startsWith("--")), wired ? "wire" : "unwire");
  const off = loadWireDisabled(), on = loadWireEnabled();
  for (const id of ids) {
    // A default-off integration is switched by wire-enabled (WiringPrefs.set):
    // on lists it there and lifts any wire-disabled line, off simply unlists it.
    if (DEFAULT_OFF.has(id)) { if (wired) { on.add(id); off.delete(id); } else on.delete(id); }
    else if (wired) off.delete(id); else off.add(id);
  }
  saveWireDisabled(off);
  saveWireEnabled(on);
  if (wired) { for (const id of ids) installHooks({ only: id, args: [] }); return; }
  const claudeDirs = ids.some((id) => id === "claude" || id === "claude-mod")
    ? claudeConfigDirs((msg) => console.error(msg)) : [];
  for (const id of ids) unwireAgent(id, claudeDirs);
  const listed = ids.filter((id) => !DEFAULT_OFF.has(id)), unlisted = ids.filter((id) => DEFAULT_OFF.has(id));
  if (listed.length) console.log(`Left alone from now on: ${listed.join(", ")} (listed in ${wireDisabledFile}).`);
  if (unlisted.length) console.log(`Off again: ${unlisted.join(", ")} (no longer in ${wireEnabledFile}).`);
  console.log("Sessions already running keep the hooks they started with.");
  if (backupsKept) console.log(`Each settings file changed above was kept as it was, beside itself (*${BACKUP_MARK}<time>; the last ${BACKUP_KEEP} stay).`);
}

function installHooks({ only = null, args = [] } = {}) {
  // --skip a,b adds to ~/.agentbar/wire-disabled; --only a,b makes every other
  // agent install-hooks knows the disabled set (ids it does not know stay as they
  // were). The file is updated first and then the run obeys it, like every run.
  const flag = (name) => {
    const vals = [];
    for (let i = 0; i < args.length; i++) {
      if (args[i] === name) {
        if (i + 1 >= args.length) { console.error(`agentbar install-hooks: ${name} needs a list of agent ids`); process.exit(2); }
