    const reg = (readJSON(path.join(d, "plugins/installed_plugins.json")) || {}).plugins || {};
    const found = [];
    for (const [key, on] of Object.entries(isPlainObject(settings.enabledPlugins) ? settings.enabledPlugins : {})) {
      if (on !== true || !Array.isArray(reg[key])) continue;
      const pick = reg[key].find((e) => e && e.scope === "user") || reg[key][0];
