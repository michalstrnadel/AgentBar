// MARK: - Shared by wiring and unwiring

// Present-but-unparseable (JSONC comments, trailing comma, torn write) is skipped,
// never overwritten: rewriting from {} would silently destroy the person's config.
function readConfigFile(file) {
  if (!fs.existsSync(file)) return {};
  const parsed = readJSON(file);
  if (!parsed || typeof parsed !== "object") {
    console.error(`skip: ${file} exists but is not parseable JSON — left untouched`);
    return null;
  }
  return parsed;
}
const sortedStringify = (v) => JSON.stringify(v, (k, val) =>
  val && typeof val === "object" && !Array.isArray(val)
    ? Object.keys(val).sort().reduce((o, kk) => ((o[kk] = val[kk]), o), {})
    : val, 2);
