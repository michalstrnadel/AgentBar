#!/usr/bin/env node
// agentbar — cross-platform CLI over the AgentBar file protocol (~/.agentbar).
// The folder is the protocol, so this CLI is a full peer of the macOS app: on Linux
// it IS AgentBar. Contract: docs/protocol.md. No dependencies, Node >= 16.
//
//   agentbar status [--json]        live sessions
//   agentbar requests [--json]      pending approvals with inline detail
//   agentbar rules [--json]         the rules you wrote (listed here, applied by the app)
//   agentbar approve [n] [--always] answer the newest (or n-th) pending request
//   agentbar deny [n] [--note TEXT]  refuse, optionally telling the agent what to do instead
//   agentbar watch [-i SEC]         live view; keys: a allow · A always · d deny ·
//                                   f defer (terminal prompt) · 1-9 answer a
//                                   question · q quit. Holds the watcher heartbeat,
//                                   so hooks offer remote approval while it runs.
//   agentbar waybar                 one-line JSON for waybar/polybar custom modules
//                                   (each call refreshes the heartbeat; poll <= 30s)
//   agentbar history [--days N]     what finished today, with what it cost and what
//                                   moved in the repo — state.d forgets, this doesn't
//   agentbar doctor [--json]        diagnose a silent integration: hooks wired?
//                                   node path still there? dirs writable? when did
//                                   each agent last report?
//   agentbar report --agent ID --state S [--label L] [--name N] ...
//                                   write one session row for ANY agent, the
//                                   bridge for agents AgentBar has no hooks for.
//                                   Status only: it can never create an approval
//   agentbar install-hooks [--skip a,b] [--only a,b]
//                                   wire agent hooks (Claude/Codex/Cursor/Antigravity/
//                                   Gemini/Qwen/Copilot/OpenCode) —
//                                   the Linux equivalent of the macOS app's installer.
//                                   Agents listed in ~/.agentbar/wire-disabled are
//                                   unwired instead; --skip/--only update that list.
//                                   claude-mod (the Claude Code mod) starts off and
//                                   is wired only once listed in ~/.agentbar/wire-enabled
//   agentbar unwire <id> / wire <id> take one agent out / put it back

"use strict";
const fs = require("fs"), os = require("os"), path = require("path");

// The state root (docs/protocol.md, "Where state lives"): AGENTBAR_HOME when set,
// ~/.agentbar otherwise. Unlike the hooks, which ignore a relative value because
// they must never fail their host, the CLI refuses one: a typo in a test must not
// quietly read and write the real directory. No `~` expansion; trailing slashes go.
const defaultBase = path.join(os.homedir(), ".agentbar");
const base = (() => {
  const v = process.env.AGENTBAR_HOME || "";
  if (!v) return defaultBase;
  if (!path.isAbsolute(v)) {
    console.error(`agentbar: AGENTBAR_HOME must be an absolute path, not "${v}"`);
    process.exit(2);
  }
  return v.replace(/\/+$/, "") || "/";
})();
// A root of its own, not ~/.agentbar spelled another way.
const customBase = path.resolve(base) !== path.resolve(defaultBase);
// How the root is named in what this prints: unchanged when it is the default.
const shownBase = customBase ? base : "~/.agentbar";
const stateDir = path.join(base, "state.d");
const reqDir = path.join(base, "requests.d");
const ansDir = path.join(base, "answers.d");
const watcherFile = path.join(base, "watcher.json");
const historyFile = path.join(base, "history.jsonl");
const decisionsFile = path.join(base, "decisions.jsonl");
const rulesFile = path.join(base, "rules.json");
const seenFile = path.join(base, "history-seen.json");
const PRESENCE_TTL = 60; // seconds a heartbeat stays valid (hooks use the same value)
const HISTORY_MAX_AGE = 30 * 86400; // long enough for a sprint, short enough to stay a file
const HISTORY_MAX = 5000;

// The clock, in one place. `AGENTBAR_NOW` (epoch seconds) pins it, which exists
// for the test suite: a fixture written as "an hour ago" means today at 14:00 and
// *yesterday* at 00:30, so a day-boundary test passes all afternoon and fails in
// CI for the first hour of every day. Unset in normal use.
const nowMs = () => (process.env.AGENTBAR_NOW ? Number(process.env.AGENTBAR_NOW) * 1000 : Date.now());
const now = () => Math.floor(nowMs() / 1000);
const readJSON = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
const writeAtomic = (f, obj, replacer) => {
  const t = f + "." + process.pid + ".tmp";
  fs.writeFileSync(t, JSON.stringify(obj, replacer));
  fs.renameSync(t, f);
};
// Foundation's CharacterSet.whitespaces / .whitespacesAndNewlines, member for
// member (dumped from Foundation: Zs, tab and — Apple's own addition — U+200B),
// because String.prototype.trim() is neither: it eats U+FEFF and spares U+200B.
// Everything the two halves both read has to be trimmed the app's way.
const trimWhitespace = (s) => s.replace(/^[\t\p{Zs}\u200B]+|[\t\p{Zs}\u200B]+$/gu, "");
const trimWhitespaceAndNewlines = (s) =>
  s.replace(/^[\t\n\v\f\r\u0085\u2028\u2029\p{Zs}\u200B]+|[\t\n\v\f\r\u0085\u2028\u2029\p{Zs}\u200B]+$/gu, "");
// JSONSerialization drops ONE leading U+FEFF from every string it decodes, keys
// included (it reads it as a byte-order mark); JSON.parse keeps it. Whatever the
// app reads through it, this reads the same way.
const withoutFeff = (s) => s.replace(/^\uFEFF/, "");
// User-perceived characters, as Swift's `prefix(n)` counts them.
const graphemes = (s) => (typeof Intl !== "undefined" && Intl.Segmenter
  ? [...new Intl.Segmenter("en", { granularity: "grapheme" }).segment(s)].map((g) => g.segment)
  : Array.from(s));
// Session.displayName, clause for clause: control and format characters dropped
// (a newline would split a row, an ESC repaint a terminal), trimmed, 24 characters.
function displayName(raw) {
  if (typeof raw !== "string") return "";
  const kept = raw.replace(/[\p{Cc}\p{Cf}]/gu, "");
  return trimWhitespace(graphemes(trimWhitespaceAndNewlines(kept)).slice(0, 24).join(""));
}
const alive = (pid) => {
  if (!pid || pid <= 0) return false;
  try { process.kill(pid, 0); return true; } catch (e) { return e.code === "EPERM"; }
};

const tty = process.stdout.isTTY;
const c = (code, s) => (tty ? `\x1b[${code}m${s}\x1b[0m` : s);
const dim = (s) => c("2", s), bold = (s) => c("1", s);
const yellow = (s) => c("33", s), blue = (s) => c("34", s), green = (s) => c("32", s), red = (s) => c("31", s);

// MARK: - Stores (liveness rules mirror the app; docs/protocol.md is normative)

function sessions() {
  let files = []; try { files = fs.readdirSync(stateDir); } catch { return []; }
  const out = [];
  for (const f of files) {
    if (!f.endsWith(".json")) continue;
    const p = path.join(stateDir, f);
    const s = readJSON(p);
    // Session(fileURL:) reads only an object; an array or a bare value is skipped.
    if (!s || typeof s !== "object" || Array.isArray(s)) continue;
    // Session.pid / Session.plausibleTime: a pid that is not a 32-bit positive
    // integer is no liveness handle, and a time that is not a time is none. Read
    // raw, `"pid":"123"` or `"ts":"5"` made this command DELETE a row the app shows
    // (process.kill throws on them, and "5" > 0 is true in JavaScript).
    const pid = Number.isInteger(s.pid) && s.pid > 0 && s.pid <= 2147483647 ? s.pid : 0;
    const ts = plausibleTime(s.ts);
    const dead = pid > 0 && !alive(pid);
    const stale = ts > 0 && now() - ts > 86400;
    if (dead || stale) { try { fs.rmSync(p, { force: true }); } catch {} continue; }
    // Only an explicit `false` hides a row (docs/protocol.md). A third-party writer
    // that never heard of the field is showing a live session, and the app has
    // always shown it — this CLI hid it, so the two halves disagreed about one file.
    if (s.started === false) continue;
    s.id = f.slice(0, -".json".length);
    // Session.displayName: the name a writer chose, cleaned before anything prints
    // it — raw, an ESC in `agent_name` reached the terminal through `status`.
    const name = displayName(s.agent_name);
    if (name) s.agent_name = name; else delete s.agent_name;
    // Antigravity emits no terminal event (2.3.x fires only PostToolUse), so a
    // working session that has gone quiet decays to done instead of running for
    // ever — and the row says it was a watchdog's guess, not a reported finish.
    // Mirrors SessionStore.swift; without it the same session ends in the app and
    // never ends here.
    if (s.agent === "antigravity" && (s.state === "thinking" || s.state === "tool")
        && now() - ts > 90) {   // no ts reads as long quiet, as SessionStore reads it
      s.state = "done";
      s.decayed = true;
    }
    out.push(s);
  }
  out.sort((a, b) => ((PRIORITY[b.state] || 0) - (PRIORITY[a.state] || 0)) || ((b.ts || 0) - (a.ts || 0)));
  return out;
}

// MARK: - History (mirrors Sources/AgentBar/HistoryStore.swift)

// state.d is a *live* set: a row is deleted when its process dies or its ts passes
// 24h, so an agent that ran yesterday and exited cleanly leaves nothing at all.
// Without a record, nothing can answer "when did this agent last report anything",
// which is how `doctor` tells a broken integration apart from an idle one.
//
// Append-only, one line per ended session; a session may be written twice (turn
// end, then disappearance) and the reader keeps the last line for an id. The
// sidecar holds the previous tick so one-shot commands can diff too.
const FINISHED = { done: 1, error: 1 };   // deliberately not "idle" — see HistoryStore.swift

function recordHistory(ss) {
  try {
    const live = {};
    for (const s of ss) if (s.started !== false) live[s.id] = s;
    const sidecar = readJSON(seenFile);
    // The sidecar used to be a bare map of sessions; a file written by an older CLI
    // is read as exactly that, with no baselines yet.
    const prev = sidecar && sidecar.sessions ? sidecar.sessions : sidecar;
    const oldBases = (sidecar && sidecar.baselines) || {};

    // A git baseline the first time a session is seen, kept here so a one-shot
    // command can still measure a span it never watched. A session already running
    // when this CLI first ran gets none, and therefore no numbers — see repoChange.
    const baselines = {};
    for (const id of Object.keys(live)) {
      baselines[id] = Object.prototype.hasOwnProperty.call(oldBases, id)
        ? oldBases[id] : repoBaseline(live[id].cwd || "");
    }
    fs.mkdirSync(base, { recursive: true });
    const t = seenFile + "." + process.pid + ".tmp";
    fs.writeFileSync(t, JSON.stringify({ sessions: live, baselines }));
    fs.renameSync(t, seenFile);
    if (!prev) return; // first run is a baseline, not a hundred endings at once

    const rec = (s, id) => {
      const o = {
        v: 1, agent: s.agent || "", ...(s.agent_name ? { agentName: s.agent_name } : {}),
        sessionId: id, project: s.project || "",
        cwd: s.cwd || "", label: s.label || "", prompt: s.prompt || "",
        model: s.model || "", startedAt: Math.floor(s.started_at || 0),
        endedAt: Math.floor(s.ts || now()), state: s.state || "",
        decayed: s.decayed === true,
      };
      // Both optional, both omitted rather than zeroed: a reader has to be able to
      // tell "nobody measured this" from "this cost nothing".
      const w = sessionWeight(s.agent || "", id, s.cwd || "");
      if (w) o.weight = w;
      const ch = repoChange(s.cwd || "", baselines[id] || oldBases[id]);
      if (ch) o.change = ch;
      return o;
    };
    const out = [];
    for (const s of ss) {
      if (!FINISHED[s.state]) continue;
      if (prev[s.id] && FINISHED[prev[s.id].state]) continue; // edge only
      out.push(rec(s, s.id));
    }
    for (const id of Object.keys(prev)) if (!live[id]) out.push(rec(prev[id], id));
    if (!out.length) return;
    out.sort((a, b) => a.endedAt - b.endedAt || (a.sessionId < b.sessionId ? -1 : 1));
    fs.appendFileSync(historyFile, out.map((r) => JSON.stringify(r)).join("\n") + "\n");
    pruneHistory();
  } catch {}
}

// Reads every line that still parses, last-line-per-id wins. A line torn by a
// crash mid-append costs that line and nothing else.
function readHistory() {
  let text = ""; try { text = fs.readFileSync(historyFile, "utf8"); } catch { return []; }
  const byID = new Map();
  for (const line of text.split("\n")) {
    if (!line.trim()) continue;
    let r; try { r = JSON.parse(line); } catch { continue; }
    if (!r || !r.sessionId) continue;
    byID.delete(r.sessionId);   // re-insert so the newest keeps its arrival order
    byID.set(r.sessionId, r);
  }
  return [...byID.values()];
}

// A LENGTH of time, not an age — `elapsed()` above takes a timestamp and subtracts
// it from now, which is a different thing and silently renders 56 years when handed
// a duration. Same vocabulary as HistoryDigest.duration on the app side, so the two
// frontends do not describe time two different ways.
function durationText(seconds) {
  const d = Math.max(0, Math.floor(seconds));
  if (d < 60) return "<1m";
  if (d < 3600) return `${Math.floor(d / 60)}m`;
  const h = Math.floor(d / 3600), m = Math.floor((d % 3600) / 60);
  return m === 0 ? `${h}h` : `${h}h ${m}m`;
}

// What finished, read back out of history.jsonl. `status` answers "what is
// happening"; this is the only thing that answers "what happened", because state.d
// deletes a session the moment its process dies.
function printHistory(argv, json) {
  const d = argv.indexOf("--days");
  const days = Math.max(1, parseInt(d >= 0 ? argv[d + 1] : "1", 10) || 1);
  // Local midnight, not "the last N*24 hours": a day that starts whenever you
  // happen to look at it is not a day.
  const midnight = new Date(nowMs()); midnight.setHours(0, 0, 0, 0);
  const since = Math.floor(midnight.getTime() / 1000) - (days - 1) * 86400;

  const rows = readHistory()
    .filter((r) => (r.endedAt || 0) >= since)
    .sort((a, b) => (b.endedAt || 0) - (a.endedAt || 0));
  if (json) return console.log(JSON.stringify(rows, null, 2));
  if (!rows.length) return console.log(dim(days === 1 ? "Nothing finished yet today" : `Nothing in the last ${days} days`));

  let measured = 0, seconds = 0, tokensMeasured = 0, tokens = 0;
  for (const r of rows) {
    if (r.startedAt > 0 && r.endedAt >= r.startedAt) { seconds += r.endedAt - r.startedAt; measured++; }
    if (r.weight) { tokens += weightTotal(r.weight); tokensMeasured++; }
  }
  const failed = rows.filter((r) => r.state === "error").length;
  for (const r of rows) {
    const when = new Date((r.endedAt || 0) * 1000)
      .toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    const dur = r.startedAt > 0 && r.endedAt >= r.startedAt ? durationText(r.endedAt - r.startedAt) : "";
    const name = r.project || r.agentName || r.agent || "session";
    const mark = r.state === "error" ? red("✗") : green("✓");
    // Every trailing column is blank when it was not measured, never zero-filled.
    const tok = r.weight ? compact(weightTotal(r.weight)) : "";
    const ch = r.change ? changeText(r.change) : "";
    console.log(`${mark} ${dim(when)}  ${bold(name.padEnd(22))} ${dim((dur || "").padStart(6))}`
      + ` ${dim(tok.padStart(7))}  ${dim(ch.padEnd(17))} ${dim(r.agentName || r.agent)}`);
  }
  // A partial total presented as the day's work is a number someone would quote.
  // Doubly so for tokens: only three of the ten agents publish one at all, so the
  // partial form is the normal case here rather than the exception.
  const total = measured === rows.length
    ? durationText(seconds)
    : measured ? `${durationText(seconds)} across ${measured}` : "";
  const tokenTotal = tokensMeasured === rows.length && tokens
    ? `${compact(tokens)} tokens`
    : tokensMeasured ? `${compact(tokens)} tokens across ${tokensMeasured}` : "";
  const parts = [`${rows.length} session${rows.length === 1 ? "" : "s"}`];
  if (total) parts.push(total);
  if (tokenTotal) parts.push(tokenTotal);
  if (failed) parts.push(`${failed} failed`);
  console.log("\n" + parts.join(" · "));
}

function pruneHistory() {
  try {
    const all = readHistory();
    let kept = all.filter((r) => now() - (r.endedAt || 0) <= HISTORY_MAX_AGE);
    if (kept.length > HISTORY_MAX) kept = kept.slice(-HISTORY_MAX);
    if (kept.length === all.length) return;
    const t = historyFile + "." + process.pid + ".tmp";
    fs.writeFileSync(t, kept.length ? kept.map((r) => JSON.stringify(r)).join("\n") + "\n" : "");
    fs.renameSync(t, historyFile);
  } catch {}
}

function requests() {
  let files = []; try { files = fs.readdirSync(reqDir); } catch { return []; }
  const out = [];
  for (const f of files) {
    if (!f.endsWith(".json")) continue;
    const p = path.join(reqDir, f);
    const r = readJSON(p);
    if (!r) continue;
    const watched = r.hookPid > 0 ? r.hookPid : r.pid;
    const dead = watched > 0 && !alive(watched);
    const expired = r.ts > 0 && now() - r.ts > 660;
    if (dead || expired) { try { fs.rmSync(p, { force: true }); } catch {} continue; }
    r.fileName = f;
    out.push(r);
  }
  out.sort((a, b) => (b.ts || 0) - (a.ts || 0));
  return out;
}

// --- what you decided about permission prompts ---
// AgentBar sits in the permission path, so it is the only thing that can know
// this; today every decision is thrown away the moment it is made. Kept, it lets
// the next prompt say what you did last time, and lets the day say how long agents
// sat blocked on you. It never decides anything by itself.
//
// Only decisions that actually reached answers.d are written. Keystroke approvals
// (Codex, Antigravity) press a key at a terminal and never learn what the terminal
// did with it — recording that as "you allowed" would be a claim nobody here can
// make.

const MULTIPLEXERS = new Set(["git", "gh", "npm", "pnpm", "yarn", "bun", "cargo", "go",
  "docker", "kubectl", "brew", "make", "swift", "dotnet", "pip", "pip3", "uv", "poetry",
  "rails", "terraform", "aws", "gcloud", "systemctl", "apt", "apt-get", "flutter"]);

// NSString.lastPathComponent, which the app takes the command's name with:
// trailing slashes ignored, `/` itself is `/`. path.basename("/") is "".
function lastPathComponent(w) {
  const trimmed = w.replace(/\/+$/, "");
  if (!trimmed) return w ? "/" : "";
  return trimmed.slice(trimmed.lastIndexOf("/") + 1);
}

// The first two words that matter, and never an argument: `git push` repeats,
// `git push origin feature/PR-4113` never does — and arguments are where a path,
// a URL or an accidentally typed secret would be.
//
// DecisionLedger.verb, clause for clause, because a rule matches on this string:
// the head is the first NON-EMPTY piece (`;git push` is git push, not nothing),
// `\r` cuts it like `\n` does, and words split on space and tab only — `\s` also
// split on a no-break space, which the shell (and the app) read as a letter.
function decisionVerb(command) {
  const line = typeof command === "string" ? command : "";
  const pieces = line.split(/[|;&\r\n]/).filter((p) => p !== "");
  const head = pieces.length ? pieces[0] : line;
  let words = head.split(/[ \t]+/).filter(Boolean);
  while (words.length && (words[0] === "sudo" || words[0] === "command" || words[0] === "env"
        || (words[0].includes("=") && !words[0].startsWith("-")))) words.shift();
  if (!words.length) return "";
  const name = lastPathComponent(words[0]);
  if (!MULTIPLEXERS.has(name)) return name;
  const next = words.slice(1).find((w) => !w.startsWith("-"));
  return next ? `${name} ${next}` : name;
}

// A string field or nothing — ApprovalRequest reads every field `as? String`.
const textField = (v) => (typeof v === "string" ? withoutFeff(v) : "");

const SHAPE_PATH_KEYS = ["file_path", "notebook_path", "path", "filePath"];

function decisionShape(r) {
  const ctx = r.context && typeof r.context === "object" ? r.context : {};
  // The hook's own field first: toolInputPretty is cut at 4 KB, and a cut is
  // not JSON, so a large edit would otherwise lose its shape.
  let p = textField(r.filePath);
  if (!p && ctx.kind !== "bash") {
    let input = null;
    try { input = JSON.parse(textField(r.toolInputPretty)); } catch {}
    if (input && typeof input === "object" && !Array.isArray(input)) {
      p = SHAPE_PATH_KEYS.map((k) => textField(input[k])).find(Boolean) || "";
    }
  }
  return shapeOf(textField(r.toolName), ctx.kind === "bash" ? textField(ctx.command) : null, p);
}

// The same key for a call Claude Code decided itself (mods.d): `command` for Bash,
// `file_path` for the file tools. DecisionLedger.shape(tool:input:), held to it by
// Tests/Fixtures/tool-shape.
function decisionShapeOfCall(tool, input) {
  const t = textField(tool);
  const i = input && typeof input === "object" && !Array.isArray(input) ? input : {};
  const p = SHAPE_PATH_KEYS.map((k) => textField(i[k])).find(Boolean) || "";
  return shapeOf(t, t === "Bash" ? textField(i.command) : null, p);
}

// The one place a shape is made, as in the app. `command` is non-null for a shell
// command — even an empty one, which is `bash:` and never a tool.
function shapeOf(tool, command, p) {
  if (command !== null) return "bash:" + decisionVerb(command);
  if (p) {
    const parts = p.split("/").filter(Boolean);
    const dir = parts.length > 1 ? parts[parts.length - 2] : "";
    const ext = path.extname(p).replace(/^\./, "");
    const suffix = ext ? `*.${ext}` : "*";
    return `${tool.toLowerCase()}:${dir ? dir + "/" + suffix : suffix}`;
  }
  return "tool:" + tool;
}

function recordDecision(r, decision) {
  const session = sessions().find((x) => x.sessionId === r.sessionId || x.id === r.sessionId);
  const rec = {
    v: 1, ts: now(), agent: r.agent || "", sessionId: r.sessionId || "",
    project: (session && session.project) || "",
    // The hook has carried the directory on the request since 1.28.0, so that no
    // reader has to join back through state.d for it — and a request answered
    // after its session row is gone has nothing to join to. The app prefers the
    // request and falls back to the session; this half only read the session, and
    // the directory is what scopes "allowed 23x here" and what a rule matches on.
    cwd: r.cwd || (session && session.cwd) || "",
    tool: r.toolName || "", shape: decisionShape(r), display: r.display || "",
    decision,
    // A request with no ts, or one stamped in the future, contributes no wait
    // rather than a negative one that would quietly shrink the day's total.
    waited: r.ts > 0 ? Math.max(0, now() - r.ts) : 0,
    via: "cli",
  };
  try { fs.appendFileSync(decisionsFile, JSON.stringify(rec) + "\n"); } catch {}
}

// Whether a row is the person's own answer. `rule` (an AgentBar rule answered) and
// `claude` (Claude Code decided before any prompt existed) are counted on their own:
// nobody was asked, so they must never read as the person agreeing or as a wait.
// Rows from before `via` existed, with it empty, are the person's.
function isPersonal(r) { return r.via !== "rule" && r.via !== "claude"; }

function readDecisions() {
  let text = ""; try { text = fs.readFileSync(decisionsFile, "utf8"); } catch { return []; }
  const out = [];
  for (const line of text.split("\n")) {
    if (!line.trim()) continue;
    let o; try { o = JSON.parse(line); } catch { continue; }   // a torn line costs one line
    if (o && o.shape && o.decision) out.push(o);
  }
  return out;
}

function answer(r, behavior, note) {
  fs.mkdirSync(ansDir, { recursive: true });
  const obj = { behavior };
  // What to do instead, on a deny only: the hook hands it to the agent as the
  // denial's reason. Same flattening the hook applies, so what is echoed here is
  // what the agent reads.
  const cleaned = behavior === "deny" ? cleanNote(note) : "";
  if (cleaned) obj.message = cleaned;
  // "always" only sticks when the hook can match it to a rule Claude itself
  // suggested; without a suggestion it degrades to a plain one-shot allow there.
  if (behavior === "always" && r.ruleSuggestion) obj.rule = r.ruleSuggestion;
  // Name the hook this answer is meant for: request names repeat across the
  // tools of one turn, and the hook discards answers aimed at a predecessor.
  if (r.hookPid > 0) obj.hookPid = r.hookPid;
  writeAtomic(path.join(ansDir, r.fileName), obj);
  recordDecision(r, behavior);
}

// Chosen option labels for a question request, one array per question. The hook
// only accepts labels the request itself offered.
function answerQuestion(r, labels) {
  fs.mkdirSync(ansDir, { recursive: true });
  const obj = { behavior: "answer", answers: labels };
  if (r.hookPid > 0) obj.hookPid = r.hookPid;
  writeAtomic(path.join(ansDir, r.fileName), obj);
  recordDecision(r, "answer");
}

// Same .git/HEAD trick as the app: no git invocation, handles worktrees.
function gitBranch(cwd) {
  if (!cwd) return null;
  try {
    let g = path.join(cwd, ".git");
    const st = fs.statSync(g);
    if (!st.isDirectory()) {
      const m = fs.readFileSync(g, "utf8").match(/^gitdir:\s*(.+)$/m);
      if (!m) return null;
      g = m[1].trim();
    }
    const head = fs.readFileSync(path.join(g, "HEAD"), "utf8").trim();
    return head.startsWith("ref: refs/heads/") ? head.slice("ref: refs/heads/".length) : head.slice(0, 7);
  } catch { return null; }
}

// MARK: - Weight and repo change (both optional per docs/protocol.md)

// What a session cost, from the agent's own local files. Claude and Codex keep plain
// JSONL and are read here; Copilot keeps a SQLite database, which needs a dependency
// this CLI does not have, so a Copilot row simply carries no weight on Linux.
// Absent always means "not measured" — never zero.

// Claude Code's project folders: every character that is not a letter, digit or
// underscore becomes a dash.
const slugify = (p) => p.replace(/[^A-Za-z0-9_]/g, "-");

// Any ~/.claude* holding a projects/ dir. Globbed, not listed: the split-config
// layouts are named by whoever set them up.
function claudeRoots() {
  let names = []; try { names = fs.readdirSync(os.homedir()); } catch { return []; }
  const out = [];
  for (const n of names) {
    if (n !== ".claude" && !n.startsWith(".claude-")) continue;
    const p = path.join(os.homedir(), n, "projects");
    try { if (fs.statSync(p).isDirectory()) out.push(fs.realpathSync(p)); } catch {}
  }
  return [...new Set(out)];
}

// The session id IS the transcript's file name. The slug is a fast path; the walk is
// the answer when a session's cwd no longer maps to its folder.
function claudeTranscript(sessionId, cwd) {
  const file = sessionId + ".jsonl";
  const roots = claudeRoots();
  if (cwd) {
    for (const r of roots) {
      const guess = path.join(r, slugify(cwd), file);
      if (fs.existsSync(guess)) return guess;
    }
  }
  for (const r of roots) {
    let dirs = []; try { dirs = fs.readdirSync(r); } catch { continue; }
    for (const d of dirs) {
      const guess = path.join(r, d, file);
      if (fs.existsSync(guess)) return guess;
    }
  }
  return null;
}

// One assistant message spans several transcript lines, each repeating the same usage
// object — dedupe by message.id or the answer roughly doubles.
function claudeWeight(sessionId, cwd) {
  const file = claudeTranscript(sessionId, cwd);
  if (!file) return null;
  let text = ""; try { text = fs.readFileSync(file, "utf8"); } catch { return null; }
  const w = { in: 0, out: 0, cacheWrite: 0, cacheRead: 0, src: "claude-transcript" };
  const seen = new Set();
  for (const line of text.split("\n")) {
    if (!line.includes('"usage"') || !line.includes('"assistant"')) continue;
    let o; try { o = JSON.parse(line); } catch { continue; }
    const u = o && o.type === "assistant" && o.message && o.message.usage;
    if (!u) continue;
    if (o.message.id) { if (seen.has(o.message.id)) continue; seen.add(o.message.id); }
    w.in += u.input_tokens || 0;
    w.out += u.output_tokens || 0;
    w.cacheWrite += u.cache_creation_input_tokens || 0;
    w.cacheRead += u.cache_read_input_tokens || 0;
  }
  return w.in || w.out || w.cacheWrite || w.cacheRead ? w : null;
}

// Codex stamps a cumulative total_token_usage into its rollout file on every turn, so
// the last one is the session total. The id link is the fragile part: the adapter
// writes codex-<thread-id> and its fallbacks name no rollout at all, so a miss has to
// produce nothing rather than a guess.
function codexRollout(id) {
  const base = process.env.CODEX_HOME || path.join(os.homedir(), ".codex");
  const walk = (dir, depth) => {
    let names = []; try { names = fs.readdirSync(dir); } catch { return null; }
    for (const n of names.sort().reverse()) {
      const p = path.join(dir, n);
      if (depth > 0) { const hit = walk(p, depth - 1); if (hit) return hit; continue; }
      if (n.endsWith(`-${id}.jsonl`)) return p;
    }
    return null;
  };
  return walk(path.join(base, "sessions"), 3);
}

function codexWeight(sessionId) {
  const id = sessionId.startsWith("codex-") ? sessionId.slice(6) : sessionId;
  const file = id && codexRollout(id);
  if (!file) return null;
  let text = ""; try { text = fs.readFileSync(file, "utf8"); } catch { return null; }
  let out = null;
  for (const line of text.split("\n")) {
    if (!line.includes("token_count")) continue;
    let o; try { o = JSON.parse(line); } catch { continue; }
    const t = o && o.payload && o.payload.type === "token_count"
      && o.payload.info && o.payload.info.total_token_usage;
    if (!t) continue;
    const cached = t.cached_input_tokens || 0;
    // Codex folds cached input INTO input_tokens, unlike the other two. Split it back
    // out or the same conversation looks bigger under Codex for no reason but phrasing.
    out = { in: Math.max(0, (t.input_tokens || 0) - cached), out: t.output_tokens || 0,
            cacheWrite: t.cache_write_input_tokens || 0, cacheRead: cached,
            src: "codex-rollout" };
  }
  // Cache reads count towards "there is a reading here", the same way they do in
  // claudeWeight above and in both of the app's readers. They are never *shown* —
  // weightTotal leaves them out — but a session whose whole cost was cached input
  // has been read, and saying so is not the same as saying it cost nothing.
  return out && (out.in || out.out || out.cacheWrite || out.cacheRead) ? out : null;
}

function sessionWeight(agent, sessionId, cwd) {
  try {
    if (agent === "claude") return claudeWeight(sessionId, cwd);
    if (agent === "codex") return codexWeight(sessionId);
  } catch {}
  return null;  // copilot needs SQLite; everyone else publishes nothing
}

// Cache reads are stored but never shown: two orders of magnitude bigger than the
// rest, and a measure of how long a conversation is rather than what it did.
const weightTotal = (w) => (w ? (w.in || 0) + (w.out || 0) + (w.cacheWrite || 0) : 0);
const compact = (n) => (n >= 1e6 ? (n / 1e6).toFixed(1) + "M" : n >= 1e3 ? Math.round(n / 1e3) + "k" : String(n));

// --- the approvals you keep answering ---

function durationShort(seconds) {
  const m = Math.round(seconds / 60);
  if (m < 60) return `${m}m`;
  const h = Math.floor(m / 60);
  return m % 60 ? `${h}h ${m % 60}m` : `${h}h`;
}

// The ledger as a spreadsheet, for handing to somebody who was not there.
// A field beginning =, +, - or @ is prefixed with an apostrophe: the export carries
// commands an agent wanted to run, and handing those to a spreadsheet as formulas
// to evaluate is not something this is going to do.
function csvField(v) {
  let f = String(v === undefined || v === null ? "" : v);
  if (/^[=+\-@\t\r]/.test(f)) f = "'" + f;
  return '"' + f.replace(/"/g, '""') + '"';
}

function printApprovalsCsv(argv) {
  const i = argv.indexOf("--days");
  const asked = i >= 0 ? parseInt(argv[i + 1], 10) : 1;
  const days = Number.isFinite(asked) && asked > 0 ? asked : 1;
  const midnight = new Date(nowMs()); midnight.setHours(0, 0, 0, 0);
  const since = midnight.getTime() / 1000 - (days - 1) * 86400;
  const rows = readDecisions().filter((r) => r.ts >= since).sort((a, b) => a.ts - b.ts);
  const out = [["when", "agent", "directory", "tool", "shape", "what", "decision",
                "would have", "answered by", "rule", "by", "claude rule", "waited (s)"].join(",")];
  for (const r of rows) {
    out.push([new Date((r.ts || 0) * 1000).toISOString().replace(/\.\d{3}Z$/, "Z"),
              r.agent, r.cwd, r.tool, r.shape, r.display, r.decision, r.would,
              r.via, r.rule, r.by, r.claudeRule, Math.round(r.waited || 0)].map(csvField).join(","));
  }
  process.stdout.write(out.join("\n") + "\n");
}

function printApprovals(argv, json) {
  if (argv.includes("--export")) return printApprovalsCsv(argv);
  const i = argv.indexOf("--days");
  const asked = i >= 0 ? parseInt(argv[i + 1], 10) : 1;
  const days = Number.isFinite(asked) && asked > 0 ? asked : 1;
  const midnight = new Date(nowMs()); midnight.setHours(0, 0, 0, 0);
  const since = midnight.getTime() / 1000 - (days - 1) * 86400;
  const all = readDecisions().filter((r) => r.ts >= since);
  // Three kinds of row, three different answers to "what happened". A person
  // answered; a rule answered, in milliseconds and without asking, so mixing it
  // into "18 answered" would inflate what the person did and deflate the wait
  // with time nobody waited; or a WATCHING rule answered nothing at all and only
  // wrote down what it would have done — which is not something that happened and
  // belongs in neither count.
  const rows = all.filter((r) => isPersonal(r) && r.decision !== "watch");
  const byRules = all.filter((r) => r.via === "rule" && r.decision !== "watch").length;
  // Claude Code's own decisions, made before any prompt existed (`mods.d`).
  const byClaude = all.filter((r) => r.via === "claude").length;

  // Counted per repo: the same command is routine in one checkout and the
  // opposite in another.
  const byShape = new Map();
  let waited = 0;
  for (const r of rows) {
    waited += r.waited || 0;
    const key = JSON.stringify([r.shape, r.cwd || ""]);
    const e = byShape.get(key) || { shape: r.shape, cwd: r.cwd || "", project: r.project || "",
                                    allowed: 0, denied: 0, other: 0, last: 0 };
    if (r.decision === "allow" || r.decision === "always") e.allowed++;
    else if (r.decision === "deny") e.denied++;
    else e.other++;
    e.last = Math.max(e.last, r.ts);
    byShape.set(key, e);
  }
  const list = [...byShape.values()].sort((a, b) => (b.allowed + b.denied) - (a.allowed + a.denied));

  if (json) {
    console.log(JSON.stringify({ answered: rows.length, byRules, byClaude, waited, repeats: list }, null, 2));
    return;
  }
  if (!rows.length && !byRules && !byClaude) {
    console.log(dim("Nothing answered yet" + (days > 1 ? ` in ${days} days.` : " today.")));
    return;
  }
  for (const e of list.slice(0, 15)) {
    const verdicts = [e.allowed ? green(`${e.allowed} allowed`) : "",
                      e.denied ? red(`${e.denied} denied`) : ""].filter(Boolean).join(", ");
    console.log(`${bold(e.shape.padEnd(26))} ${verdicts.padEnd(26)} ${dim(e.project || "")}`);
  }
  if (list.length > 15) console.log(dim(`...and ${list.length - 15} more`));
  // The half of the loop nothing else is standing in the right place to measure.
  const account = [`${rows.length} answered`];
  if (byRules) account.push(`${byRules} by your rules`);
  if (byClaude) account.push(`${byClaude} decided by Claude Code without asking`);
  account.push(`they waited ${durationShort(waited)} on you`);
  console.log("\n" + account.join(` ${dim("·")} `));
}

// --- the rules you wrote ---

// Lists ~/.agentbar/rules.json and what each rule has actually done, from the same
// ledger the app reads.
//
// It LISTS them; it does not apply them. Only the macOS app answers from a rule,
// because the check that makes an approving rule safe — the live command, not its
// shape — is one table in one language, and a second copy of it in JS would be a
// second thing to keep byte-identical in the one place where drifting apart means
// approving something nobody meant to approve. The `shape` normalisation already
// lives in two places and that is one too many. Said out loud here and in
// docs/protocol.md rather than discovered.
// RulesStore.normalisedCwd, character for character: purely textual (no realpath —
// the engine sees the directory the agent reports, not the one the disk resolves
// it to), empty and `.` parts dropped, `..` popping one part but never above root.
function plainCwd(p) {
  const out = [];
  for (const part of p.split("/")) {
    if (part === "" || part === ".") continue;
    if (part === "..") { out.pop(); continue; }
    out.push(part);
  }
  return "/" + out.join("/");
}

// RulesStore.repeatedKey, clause for clause: the first key any object in this
// (already parsed) JSON repeats, or null. JSON.parse keeps the LAST of two equal
// keys and JSONSerialization the FIRST, so a rule that says "deny" and then
// "allow" was applied as one and listed as the other. Both now refuse the file.
function repeatedKey(raw) {
  const stack = [];
  for (let i = 0; i < raw.length; i++) {
    const ch = raw[i];
    if (ch === '"') {
      let j = i + 1;
      while (j < raw.length && raw[j] !== '"') j += raw[j] === "\\" ? 2 : 1;
      const top = stack[stack.length - 1];
      if (top && top.isObject && top.wantKey && j < raw.length) {
        let key = "";
        try { key = withoutFeff(JSON.parse(raw.slice(i, j + 1))); } catch {}
        if (top.keys.has(key)) return key;
        top.keys.add(key);
        top.wantKey = false;
      }
      i = j;
    } else if (ch === "{") stack.push({ keys: new Set(), isObject: true, wantKey: true });
    else if (ch === "[") stack.push({ keys: new Set(), isObject: false, wantKey: false });
    else if (ch === "}" || ch === "]") stack.pop();
    else if (ch === ",") { const top = stack[stack.length - 1]; if (top && top.isObject) top.wantKey = true; }
  }
  return null;
}

// RulesStore.load + RulesStore.validate, check for check and in the same order, so
// the two halves name the same reason for the same file. The app refuses the WHOLE
// file on any of them: a check missing here is a file this command lists as in
// force while the app applies none of it — told to the one person asking why a
// rule stopped firing. Tests/Fixtures/rules-file is the contract both read.
function readRules(file = rulesFile) {
  let raw;
  try { raw = fs.readFileSync(file, "utf8"); } catch { return { state: "none", rules: [] }; }
  // JSONSerialization reads past a UTF-8 byte-order mark; JSON.parse does not, and
  // this command said "no rules are in force" about a file the app was applying.
  if (raw.charCodeAt(0) === 0xfeff) raw = raw.slice(1);
  const bad = (why) => ({ state: "invalid", why, rules: [] });
  // What JSONSerialization refuses and JSON.parse takes: a number too large to be
  // one (1e400 is Infinity here) and half a surrogate pair. U+FEFF it drops.
  const lone = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/;
  const strict = (k, v) => {
    if ((typeof v === "number" && !Number.isFinite(v)) || lone.test(k) || (typeof v === "string" && lone.test(v)))
      throw new Error("not JSON");
    return v;
  };
  const clean = (v) => (typeof v === "string" ? withoutFeff(v)
    : Array.isArray(v) ? v.map(clean)
    : isPlainObject(v) ? Object.fromEntries(Object.entries(v).map(([k, x]) => [withoutFeff(k), clean(x)]))
    : v);
  let o;
  try { o = clean(JSON.parse(raw, strict)); } catch { return bad("not valid JSON"); }
  if (!isPlainObject(o)) return bad("not valid JSON");
  if (o.v !== 1) return bad(`version ${JSON.stringify(o.v)}, not 1`);
  const twice = repeatedKey(raw);
  if (twice !== null) return bad(`repeats the key \`${twice}\` inside one object`);
  if (!Array.isArray(o.rules) || !o.rules.every(isPlainObject)) return bad("no `rules` list");
  const ids = new Set();
  for (const r of o.rules) {
    if (typeof r.id !== "string" || typeof r.decision !== "string" || typeof r.shape !== "string")
      return bad("a rule is missing `id`, `decision` or `shape`");
    const field = ["agent", "cwd", "note", "tell"].find((k) => r[k] !== undefined && typeof r[k] !== "string");
    if (field) return bad(`rule ${r.id}: has a \`${field}\` that is not text`);
    if (!r.id) return bad("a rule with an empty id");
    if (ids.has(r.id)) return bad(`rule ${r.id}: repeats an id used above`);
    ids.add(r.id);
    if (r.decision !== "allow" && r.decision !== "deny")
      return bad(`rule ${r.id}: decision is not allow or deny`);
    if (!r.shape) return bad(`rule ${r.id}: has an empty shape`);
    const cwd = r.cwd || "";
    if (r.decision === "allow" && !cwd) return bad(`rule ${r.id}: approves without naming a directory`);
    if (cwd && !cwd.startsWith("/")) return bad(`rule ${r.id}: cwd is not an absolute path`);
    // Refused rather than tidied, exactly as RulesStore.validate does: the engine
    // compares directories as text, so `/x/repo/` would never match a session in
    // `/x/repo`, and `/x/repo/../other` names somewhere the person did not write
    // down. Rewriting either would make the file say one thing and the app another.
    if (cwd && plainCwd(cwd) !== cwd)
      return bad(`rule ${r.id}: has a \`cwd\` that is not written plainly — no trailing \`/\`, \`//\`, \`.\` or \`..\`. Write it as ${plainCwd(cwd)}`);
    if (r.decision === "allow" && trimWhitespaceAndNewlines(r.tell || ""))
      return bad(`rule ${r.id}: approves and carries tell; only a denial says anything`);
    // An unreadable mode is never read as "on": a typo must not start a rule
    // answering. Same refusal the app makes.
    if (r.mode !== undefined && !["on", "watch", "off"].includes(r.mode))
      return bad(`rule ${r.id}: mode is not on, watch or off`);
  }
  return { state: "rules", rules: o.rules };
}

// DecisionLedger.agreement, clause for clause: whether YOU, answering the same
// prompt, did what a watching rule would have done. Each watch row of the rule
// (no older than `since`, the rule's last save) is paired with the first unclaimed
// row a person wrote — via not "rule", a verdict (allow / always / deny; defer and
// answer are not verdicts), the same non-empty session, tool and shape, no earlier
// than the watch row and within AGREEMENT_WINDOW of it. `always` is an allow. No
// such row — answered at the terminal, by keystroke, or timed out — is unwitnessed,
// never agreement. 15 minutes: permission.js waits 600 s by default and then hands
// the prompt back to the terminal, so a later row is a different prompt.
const AGREEMENT_WINDOW = 15 * 60;
// DecisionLedger.letItAnswerAfterAgreements / letItAnswerAcrossDays.
const LET_IT_ANSWER_AFTER = 10;
const LET_IT_ANSWER_DAYS = 3;

// Session.plausibleTime: a time that is not a time (a string, NaN, 1e19, past the
// year 3000) reads as none, so the app and this command count the same rows.
const plausibleTime = (v) => (typeof v === "number" && Number.isFinite(v) && v > 0 && v < 32503680000 ? v : 0);

function agreement(id, decisions, since) {
  const byTime = (a, b) => a.r.ts - b.r.ts || a.i - b.i;
  const indexed = decisions.map((r, i) => ({ r: { ...r, ts: plausibleTime(r.ts) }, i }));
  const watches = indexed.filter(({ r }) => r.rule === id && r.decision === "watch"
                                            && r.ts >= since).sort(byTime);
  const answers = indexed.filter(({ r }) => isPersonal(r) && r.sessionId
                                            && ["allow", "always", "deny"].includes(r.decision)).sort(byTime);
  const claimed = new Set();
  const days = new Set();
  const out = { agreed: 0, disagreed: 0, unwitnessed: 0, days: 0, first: 0, last: 0, lastDisagreement: null };
  for (const { r: w } of watches) {
    const ts = w.ts;
    out.first = out.first === 0 ? ts : Math.min(out.first, ts);
    out.last = Math.max(out.last, ts);
    const m = w.sessionId ? answers.find(({ r: a, i }) => !claimed.has(i)
      && a.sessionId === w.sessionId && (a.shape || "") === (w.shape || "") && (a.tool || "") === (w.tool || "")
      && a.ts >= ts && a.ts - ts <= AGREEMENT_WINDOW) : undefined;
    if (!m) { out.unwitnessed++; continue; }
    claimed.add(m.i);
    const did = m.r.decision === "deny" ? "deny" : "allow";
    if (did === w.would) {
      out.agreed++;
      const d = new Date(ts * 1000);
      days.add(`${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`);
    } else {
      out.disagreed++;
      if (m.r.ts >= ((out.lastDisagreement && out.lastDisagreement.ts) || 0)) out.lastDisagreement = m.r;
    }
  }
  out.days = days.size;
  out.eligible = out.disagreed === 0 && out.agreed >= LET_IT_ANSWER_AFTER && out.days >= LET_IT_ANSWER_DAYS;
  return out;
}

// DecisionLedger.agreementClause, word for word (with x for ×, as the rest of
// this command writes counts).
function agreementClause(a) {
  const parts = [];
  if (a.agreed) parts.push(`you did the same ${a.agreed}x`);
  if (a.disagreed) parts.push(a.agreed ? `the other way ${a.disagreed}x` : `you went the other way ${a.disagreed}x`);
  const witnessed = a.agreed + a.disagreed;
  if (a.unwitnessed > witnessed) parts.push(witnessed ? `${a.unwitnessed}x not answered here` : "none answered here yet");
  return parts.join(", ");
}

function printRules(json) {
  const loaded = readRules();
  const decisions = readDecisions();
  // What it did, and — for a watching rule — what it would have done. Two
  // different questions, and a row that says `watch` is not something that
  // happened, so it is never counted as one. A watching rule counts from its last
  // save (`created`), as the app does: rows from before an edit were about a rule
  // that no longer exists.
  const fired = (id) => decisions.filter((d) => d.rule === id && d.via === "rule"
                                                && d.decision !== "watch");
  const savedAt = (r) => plausibleTime(r.created);
  const wouldHave = (r) => decisions.filter((d) => d.rule === r.id && d.decision === "watch"
                                                   && plausibleTime(d.ts) >= savedAt(r));

  if (json) {
    console.log(JSON.stringify({
      state: loaded.state,
      why: loaded.why || "",
      applied: false,
      rules: loaded.rules.map((r) => {
        const rows = fired(r.id);
        const watched = wouldHave(r);
        const out = { ...r, mode: r.mode || "on",
                      allowed: rows.filter((d) => d.decision === "allow").length,
                      denied: rows.filter((d) => d.decision === "deny").length,
                      wouldHave: watched.length,
                      last: rows.concat(watched).reduce((m, d) => Math.max(m, d.ts || 0), 0) };
        if (out.mode === "watch") {
          const { lastDisagreement, ...a } = agreement(r.id, decisions, savedAt(r));
          out.agreement = { ...a, lastDisagreement: lastDisagreement
            ? { ts: lastDisagreement.ts, decision: lastDisagreement.decision, display: lastDisagreement.display || "" }
            : null };
        }
        return out;
      }),
    }, null, 2));
    return;
  }
  if (loaded.state === "none") {
    console.log(dim("No rules. Every prompt comes to you, which is the default and stays the default."));
    return;
  }
  if (loaded.state === "invalid") {
    console.log(red(`No rules are in force: ${loaded.why}.`));
    console.log(dim("Nothing in the file is applied while any of it is wrong."));
    return;
  }
  let watching = 0;
  for (const r of loaded.rules) {
    const mode = r.mode || "on";
    if (mode === "watch") watching++;
    const verb = r.decision === "allow" ? green("allow") : red("deny ");
    const where = r.cwd ? path.basename(r.cwd) : "everywhere";
    const rows = mode === "watch" ? wouldHave(r) : fired(r.id);
    const count = rows.length
      ? `${rows.length}x${mode === "watch" ? " would have" : ""}`
      : dim(mode === "watch" ? "nothing matched yet" : "never fired");
    const state = mode === "on" ? "" : dim(` (${mode})`);
    const a = mode === "watch" && rows.length ? agreement(r.id, decisions, savedAt(r)) : null;
    const clause = a ? agreementClause(a) : "";
    console.log(`${verb} ${bold(r.shape.padEnd(26))} ${where.padEnd(18)} ${count}${state}${clause ? " · " + clause : ""}`);
    if (a && a.lastDisagreement) {
      const d = a.lastDisagreement;
      console.log(dim(`      last the other way: you ${d.decision === "deny" ? "denied" : "allowed"} "${d.display || d.shape}" ${new Date(d.ts * 1000).toLocaleString()}`));
    }
    // Said, never done: the switch is a click in Settings ▸ Rules, after a
    // confirmation. Nothing here changes a rule's mode.
    if (a && a.eligible) console.log(dim(`      matched you ${a.agreed}x over ${a.days} days, never the other way — "Let it answer" is in Settings ▸ Rules`));
    if (typeof r.tell === "string" && r.tell.trim()) console.log(dim(`      tells it: "${r.tell}"`));
  }
  if (watching) {
    console.log("\n" + dim(`${watching} watching: answering nothing, writing down what it would have done.`));
  }
  console.log("\n" + dim("Applied by the macOS app. This command lists them; it does not answer from them."));
}

// Empties the ledger. Deliberately not "prune": this is the answer to "I would
// rather not keep that", so it removes everything and says how much it removed.
function forget() {
  const n = readDecisions().length;
  try { fs.rmSync(decisionsFile, { force: true }); } catch {}
  console.log(`Forgot ${n} decision${n === 1 ? "" : "s"} (${decisionsFile}).`);
}

// --- what's left of the quota ---
// The same local sources the app reads, and the same refusals. Codex stamps the
// exact percentages of both its windows into every rollout; Copilot prices its own
// spend in a SQLite database this dependency-free script can only open when the
// sqlite3 binary happens to be around; Claude keeps its windows on a server, and
// this command does not call servers. What can't be read is said out loud, because
// an absent row and a zero row must never look the same.

function newestRollout() {
  const base = process.env.CODEX_HOME || path.join(os.homedir(), ".codex");
  let dir = path.join(base, "sessions");
  for (let i = 0; i < 3; i++) {          // year / month / day, zero-padded so max = newest
    let names = [];
    try { names = fs.readdirSync(dir).filter((n) => !n.startsWith(".")).sort(); } catch { return null; }
    if (!names.length) return null;
    dir = path.join(dir, names[names.length - 1]);
  }
  // Within the day pick by mtime: a RESUMED session appends to an old-named file.
  let best = null, bestAt = -1, items = [];
  try { items = fs.readdirSync(dir); } catch { return null; }
  for (const n of items) {
    if (!n.startsWith("rollout-") || !n.endsWith(".jsonl")) continue;
    const f = path.join(dir, n);
    let at = 0; try { at = fs.statSync(f).mtimeMs; } catch { continue; }
    if (at >= bestAt) { bestAt = at; best = f; }
  }
  return best;
}

// A rollout carries more than one bucket — the account-wide "codex" one with the
// windows, and a "premium" one that is mostly nulls but holds the credit balance —
// and which lands last is arbitrary. Walk back once, keep the newest per limit_id.
function codexUsage() {
  const file = newestRollout();
  if (!file) return null;
  let text = ""; try { text = fs.readFileSync(file, "utf8"); } catch { return null; }
  const win = (w, fallback) => {
    if (!w || typeof w.used_percent !== "number") return null;   // no window, no meter
    const m = w.window_minutes;
    const name = m === 10080 ? "weekly" : m ? (m % 60 === 0 ? `${m / 60}h` : `${m}m`) : fallback;
    // A reset after the year 2100 is not a reset. Same ceiling the app applies and
    // for the same reason: this number comes out of a file nobody here wrote, and
    // "resets Invalid Date" is a worse answer than not mentioning a reset at all.
    const resets = typeof w.resets_at === "number" && w.resets_at > 0
      && w.resets_at < 4102444800 ? w.resets_at : null;
    return { name, used: Math.min(100, Math.max(0, w.used_percent)), resetsAt: resets };
  };
  const lines = text.split("\n");
  const seen = new Set();
  const out = { windows: [], credits: null };
  let found = false;
  for (let i = lines.length - 1; i >= 0; i--) {
    const line = lines[i];
    if (!line.includes("token_count") || !line.includes("rate_limits")) continue;
    let o; try { o = JSON.parse(line); } catch { continue; }
    const limits = o && o.payload && o.payload.type === "token_count" && o.payload.rate_limits;
    if (!limits) continue;
    const at = Date.parse(o.timestamp || "");
    if (at && Date.now() - at >= 24 * 3600 * 1000) break;   // stale beats wrong
    const id = limits.limit_id || "codex";
    if (seen.has(id)) continue;
    seen.add(id);
    found = true;
    if (id === "codex") {
      const a = win(limits.primary, "5h"), b = win(limits.secondary, "weekly");
      if (a) out.windows.push(a);
      if (b) out.windows.push(b);
    }
    const cr = limits.credits;
    if (cr && cr.has_credits && cr.balance) out.credits = `${cr.balance} credits left`;
  }
  return found && (out.windows.length || out.credits) ? out : null;
}

const sqliteTool = (() => {
  const dirs = (process.env.PATH || "").split(path.delimiter).concat(["/usr/bin", "/opt/homebrew/bin"]);
  for (const d of dirs) {
    if (!d) continue;
    const f = path.join(d, "sqlite3");
    try { fs.accessSync(f, fs.constants.X_OK); return f; } catch {}
  }
  return null;
})();

// toISOString is already the UTC text `created_at` holds ("…T10:00:00.000Z").
const utcStamp = (d) => d.toISOString();

// `created_at` is UTC text, so the local day is turned into a range here rather
// than matched as a prefix — a prefix takes somebody else's day either side of
// midnight, and is wrong by a whole evening in half the world.
function copilotSpend() {
  const home = process.env.COPILOT_HOME || path.join(os.homedir(), ".copilot");
  const db = path.join(home, "session-store.db");
  if (!fs.existsSync(db)) return null;
  if (!sqliteTool) return { needsSqlite: true };
  const start = new Date(nowMs()); start.setHours(0, 0, 0, 0);
  const end = new Date(start.getTime() + 24 * 3600 * 1000);
  const sql = "SELECT coalesce(sum(total_nano_aiu),0)||'|'||"
    + "coalesce(sum(input_tokens+output_tokens+cache_write_tokens),0)||'|'||count(*)"
    + ` FROM assistant_usage_events WHERE created_at >= '${utcStamp(start)}'`
    + ` AND created_at < '${utcStamp(end)}';`;
  let raw = "";
  try {
    // -readonly, always: a normal open of a WAL database lets this process
    // checkpoint a log the Copilot CLI is still writing.
    raw = require("child_process").execFileSync(sqliteTool, ["-readonly", db, sql],
      { timeout: 4000, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
  } catch { return null; }
  const [nano, tokens, events] = String(raw).trim().split("|").map((n) => parseInt(n, 10) || 0);
  return events ? { nano, tokens, events } : null;
}

const aiu = (nano) => {
  const v = nano / 1e9;
  return v >= 10 ? v.toFixed(0) : v >= 1 ? v.toFixed(1) : v.toFixed(2);
};

const resetText = (epoch) => {
  if (!epoch) return "";
  const d = new Date(epoch * 1000);
  const far = d.getTime() - Date.now() >= 18 * 3600 * 1000;
  // The weekday is a word and the rest of this output is English; the clock is a
  // number and follows the machine.
  return far
    ? d.toLocaleDateString("en-US", { weekday: "short" })
    : d.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" });
};

const windowText = (w) => {
  if (w.resetsAt && w.resetsAt * 1000 <= Date.now()) return "window reset";
  const left = `${Math.round(100 - w.used)}% left`;
  const r = resetText(w.resetsAt);
  return r ? `${left} · resets ${r}` : left;
};

// Ten cells, because the number beside it is the precise half. Colour only where it
// means something: a bar that is always yellow has said nothing.
const meter = (used) => {
  const filled = Math.min(10, Math.max(used > 0 ? 1 : 0, Math.round(used / 10)));
  const bar = "█".repeat(filled) + "░".repeat(10 - filled);
  return used >= 95 ? red(bar) : used >= 80 ? yellow(bar) : dim(bar);
};

function printUsage(json) {
  const codex = codexUsage();
  const copilot = copilotSpend();
  if (json) {
    console.log(JSON.stringify({ codex, copilot }, null, 2));
    return;
  }
  const rows = [];
  if (codex) {
    // A window past its reset gets NO bar. Nobody has written a number since it
    // rolled over, so a full bar would be last window's news and an empty one
    // would be a zero nobody measured.
    codex.windows.forEach((w, i) => rows.push([i ? "" : "Codex", w.name,
      w.resetsAt && w.resetsAt * 1000 <= Date.now() ? "" : meter(w.used), windowText(w)]));
    if (codex.credits) rows.push([codex.windows.length ? "" : "Codex", "", "", codex.credits]);
  }
  if (copilot && !copilot.needsSqlite) {
    rows.push(["Copilot", "", "", `${aiu(copilot.nano)} AIU today · ${compact(copilot.tokens)} tokens`]);
  }
  if (!rows.length) console.log(dim("No quota anyone publishes locally could be read."));
  for (const [name, win, bar, text] of rows) {
    // The bar's column is held open whether or not there is a bar, so every
    // sentence starts at the same place and a missing meter reads as missing.
    const cell = bar || " ".repeat(10);
    console.log(`${bold(name.padEnd(9))}${dim(win.padEnd(8))}${cell}  ${text}`);
  }
  // What could not be read, named — never left to look like a zero.
  const notes = [];
  if (copilot && copilot.needsSqlite) notes.push("Copilot's ledger needs the sqlite3 binary; it isn't on PATH.");
  notes.push("Claude keeps its windows on its own servers; the macOS app can ask for them (Settings ▸ Usage).");
  console.log("\n" + notes.map((n) => dim(n)).join("\n"));
}

// --- what moved in the repo ---
// The wording is the feature: this is what changed in the REPO while the session was
// open, not what the agent did. You edit in the same tree and two sessions can share
// one checkout, and nothing here can separate those.

// On macOS /usr/bin/git is a stub that pops the "install developer tools" dialog when
// the tools are missing. A background CLI must never do that.
const gitTool = (() => {
  for (const p of ["/opt/homebrew/bin/git", "/usr/local/bin/git"]) {
    try { fs.accessSync(p, fs.constants.X_OK); return p; } catch {}
  }
  if (process.platform !== "darwin") return "git";
  for (const p of ["/Library/Developer/CommandLineTools/usr/bin/git",
                   "/Applications/Xcode.app/Contents/Developer/usr/bin/git"]) {
    try { fs.accessSync(p, fs.constants.X_OK); return "/usr/bin/git"; } catch {}
  }
  return null;
})();

function git(args, cwd) {
  if (!gitTool) return null;
  try {
    return require("child_process").execFileSync(gitTool, args, {
      cwd, timeout: 3000, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"],
      env: { ...process.env, GIT_OPTIONAL_LOCKS: "0", GIT_TERMINAL_PROMPT: "0" },
    });
  } catch { return null; }
}

// "<added>\t<removed>\t<path>", with "-" in both numeric columns for a binary file.
function numstat(text) {
  const out = {};
  for (const line of (text || "").split("\n")) {
    const parts = line.split("\t");
    if (parts.length < 3) continue;
    const file = parts.slice(2).join("\t");
    out[file] = parts[0] === "-" || parts[1] === "-"
      ? { binary: true } : { a: parseInt(parts[0], 10) || 0, r: parseInt(parts[1], 10) || 0 };
  }
  return out;
}

// Taken the first time a session is seen, and kept in the seen sidecar so one-shot
// commands can still measure a span. No baseline later means no numbers at all.
function repoBaseline(cwd) {
  if (!cwd) return null;
  const head = git(["rev-parse", "HEAD"], cwd);
  if (!head || !head.trim()) return null;
  return { head: head.trim(), dirt: numstat(git(["diff", "--numstat", "HEAD"], cwd)) };
}

function repoChange(cwd, baseline) {
  if (!cwd || !baseline || !baseline.head) return null;
  // A reset or a jump to an unrelated branch makes the span meaningless.
  if (git(["merge-base", "--is-ancestor", baseline.head, "HEAD"], cwd) === null) return null;
  const text = git(["diff", "--numstat", baseline.head], cwd);
  if (text === null) return null;
  const now2 = numstat(text), was = baseline.dirt || {};
  let files = 0, added = 0, removed = 0;
  for (const [file, st] of Object.entries(now2)) {
    if (st.binary) { if (!was[file]) files++; continue; }
    // Floored per file: a session that reverted earlier edits leaves a smaller diff
    // than the baseline, and a negative line count is not readable.
    const a = Math.max(0, st.a - ((was[file] && was[file].a) || 0));
    const r = Math.max(0, st.r - ((was[file] && was[file].r) || 0));
    if (!(a + r)) continue;
    files++; added += a; removed += r;
  }
  return files ? { files, added, removed, base: baseline.head.slice(0, 7) } : null;
}

const changeText = (ch) =>
  `${ch.files} file${ch.files === 1 ? "" : "s"}` +
  (ch.added ? ` +${ch.added}` : "") + (ch.removed ? ` \u2212${ch.removed}` : "");

// MARK: - Rendering

const DOTS = { permission: yellow("●"), question: blue("●"), thinking: green("●"), tool: green("●"), error: red("●"), idle: dim("●"), done: dim("●") };
// What to surface first — same weights the app sorts by. A failure ranks above
// the clean finishes so it can't be buried, but below live work.
const PRIORITY = { permission: 4, question: 3, thinking: 2, tool: 2, error: 1, idle: 0, done: 0 };

// Optional per docs/protocol.md: absent started_at simply renders nothing.
function elapsed(startedAt) {
  if (!startedAt || startedAt <= 0) return null;
  const d = now() - startedAt;
  if (d < 0) return null;
  if (d < 60) return `${d}s`;
  if (d < 3600) return `${Math.floor(d / 60)}m`;
  return `${Math.floor(d / 3600)}h${String(Math.floor((d % 3600) / 60)).padStart(2, "0")}`;
}

function sessionLine(s) {
  const name = s.project || "session";
  const branch = gitBranch(s.cwd);
  const age = elapsed(s.started_at);
  const label = s.state === "permission" ? yellow("needs approval")
    : s.state === "question" ? blue(s.label || "waiting for your answer")
    : s.state === "error" ? red("failed") + (s.label ? dim(" — " + s.label) : "")
    : (s.label ? dim(s.label) : dim(s.state));
  return `${DOTS[s.state] || dim("●")} ${bold(name)}${branch ? dim(" · " + branch) : ""}  ${label}${age ? dim("  " + age) : ""}  ${dim((s.agent_name || s.agent || "?").toUpperCase())}`;
}

function printStatus(json) {
  const ss = sessions();
  recordHistory(ss);
  if (json) return console.log(JSON.stringify(ss, null, 2));
  if (!ss.length) return console.log(dim("No active sessions"));
  for (const s of ss) console.log(sessionLine(s));
}

function printRequests(json) {
  const rs = requests();
  if (json) return console.log(JSON.stringify(rs, null, 2));
  if (!rs.length) return console.log(dim("No pending requests"));
  rs.forEach((r, i) => {
    console.log(`${bold(String(i + 1) + ".")} ${yellow(r.display || r.toolName || "request")}  ${dim(r.agent || "")}`);
    const ctx = r.context || {};
    const lines = (s, mark) => String(s || "").split("\n").slice(0, 6).forEach((l) => console.log(`   ${mark}${l}`));
    if (ctx.kind === "bash") lines(ctx.command, dim("$ "));
    if (ctx.kind === "diff") { lines(ctx.old, red("− ")); lines(ctx.new, green("+ ")); if (ctx.more) console.log(dim(`   +${ctx.more} more edit(s)`)); }
    if (ctx.kind === "write") lines(ctx.preview, dim("  "));
    // The plan is the thing being approved — show more of it than a preview.
    if (ctx.kind === "plan") {
      const all = String(ctx.plan || "").split("\n");
      all.slice(0, 20).forEach((l) => console.log(`   ${dim("│ ")}${l}`));
      if (all.length > 20) console.log(dim(`   … +${all.length - 20} more lines (--json for all)`));
      console.log(dim("   deny = keep planning · approve happens in the session's own dialog"));
    }
    if (ctx.kind === "question") {
      for (const q of ctx.questions || []) {
        if ((ctx.questions || []).length > 1) console.log(`   ${bold(q.header || q.question)}`);
        (q.options || []).forEach((o, k) =>
          console.log(`   ${bold(String(k + 1) + ")")} ${o.label}${o.description ? dim("  " + o.description) : ""}`));
        if (q.multiSelect) console.log(dim("   (pick several — answer from the app or the wizard)"));
      }
    }
    if (r.ruleSuggestion) console.log(dim("   --always available"));
  });
}

// One line, no control characters, at most 500 — the rules permission.js applies.
function cleanNote(v) {
  if (typeof v !== "string") return "";
  const s = v.replace(/[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/g, "")
    .replace(/[\u0000-\u001f\u007f]+/g, " ").replace(/\s+/g, " ").trim();
  if (s.length <= 500) return s;
  // Never end the cut on half of an emoji: a lone surrogate makes the answer
  // unparseable to a host whose JSON reader refuses one.
  let cut = s.slice(0, 499);
  const last = cut.charCodeAt(cut.length - 1);
  if (last >= 0xd800 && last <= 0xdbff) cut = cut.slice(0, -1);
  return cut + "…";
}

function decide(behavior, argv) {
  // `--note TEXT` / `-m TEXT` / `--note=TEXT`, pulled out before the index is
  // looked for so a note that happens to be a number is not read as one.
  let note = "";
  argv = argv.slice();
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--note" || a === "-m") { note = argv[i + 1] || ""; argv.splice(i, 2); i--; }
    else if (a.startsWith("--note=")) { note = a.slice(7); argv.splice(i, 1); i--; }
  }
  if (note && behavior !== "deny") {
    console.error("A note goes with a denial: `agentbar deny --note \"...\"`.");
    process.exit(1);
  }
  const explicit = argv.find((a) => /^\d+$/.test(a));
  const n = parseInt(explicit || "1", 10);
  const always = argv.includes("--always");
  const rs = requests();
  if (!rs.length) { console.error("No pending requests."); process.exit(1); }
  // Bare approve/deny means the newest PERMISSION — a question sorting to the
  // head of the queue must not shadow it. An explicit index is taken literally.
  const r = explicit ? rs[n - 1]
                     : rs.find((x) => (x.context || {}).kind !== "question") || rs[0];
  if (!r) { console.error(`No request #${n} (have ${rs.length}).`); process.exit(1); }
  if ((r.context || {}).kind === "question" && behavior !== "defer") {
    console.error("That's a question, not a permission — pick an option in `agentbar watch` (keys 1-9) or answer in the terminal wizard.");
    process.exit(1);
  }
  if ((r.context || {}).kind === "plan" && behavior === "allow") {
    // The hook cannot approve a plan (the approval also picks the next
    // permission mode); pretending otherwise would print a lie.
    console.error("Plans are approved in the session's own dialog — the hook can't carry the mode choice. Use `agentbar deny` to keep planning, or answer in the terminal.");
    process.exit(1);
  }
  answer(r, behavior === "allow" && always ? "always" : behavior, note);
  const verb = behavior === "deny"
    ? ((r.context || {}).kind === "plan" ? yellow("✎ keep planning") : red("✕ denied"))
    : green("✓ " + (always ? "always allowed" : "allowed"));
  console.log(`${verb}  ${r.display || r.toolName}`);
  if (cleanNote(note)) console.log(dim(`   told it: "${cleanNote(note)}"`));
}

// A single single-select question's options, when request r is one — the shape
// the digit keys in `watch` can answer.
function simpleQuestion(r) {
  const ctx = r.context || {};
  if (ctx.kind !== "question") return null;
  const qs = ctx.questions || [];
  if (qs.length !== 1 || qs[0].multiSelect) return null;
  return (qs[0].options || []).map((o) => o.label);
}

// `agentbar answer [n] <label...>` — answer a pending question by option label
// (or 1-based option number). Multi-question calls need per-question toggles a
// one-liner can't express; those answer in the app or the wizard.
function answerCmd(argv) {
  const rs = requests();
  const explicit = /^\d+$/.test(argv[0] || "") && argv.length > 1 ? argv.shift() : null;
  const r = explicit ? rs[parseInt(explicit, 10) - 1]
                     : rs.find((x) => (x.context || {}).kind === "question");
  if (!r) { console.error(explicit ? `No request #${explicit}.` : "No pending question."); process.exit(1); }
  const ctx = r.context || {};
  if (ctx.kind !== "question") { console.error(`Request #${explicit || 1} is a permission — use approve/deny.`); process.exit(1); }
  const qs = ctx.questions || [];
  if (qs.length !== 1) { console.error("Multi-question call — answer it in the AgentBar app or the terminal wizard."); process.exit(1); }
  const q = qs[0];
  const labels = (q.options || []).map((o) => o.label);
  const picked = argv.map((a) =>
    /^\d+$/.test(a) ? labels[parseInt(a, 10) - 1] : labels.find((l) => l.toLowerCase() === a.toLowerCase()));
  if (!argv.length || picked.some((l) => !l)) {
    console.error("Pick from: " + labels.map((l, i) => `${i + 1}) ${l}`).join("  "));
    process.exit(1);
  }
  const unique = [...new Set(picked)];
  if (!q.multiSelect && unique.length !== 1) { console.error("Single-select question — pick exactly one option."); process.exit(1); }
  answerQuestion(r, [unique]);
  console.log(`${green("✓ answered")}  ${unique.join(", ")}  ${dim("— " + (q.question || ""))}`);
}

// MARK: - Presence (what makes hooks block for remote approval on Linux)

function heartbeat() {
  fs.mkdirSync(base, { recursive: true });
  writeAtomic(watcherFile, { pid: process.pid, ts: now() });
}
function clearHeartbeat() {
  const w = readJSON(watcherFile);
  if (w && w.pid === process.pid) { try { fs.rmSync(watcherFile, { force: true }); } catch {} }
}

function waybar() {
  heartbeat(); // each poll refreshes presence; keep the module interval <= 30s
  const ss = sessions(), rs = requests();
  recordHistory(ss);
  const pending = ss.filter((s) => s.state === "permission").length;
  // A session blocked on an AskUserQuestion is waiting on the human exactly like
  // a permission is — it must not hide inside "idle".
  const asking = ss.filter((s) => s.state === "question").length;
  const working = ss.filter((s) => s.state === "thinking" || s.state === "tool").length;
  const cls = pending ? "permission" : asking ? "question" : working ? "working" : ss.length ? "idle" : "empty";
  const text = pending ? `✋ ${pending}` : asking ? `❓ ${asking}` : working ? `● ${working}` : ss.length ? `${ss.length}` : "";
  const tooltip = ss.map((s) => `${s.project || "session"} — ${s.state}${s.label ? " · " + s.label : ""} (${s.agent_name || s.agent})`)
    .concat(rs.map((r) => `pending: ${r.display}`)).join("\n") || "no sessions";
  console.log(JSON.stringify({ text, alt: cls, class: cls, tooltip }));
}

function watch(argv) {
  const i = argv.indexOf("-i");
  const interval = Math.max(1, parseInt(i >= 0 ? argv[i + 1] : "2", 10) || 2);
  const render = () => {
    heartbeat();
    let out = "\x1b[2J\x1b[H" + bold("AgentBar") + dim(`  ·  a allow · A always · d deny · f defer · 1-9 answer · q quit\n\n`);
    const ss = sessions();
    recordHistory(ss);
    out += ss.length ? ss.map(sessionLine).join("\n") + "\n" : dim("No active sessions\n");
    const rs = requests();
    if (rs.length) {
      out += "\n" + bold("Pending") + "\n";
      const firstQuestion = rs.find((r) => (r.context || {}).kind === "question");
      rs.forEach((r, k) => {
        out += `${k + 1}. ${yellow(r.display || r.toolName)}\n`;
        // The newest question's single-select options answer on a digit key.
        const opts = r === firstQuestion ? simpleQuestion(r) : null;
        if (opts) opts.forEach((label, j) => { out += `   ${bold(String(j + 1) + ")")} ${label}\n`; });
      });
    }
    process.stdout.write(out);
  };
  const timer = setInterval(render, interval * 1000);
  // Presence on its own clock, not the screen's: render() refreshes it too, but
  // `-i 120` would let the heartbeat lapse past PRESENCE_TTL between frames and
  // every hook would stop blocking for remote approval mid-watch. A third of the
  // TTL survives one missed beat. A failed write is retried on the next beat
  // rather than taking the watch down.
  const beat = setInterval(() => { try { heartbeat(); } catch {} }, (PRESENCE_TTL / 3) * 1000);
  const quit = () => { clearInterval(timer); clearInterval(beat); clearHeartbeat(); process.stdout.write("\n"); process.exit(0); };
  process.on("SIGINT", quit);
  process.on("SIGTERM", quit);
  process.on("SIGHUP", quit); // PTY closed under us — the heartbeat must not outlive the terminal
  if (process.stdin.isTTY) {
    process.stdin.setRawMode(true);
    process.stdin.resume();
    // Keys can arrive several to a chunk (fast typing, pastes, test PTYs) —
    // handle each, not the chunk as one "key".
    process.stdin.on("data", (b) => { for (const k of b.toString()) handleKey(k); });
    const handleKey = (k) => {
      if (k === "q" || k === "\x03") return quit();
      const rs = requests();
      if (!rs.length) return;
      // Letters answer the newest PERMISSION even when a question sorts ahead
      // of it; digits answer the newest question's options. Neither queue can
      // shadow the other.
      const perm = rs.find((r) => (r.context || {}).kind !== "question");
      const quest = rs.find((r) => (r.context || {}).kind === "question");
      if (k === "a" && perm) { answer(perm, "allow"); render(); }
      if (k === "A" && perm) { answer(perm, "always"); render(); }   // allow + the rule Claude suggested
      if (k === "d" && perm) { answer(perm, "deny"); render(); }
      if (k === "f") { answer(rs[0], "defer"); render(); }    // hand the newest back to its own prompt
      if (/^[1-9]$/.test(k) && quest) {
        const opts = simpleQuestion(quest);
        const label = opts && opts[parseInt(k, 10) - 1];
        if (label) { answerQuestion(quest, [[label]]); render(); }
      }
    };
  }
  render();
}

// MARK: - install-hooks (Linux counterpart of the macOS app's HookInstaller;
// same safety rules: never touch an unparseable config, write only on change)

// MARK: - doctor (check ids mirror Sources/AgentBar/Diagnostics.swift; docs/diagnostics.md)

// Every integration here fails the same way: silently. A hook that is not wired is
// an absence, not an error; a hook wired to an interpreter that has moved never
// runs, so it never complains. This re-derives the installation from disk and says
// what is wrong in the words of the fix. Reads only, apart from one write probe.
const INTEGRATIONS = [
  { id: "claude", name: "Claude Code", presence: [".claude"],
    configs: [".claude/settings.json"], marker: "/.agentbar/hooks/claude/" },
  { id: "codex", name: "Codex CLI", presence: [".codex"],
    configs: [".codex/config.toml"], marker: "/.agentbar/hooks/codex/" },
  { id: "copilot", name: "Copilot CLI", presence: [".copilot"],
    configs: [".copilot/hooks/agentbar.json"], marker: "/.agentbar/hooks/claude/" },
  { id: "cursor", name: "Cursor CLI", presence: [".cursor"],
    configs: [".cursor/hooks.json"], marker: "/.agentbar/hooks/cursor/" },
  { id: "gemini", name: "Gemini CLI", presence: [".gemini"],
    configs: [".gemini/settings.json"], marker: "/.agentbar/hooks/gemini/" },
  { id: "qwen", name: "Qwen Code", presence: [".qwen"],
    configs: [".qwen/settings.json"], marker: "/.agentbar/hooks/claude/" },
  { id: "antigravity", name: "Antigravity", presence: [".gemini/antigravity", ".gemini/antigravity-cli"],
    configs: [".gemini/antigravity/hooks.json", ".gemini/antigravity-cli/hooks.json"], marker: "agentbar" },
  { id: "opencode", name: "OpenCode", presence: [".config/opencode"],
    configs: [".config/opencode/plugins/agentbar.js"], marker: "agentbar" },
  // An integration, not an agent: AgentBar's own Claude Code mod, loaded through
  // env.CLAUDE_CODE_PLUGIN_DIRS in every Claude config dir. Off until switched on
  // (DEFAULT_OFF); doctor gives it rows of its own (claudeModChecks).
  { id: "claude-mod", name: "Claude Code mod", presence: [".claude"],
    configs: [".claude/settings.json"], marker: "/.agentbar/mods/claude" },
];
const HOOK_DIRS = ["claude", "codex", "cursor", "gemini", "antigravity", "opencode"];
// Two weeks, not a few days: people go on holiday, and an agent you simply did not
// use must not be reported as broken.
const QUIET_DAYS = 14;
// Keyed by the agent that runs them: install-hooks only pins a script when it
// wires that agent, so checking the others would flag a healthy machine.
const SHEBANG_SCRIPTS = { cursor: "cursor/cursor.js", antigravity: "antigravity/antigravity.js" };

// Every Claude config directory install-hooks wires, and so every one doctor has
// to look at: one list, so the two cannot drift apart again (doctor used to read
// ~/.claude alone and call a machine whose sessions run under CLAUDE_CONFIG_DIR
// healthy without ever opening the file those sessions read). `skip` hears about
// a directory left out, so install-hooks can say why.
function claudeConfigDirs(skip = () => {}) {
  const dirs = new Set([path.join(os.homedir(), ".claude")]);
  // A CLAUDE_CONFIG_DIR outside this HOME is almost always inherited by a run with a
  // borrowed HOME (a test, a sandbox, `HOME=$(mktemp -d)`): wiring it would point a
  // real Claude config at hooks under a throwaway directory, and every session started
  // until the next repair would run them from there. Somebody who really keeps their
  // config outside HOME says so with AGENTBAR_ALLOW_CONFIG_OUTSIDE_HOME=1.
  if (process.env.CLAUDE_CONFIG_DIR) {
    const custom = path.resolve(process.env.CLAUDE_CONFIG_DIR.replace(/^~/, os.homedir()));
    const home = path.resolve(os.homedir());
    if (custom === home || custom.startsWith(home + path.sep) || process.env.AGENTBAR_ALLOW_CONFIG_OUTSIDE_HOME === "1") {
      dirs.add(custom);
    } else {
      skip(`skip   claude  CLAUDE_CONFIG_DIR=${custom} is outside HOME (${home}); set AGENTBAR_ALLOW_CONFIG_OUTSIDE_HOME=1 to wire it anyway`);
    }
  }
  try {
    const raw = fs.readFileSync(path.join(base, "claude-config-dir"), "utf8").trim();
    if (raw) dirs.add(raw.replace(/^~/, os.homedir()));
  } catch {}
  // HookInstaller.wiredClaudeDirs: every ~/.claude-* that already names AgentBar's
  // hooks or mod — one alias per account wires them from a shell that had
  // CLAUDE_CONFIG_DIR, and a later run without it must still keep them current.
  for (const d of claudeDirsOnDisk()) {
    if (path.basename(d) === ".claude") continue;
    try {
      const text = fs.readFileSync(path.join(d, "settings.json"), "utf8");
      if (text.includes("/.agentbar/hooks/claude/") || text.includes("/.agentbar/mods/")) dirs.add(d);
    } catch {}
  }
  return [...dirs];
}

// Diagnostics.claudeModChecks, row for row: off is skipped (and off is where it
// starts); on, a Claude Code too old to load it, the copy that never landed, a
// config dir that does not name it, and Claude Code sessions with no mods.d at all.
function claudeModChecks(i, { add, there, read, shown, hist, H, turnedOff, explicitlyOff }) {
  if (!i.presence.some((d) => there(path.join(H, d)))) {
    add(`agent.${i.id}`, i.name, "skipped", "Claude Code is not installed here.");
    return;
  }
  if (turnedOff.has(i.id)) {
    add(`agent.${i.id}`, i.name, "skipped", explicitlyOff.has(i.id)
      ? "Turned off by you — AgentBar leaves its settings alone."
      : "Off until you switch it on (`agentbar wire claude-mod`) — the one integration that starts off.");
    return;
  }
  const v = claudeVersion();
  if (!modSupports(v)) {
    add(`agent.${i.id}.version`, "Claude Code loads mods", "fail",
        `Claude Code ${v} ignores the mod; ${MOD_MIN} or later loads it.`,
        "Update Claude Code (`claude update`), then start a new session.");
    return;
  }
  add(`agent.${i.id}.version`, "Claude Code loads mods", "ok",
      v ? `Claude Code ${v}.` : `Could not tell which Claude Code is installed; one older than ${MOD_MIN} ignores the mod.`);
  const copied = there(modDir);
  add(`agent.${i.id}.copied`, "The mod is installed", copied ? "ok" : "fail",
      copied ? null : `${modDir} is missing, so there is nothing for Claude Code to load.`,
      copied ? null : "Run `agentbar install-hooks` from a repo checkout.");
  const dirs = claudeConfigDirs().filter(there);
  const unwired = dirs.filter((d) => {
    let root = null;
    try { root = JSON.parse(read(path.join(d, "settings.json")) || "null"); } catch {}
    return !modIsWired(root);
  });
  const wired = dirs.length > 0 && !unwired.length;
  add(`agent.${i.id}.wired`, "Claude Code is told where the mod is", wired ? "ok" : "fail",
      wired ? null : `No \`${MOD_ENV}\` entry for it in ${unwired.length ? unwired.map((d) => shown(path.join(d, "settings.json"))).join(", ") : "any Claude settings"}.`,
      wired ? null : "Run `agentbar install-hooks`; if it stays unwired, that settings.json may not parse.");
  if (!wired) return;
  const DAY = 86400, windowS = 7 * DAY;
  let newest = 0;
  try {
    for (const f of fs.readdirSync(path.join(base, "mods.d"))) {
      if (!f.endsWith(".json")) continue;
      try { newest = Math.max(newest, Math.floor(fs.statSync(path.join(base, "mods.d", f)).mtimeMs / 1000)); } catch {}
    }
  } catch {}
  if (newest && now() - newest < windowS) {
    const days = Math.floor((now() - newest) / DAY);
    add(`agent.${i.id}.reported`, `${i.name} has reported`, "ok",
        days < 1 ? "Reported today." : `Last report ${days} day${days === 1 ? "" : "s"} ago.`);
    return;
  }
  let since = 0;
  try { since = Math.floor(fs.statSync(wireEnabledFile).mtimeMs / 1000); } catch {}
  const lastClaude = hist.filter((r) => r.agent === "claude").map((r) => r.endedAt || 0).reduce((a, b) => Math.max(a, b), 0);
  if (!(lastClaude > since && now() - lastClaude < windowS)) {
    add(`agent.${i.id}.reported`, `${i.name} has reported`, "ok", "No Claude Code session since it was switched on to judge by.");
    return;
  }
  add(`agent.${i.id}.reported`, `${i.name} has reported`, "warn",
      `Claude Code ran this week, and the mod wrote nothing to ${shownBase}/mods.d.`,
      "Start a NEW Claude Code session — a mod loads at session start. If it stays silent, `claude plugin validate ~/.agentbar/mods/claude` says why.");
}

function doctor(json) {
  const H = os.homedir(), out = [];
  const add = (id, title, status, detail, fix) => out.push({ id, title, status, detail, fix });
  const there = (p) => { try { fs.accessSync(p); return true; } catch { return false; } };
  const runnable = (p) => { try { fs.accessSync(p, fs.constants.X_OK); return true; } catch { return false; } };
  const real = (p) => { try { return fs.realpathSync(p); } catch { return null; } };
  const read = (p) => { try { return fs.readFileSync(p, "utf8"); } catch { return null; } };

  const self = real(process.execPath);
  const alias = ["/usr/bin/node", "/usr/local/bin/node", "/opt/homebrew/bin/node",
                 path.join(H, ".local/bin/node")].find((c) => real(c) === self);
  add("node.found", "A node interpreter", "ok", alias || process.execPath);
  add("node.stable", "...at a path that survives an upgrade", alias ? "ok" : "warn",
      alias ? null : `${process.execPath} looks version-pinned, and it is what gets written into every hook config.`,
      alias ? null : "Link a stable alias into /usr/local/bin, then re-run `agentbar install-hooks` — otherwise re-run it after every major node change.");

  for (const [name, dir] of [["state.d", stateDir], ["requests.d", reqDir], ["answers.d", ansDir]]) {
    if (!there(dir)) {
      add(`dirs.${name}`, `${shownBase}/${name}`, "fail", "Missing.",
          "Run `agentbar install-hooks`, or start any agent session — the hooks create these.");
      continue;
    }
    // Actually write: a directory can exist and still be unusable, and this is the
    // failure hooks hit most often — they have nowhere to report it to.
    const probe = path.join(dir, ".doctor." + process.pid);
    let wrote = false;
    try { fs.writeFileSync(probe, ""); fs.rmSync(probe, { force: true }); wrote = true; } catch {}
    add(`dirs.${name}`, `${shownBase}/${name}`, wrote ? "ok" : "fail",
        wrote ? null : "Exists but is not writable — hooks cannot report anything.",
        wrote ? null : `chmod u+w ${dir}`);
  }

  const hooks = path.join(base, "hooks");
  const missing = HOOK_DIRS.filter((d) => !there(path.join(hooks, d)));
  add("hooks.copied", "Hook scripts installed", missing.length ? "fail" : "ok",
      missing.length ? `Missing: ${missing.join(", ")}.` : null,
      missing.length ? "Run `agentbar install-hooks` from a repo checkout." : null);
  // The agents the person switched off (~/.agentbar/wire-disabled): unwired on
  // purpose, so nothing about them is a failure or something to repair.
  const explicitlyOff = loadWireDisabled();
  const turnedOff = effectiveDisabled(explicitlyOff);
  const installed = Object.entries(SHEBANG_SCRIPTS).filter(([agent]) =>
    (INTEGRATIONS.find((i) => i.id === agent) || { presence: [] }).presence
      .some((d) => there(path.join(H, d))));
  // Turned off, install-hooks stops pinning that script, and that is fine.
  const relevant = installed.filter(([agent]) => !turnedOff.has(agent)).map(([, rel]) => rel);
  if (!relevant.length) {
    add("hooks.shebang", "Scripts that run themselves name a real node", "skipped",
        installed.length ? "Turned off by you — AgentBar leaves those agents alone."
                         : "Neither Cursor nor Antigravity is installed here.");
  } else {
    const unpinned = relevant.filter((rel) => (read(path.join(hooks, rel)) || "").startsWith("#!/usr/bin/env")).sort();
    add("hooks.shebang", "Scripts that run themselves name a real node", unpinned.length ? "warn" : "ok",
        unpinned.length ? `Still on \`#!/usr/bin/env node\`: ${unpinned.join(", ")}.` : null,
        unpinned.length ? "Run `agentbar install-hooks`. A GUI-launched host inherits a PATH that usually has no node on it, so `env node` silently never fires." : null);
  }

  const hist = readHistory();
  // `~/x` for a path under HOME, the path itself otherwise — a Claude config dir
  // may live outside HOME when AGENTBAR_ALLOW_CONFIG_OUTSIDE_HOME says so.
  const shown = (p) => (p.startsWith(H + path.sep) ? "~/" + p.slice(H.length + 1) : p);
  for (const i of INTEGRATIONS) {
    if (i.id === "claude-mod") {
      claudeModChecks(i, { add, there, read, shown, hist, H, turnedOff, explicitlyOff });
      continue;
    }
    // Claude's settings are read from every directory install-hooks writes, and
    // each of them has to carry the hooks: a session started under a config dir
    // that was missed reports nothing, however healthy ~/.claude looks. Every other
    // agent's list is alternatives (Antigravity: either file will do).
    const extra = i.id === "claude" ? claudeConfigDirs() : [];
    const configs = i.id === "claude"
      ? extra.map((d) => path.join(d, "settings.json"))
      : i.configs.map((rel) => path.join(H, rel));
    if (!i.presence.some((d) => there(path.join(H, d))) && !extra.some(there)) {
      add(`agent.${i.id}`, i.name, "skipped", "Not installed here.");
      continue;
    }
    // Unwired because the person asked: not a failure, no fix, and no "has not
    // reported for a fortnight" — of course it has not.
    if (turnedOff.has(i.id)) {
      add(`agent.${i.id}`, i.name, "skipped", "Turned off by you — AgentBar leaves its settings alone.");
      continue;
    }
    const needsAll = i.id === "claude";
    let anyWired = false, absent = null;
    const unwired = [];   // every config that does not carry the marker, as shown
    for (const file of configs) {
      const text = read(file);
      if (text === null) {
        if (configs.length === 1) absent = shown(file);
        unwired.push(shown(file));
        continue;
      }
      if (file.endsWith(".json")) {
        try { JSON.parse(text); } catch {
          unwired.push(shown(file));
          add(`agent.${i.id}.parseable`, `${i.name} config parses`, "fail",
              `${shown(file)} is not valid JSON, so install-hooks refuses to touch it — deliberately, it is your file.`,
              "Fix the JSON (a `//` comment or a trailing comma is the usual cause), then re-run `agentbar install-hooks`.");
          continue;
        }
      }
      // JSONSerialization escapes forward slashes, so a config the macOS app wrote
      // says "\\/.agentbar\\/hooks\\/claude\\/" on disk. The installers never notice —
      // they match against the parsed value — but raw-text search does, and would
      // report every macOS-written config as unwired.
      const flat = text.replace(/\\\//g, "/");
      if (flat.includes(i.marker)) anyWired = true; else unwired.push(shown(file));
      const dead = (flat.match(/"(\/[^"]*\/node)"/g) || [])
        .map((m) => m.slice(1, -1)).filter((n) => !runnable(n));
      if (dead.length) {
        add(`agent.${i.id}.interpreter`, `${i.name}'s node still exists`, "fail",
            `${shown(file)} points at ${dead[0]}, which is gone. The hooks never run, so they never complain.`,
            "Re-run `agentbar install-hooks` — it repairs the path now.");
      }
    }
    const wired = needsAll ? unwired.length === 0 : anyWired;
    add(`agent.${i.id}.wired`, `${i.name} hooks`, wired ? "ok" : "fail",
        wired ? null : (absent ? `${absent} does not exist.`
          : needsAll && configs.length > 1 ? `Not wired into ${unwired.join(", ")} — install-hooks writes every config directory it knows of.`
          : "Installed, but AgentBar is not wired into it."),
        wired ? null : "Run `agentbar install-hooks`.");
    if (!wired) continue;

    const last = hist.filter((r) => r.agent === i.id).map((r) => r.endedAt || 0).sort((a, b) => b - a)[0];
    // No record is not a problem: history only starts when a frontend starts keeping
    // it, so every agent is blank on a freshly updated machine.
    if (!last) {
      add(`agent.${i.id}.lastSeen`, `${i.name} has reported`, "ok", "No session on record yet.");
    } else {
      const days = Math.floor((now() - last) / 86400);
      if (days >= QUIET_DAYS) {
        add(`agent.${i.id}.lastSeen`, `${i.name} has reported`, "warn", `Wired, but nothing for ${days} days.`,
            `If you have used ${i.name} since then, its hooks are not firing — start a NEW session (hook config is read at session start) and check back.`);
      } else {
        add(`agent.${i.id}.lastSeen`, `${i.name} has reported`, "ok",
            days < 1 ? "Last session today." : `Last session ${days} day${days === 1 ? "" : "s"} ago.`);
      }
    }
    if (i.id === "copilot") {
      const shelled = (read(path.join(H, ".copilot/hooks/agentbar.json")) || "").includes('"bash":');
      add("copilot.exec", "Copilot runs node directly", shelled ? "fail" : "ok",
          shelled ? "The hook is wrapped in a shell, so the hook's parent is a shell that exits at once — and that pid is what prunes dead rows. Every Copilot row would disappear on the next refresh." : null,
          shelled ? "Delete ~/.copilot/hooks/agentbar.json and re-run `agentbar install-hooks`." : null);
    }
    if (i.id === "codex") {
      // Codex runs no hook until a human has accepted it, and until then the whole
      // integration is inert in a way that looks exactly like nothing happening.
      // Its own row, because `agent.codex.wired` is satisfied by the notify key alone.
      const cfg = path.join(H, ".codex/config.toml");
      const toml = read(cfg) || "";
      if (toml.includes("# >>> agentbar >>>")) {
        const trusted = toml.includes(`hooks.state."${cfg}:session_start:`);
        add("codex.hooks", "Codex has accepted its hooks", trusted ? "ok" : "warn",
            trusted ? null : "Written, but not yet accepted. Codex asks once before it runs a hook, and until it is answered these do nothing — Codex sessions still appear, from the older notify bridge, but they cannot be approved from here.",
            trusted ? null : "Start a Codex session and accept the hooks it asks about.");
      }
    }
  }

  // Information, never a failure: the enabled plugins that could settle a prompt
  // before it reaches AgentBar (Diagnostics.pluginChecks). Sources only.
  {
    const seen = new Set();
    const dirs = claudeConfigDirs().concat(claudeDirsOnDisk()).filter((d) => {
      const r = real(d);
      if (!r || seen.has(r)) return false;
      seen.add(r); return true;
    });
    const title = "Claude Code plugins that can answer for you";
    if (!dirs.length) add("claude.plugins", title, "skipped", "Claude Code is not installed here.");
    else {
      const answering = pluginInventory(dirs).filter((p) => p.canAnswer);
      add("claude.plugins", title, "ok", answering.length
        ? answering.map((p) => `${p.name}: ${pluginSentence(p)}`).join("; ") + ". What they settle never reaches AgentBar."
        : "None — no enabled plugin can answer Claude Code's prompts for you.");
    }
  }

  // A rules file that will not parse is the one failure that is invisible by
  // design: nothing fires, every prompt comes back, and that is exactly what a
  // working AgentBar looks like. The app reports it in its own Diagnostics, and
  // this is where somebody wondering why their rule stopped working will look —
  // including on macOS, where this command is what gets pasted into a bug report.
  {
    const loaded = readRules();
    if (loaded.state === "none") {
      add("rules.file", "Rules", "skipped", "None written — every prompt comes to you.");
    } else if (loaded.state === "invalid") {
      add("rules.file", "Rules", "fail", `${loaded.why}. No rule is being applied.`,
          `Fix ${shownBase}/rules.json, or move it aside and write the rules again. `
          + "Nothing is applied while any of it is wrong.");
    } else {
      const titles = { on: "answering", watch: "watching", off: "off" };
      const counts = ["on", "watch", "off"]
        .map((m) => [titles[m], loaded.rules.filter((r) => (r.mode || "on") === m).length])
        .filter(([, n]) => n > 0)
        .map(([t, n]) => `${n} ${t}`);
      add("rules.file", "Rules", "ok",
          (counts.length ? counts.join(", ") : "none")
          + " — applied by the AgentBar app; this command only lists them.");
    }
  }

  const stale = [];
  for (const [name, dir, maxAge] of [["state.d", stateDir, 86400], ["requests.d", reqDir, 660], ["answers.d", ansDir, 60]]) {
    let files = []; try { files = fs.readdirSync(dir); } catch {}
    const old = files.filter((f) => {
      try { return now() - Math.floor(fs.statSync(path.join(dir, f)).mtimeMs / 1000) > maxAge; } catch { return false; }
    });
    if (old.length) stale.push(`${old.length} in ${name}`);
  }
  add("orphans", `No leftovers in ${shownBase}`, stale.length ? "warn" : "ok",
      stale.length ? `Past their pruning window: ${stale.join(", ")}.` : null,
      stale.length ? "Harmless — frontends skip them. They clear on the next pass." : null);

  // Same precedence the hooks themselves use (see permission.js): on macOS the app
  // is the frontend and pgrep is the answer; everywhere else it is the heartbeat.
  let appHere = false;
  if (process.platform === "darwin") {
    try { require("child_process").execSync("pgrep -x AgentBar", { stdio: "ignore" }); appHere = true; } catch {}
  }
  const w = readJSON(watcherFile);
  // Freshness only, exactly as permission.js judges it. `agentbar waybar` stamps
  // its own pid and exits, so a pid test said "nothing is listening" after every
  // waybar poll while the hook it describes was blocking and remote approval worked.
  const fresh = appHere || !!(w && w.ts && now() - w.ts < PRESENCE_TTL);
  add("frontend.present", "A frontend that hooks can block for", fresh ? "ok" : "warn",
      fresh ? (appHere ? "The AgentBar app is running." : "watcher.json heartbeat is fresh.") : "Nothing is listening, so hooks fall straight through to the terminal prompt — remote Allow/Deny is off.",
      fresh ? null : (process.platform === "darwin"
        ? "Launch AgentBar, or keep `agentbar watch` running."
        : "Keep `agentbar watch` running (or poll `agentbar waybar` at <= 30s) to answer approvals from here."));

  if (json) return console.log(JSON.stringify(out, null, 2));
  const paint = { ok: green, warn: yellow, fail: red, skipped: dim };
  for (const c of out) {
    console.log(`${paint[c.status](c.status.padEnd(7))} ${bold(c.id.padEnd(28))} ${c.title}`);
    if (c.detail) console.log(`        ${dim(c.detail)}`);
    if (c.fix) console.log(`        ${yellow("fix:")} ${c.fix}`);
  }
  const bad = out.filter((c) => c.status === "fail").length;
  const warn = out.filter((c) => c.status === "warn").length;
  console.log(`\n${out.length} checks - ${bad} failed - ${warn} worth a look`);
}

// `diff -u` of two texts, in the same shape the macOS app's LineDiff.unified prints:
// headers, `@@ -a,b +c,d @@` hunks, three lines of context. No dependency on a
// `diff` binary — a minimal container may not have diffutils, and the one thing
// this has to do is show the person every line before it is written. Lines keep
// their newline, so a file that only gained a trailing one still shows a change.
function unifiedDiff(oldText, newText, oldLabel, newLabel, context = 3) {
  const tokens = (t) => {
    if (!t) return [];
    const lines = t.split("\n");
    const terminated = lines[lines.length - 1] === "";
    if (terminated) lines.pop();
    return lines.map((l, i) => (i < lines.length - 1 || terminated ? l + "\n" : l));
  };
  const a = tokens(oldText), b = tokens(newText);
  if (a.length === b.length && a.every((l, i) => l === b[i])) return "";
  // Shared head and tail off first: a block appended to a long config.toml leaves
  // a middle of a few dozen lines, not the file squared. A middle still too big for
  // the table prints as all-removed then all-added — plainer, never wrong.
  let head = 0;
  while (head < a.length && head < b.length && a[head] === b[head]) head++;
  let tail = 0;
  while (tail < a.length - head && tail < b.length - head &&
         a[a.length - 1 - tail] === b[b.length - 1 - tail]) tail++;
  const x = a.slice(head, a.length - tail), y = b.slice(head, b.length - tail);
  let mid = [];
  if (x.length * y.length > 4e6) {
    mid = x.map((t) => [" -", t]).concat(y.map((t) => [" +", t]));
  } else {
    const n = x.length, m = y.length;
    const T = Array.from({ length: n + 1 }, () => new Int32Array(m + 1));
    for (let i = n - 1; i >= 0; i--)
      for (let j = m - 1; j >= 0; j--)
        T[i][j] = x[i] === y[j] ? T[i + 1][j + 1] + 1 : Math.max(T[i + 1][j], T[i][j + 1]);
    let i = 0, j = 0;
    while (i < n && j < m) {
      if (x[i] === y[j]) { mid.push(["  ", x[i]]); i++; j++; }
      else if (T[i + 1][j] >= T[i][j + 1]) mid.push([" -", x[i++]]);
      else mid.push([" +", y[j++]]);
    }
    while (i < n) mid.push([" -", x[i++]]);
    while (j < m) mid.push([" +", y[j++]]);
  }
  const rows = a.slice(0, head).map((t) => ["  ", t]).concat(mid, a.slice(a.length - tail).map((t) => ["  ", t]));
  const hunks = [];
  rows.forEach(([k], i) => {
    if (k === "  ") return;
    const lo = Math.max(0, i - context), hi = Math.min(rows.length - 1, i + context);
    const last = hunks[hunks.length - 1];
    if (last && lo <= last[1] + 1) last[1] = Math.max(last[1], hi); else hunks.push([lo, hi]);
  });
  const oldBefore = [0], newBefore = [0];
  rows.forEach(([k], i) => {
    oldBefore[i + 1] = oldBefore[i] + (k === " +" ? 0 : 1);
    newBefore[i + 1] = newBefore[i] + (k === " -" ? 0 : 1);
  });
  const range = (start, count) => {
    const first = count === 0 ? start : start + 1;
    return count === 1 ? `${first}` : `${first},${count}`;
  };
  const out = [`--- ${oldLabel}`, `+++ ${newLabel}`];
  for (const [lo, hi] of hunks) {
    out.push(`@@ -${range(oldBefore[lo], oldBefore[hi + 1] - oldBefore[lo])} ` +
             `+${range(newBefore[lo], newBefore[hi + 1] - newBefore[lo])} @@`);
    for (let r = lo; r <= hi; r++) {
      const [k, t] = rows[r];
      const mark = k === " +" ? "+" : k === " -" ? "-" : " ";
      if (t.endsWith("\n")) out.push(mark + t.slice(0, -1));
      else out.push(mark + t, "\\ No newline at end of file");
    }
  }
  return out.join("\n") + "\n";
}

// The copy kept before install-hooks writes into an agent's settings — the same
// rule the macOS app's ConfigBackup follows, so the two leave the same trail:
// `<file>.agentbar-bak-YYYYMMDD-HHMMSS` (local time) beside the file, the newest
// BACKUP_KEEP of them kept, and nothing at all when the write would change nothing.
// Rotation only ever deletes names that are exactly that suffix and stamp; a
// `settings.json.agentbar-bak-mine` is the person's and stays. The suffix also keeps
// the copy out of the directories an agent scans: Copilot loads every *.json under
// hooks/, and a name ending in a timestamp is not one.
const BACKUP_MARK = ".agentbar-bak-";
const BACKUP_KEEP = 3;
let backupsKept = 0; // for the closing line: say where the originals went only if any did
function backupStamp(ms) {
  const d = new Date(ms), p = (n) => String(n).padStart(2, "0");
  return `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}-` +
         `${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;
}
function backupsOf(file) {
  const dirName = path.dirname(file), prefix = path.basename(file) + BACKUP_MARK;
  let names = [];
  try { names = fs.readdirSync(dirName); } catch {}
  const key = (n) => { const t = n.slice(prefix.length); return [t.slice(0, 15), Number(t.slice(16) || 0)]; };
  return names.filter((n) => n.startsWith(prefix) && /^\d{8}-\d{6}(-\d+)?$/.test(n.slice(prefix.length)))
    .sort((x, y) => { const [a, an] = key(x), [b, bn] = key(y); return a !== b ? (a < b ? -1 : 1) : an - bn; });
}
// Print what changes, keep the original, then write — in that order, atomically.
// Returns whether anything was written.
function writeConfig(file, data) {
  let before = null;
  try { before = fs.readFileSync(file, "utf8"); } catch {}
  if (before === data) return false;
  const diff = unifiedDiff(before || "", data, before === null ? "/dev/null" : file, file);
  for (const line of diff.replace(/\n$/, "").split("\n")) {
    console.log(line.startsWith("+++") || line.startsWith("---") ? bold(line)
      : line.startsWith("@@") ? blue(line) : line.startsWith("+") ? green(line)
      : line.startsWith("-") ? red(line) : dim(line));
  }
  fs.mkdirSync(path.dirname(file), { recursive: true });
  let backup = null;
  if (before !== null) {
    const base = file + BACKUP_MARK + backupStamp(nowMs());
    backup = base;
    for (let n = 1; fs.existsSync(backup); n++) backup = `${base}-${n}`;
    fs.copyFileSync(file, backup);
  }
  // The file keeps its own mode. A new file gets 0666 & ~umask, and the rename put
  // that over a settings file somebody had kept at 0600 because it holds API keys
  // or MCP tokens — the backup beside it kept 0600, the live file became 0644.
  const t = file + "." + process.pid + ".tmp";
  let mode;
  if (before !== null) { try { mode = fs.statSync(file).mode & 0o777; } catch {} }
  fs.writeFileSync(t, data, mode === undefined ? undefined : { mode });
  if (mode !== undefined) fs.chmodSync(t, mode); // writeFileSync's mode is filtered by umask
  fs.renameSync(t, file);
  if (backup) {
    const ours = backupsOf(file);
    for (const old of ours.slice(0, Math.max(0, ours.length - BACKUP_KEEP)))
      fs.rmSync(path.join(path.dirname(file), old), { force: true });
    console.log(dim(`kept the previous version as ${backup}`));
    backupsKept++;
  }
  return true;
}

// A file AgentBar owns outright (Copilot's hooks/agentbar.json, OpenCode's plugin)
// taken away when its agent is switched off: the diff printed, the file kept beside
// itself exactly as a rewrite would keep it, then deleted — the path itself, not
// what a link points at, since removing the link is what takes it out of the
// directory the agent scans. Nothing there is nothing to do. Returns whether it acted.
function removeConfig(file) {
  let before;
  try { before = fs.readFileSync(file, "utf8"); } catch { return false; }
  const diff = unifiedDiff(before, "", file, "/dev/null");
  for (const line of diff.replace(/\n$/, "").split("\n")) {
    console.log(line.startsWith("+++") || line.startsWith("---") ? bold(line)
      : line.startsWith("@@") ? blue(line) : line.startsWith("-") ? red(line) : dim(line));
  }
  const stamp = file + BACKUP_MARK + backupStamp(nowMs());
  let backup = stamp;
  for (let n = 1; fs.existsSync(backup); n++) backup = `${stamp}-${n}`;
  fs.copyFileSync(file, backup);
  fs.rmSync(file, { force: true });
  const ours = backupsOf(file);
  for (const old of ours.slice(0, Math.max(0, ours.length - BACKUP_KEEP)))
    fs.rmSync(path.join(path.dirname(file), old), { force: true });
  console.log(dim(`kept it as ${backup}`));
  backupsKept++;
  return true;
}

// MARK: - Which agents to leave alone (~/.agentbar/wire-disabled)

// The same file, and the same reading rules, as the macOS app's WiringPrefs: one
// agent id per line, `#` starts a comment, blanks go, a token that is not shaped
// like an id is skipped, and an id this build does not know is kept on rewrite —
// so a newer app's agent survives this CLI saving the file. Missing or unreadable
// means nothing is disabled, which is exactly the behaviour before the file existed.
const wireDisabledFile = path.join(base, "wire-disabled");
const WIRE_HEADER = ["# Agents AgentBar leaves unwired, one id per line.",
                     "# Written by AgentBar (Settings > Agents) and the agentbar CLI."];
const WIRE_ID = /^[a-z0-9][a-z0-9_-]*$/;
