const WIRABLE = INTEGRATIONS.map((i) => i.id);
function parseWireDisabled(text) {
  const out = new Set();
  for (const raw of String(text).split(/\r\n|[\n\r\u000B\u000C\u0085\u2028\u2029]/)) {
    // WiringPrefs trims `.whitespaces` (spaces and tabs), not everything trim() eats:
    // a stray U+FEFF made a line an id here and junk in the app.
    const id = trimWhitespace(raw.split("#")[0]).toLowerCase();
    if (id && WIRE_ID.test(id)) out.add(id);
  }
  return out;
}
function loadWireDisabled() {
  // String(contentsOf:encoding:) drops a leading byte-order mark; so does this.
  try { return parseWireDisabled(fs.readFileSync(wireDisabledFile, "utf8").replace(/^\uFEFF/, "")); }
  catch { return new Set(); }
}
// An empty set removes the file, so "nothing disabled" has one spelling on disk.
function saveWireDisabled(ids) {
  if (!ids.size) { fs.rmSync(wireDisabledFile, { force: true }); return; }
  fs.mkdirSync(base, { recursive: true });
  const t = wireDisabledFile + "." + process.pid + ".tmp";
  fs.writeFileSync(t, WIRE_HEADER.concat([...ids].sort()).join("\n") + "\n");
  fs.chmodSync(t, 0o644);
  fs.renameSync(t, wireDisabledFile);
}
// `a,b` (or repeated flags) into known agent ids; an unknown one is a typo, not an
// agent to switch off, so it stops the run before anything is written.
function wireIds(list, flag) {
  const ids = list.flatMap((v) => String(v).split(",")).map((s) => s.trim().toLowerCase()).filter(Boolean);
  const bad = ids.filter((id) => !WIRABLE.includes(id));
  if (bad.length || !ids.length) {
    console.error(`agentbar ${flag}: ${bad.length ? `unknown agent ${bad.join(", ")}` : "needs an agent id"}`
      + ` (one of ${WIRABLE.join(", ")})`);
    process.exit(2);
  }
  return ids;
}

// MARK: - Integrations that start off (~/.agentbar/wire-enabled)

// WiringPrefs.defaultOff: wired only because somebody asked. Opting in is a file of
// its own rather than a line seeded into wire-disabled — a seed has to remember it
// was planted, and wire-disabled saved empty is deleted — so a missing line means
// off in every reader, with nothing to remember. wire-disabled still wins: a line
// there turns anything off. An older CLI or app never knew these ids and never
// reads wire-enabled.
const DEFAULT_OFF = new Set(["claude-mod"]);
const wireEnabledFile = path.join(base, "wire-enabled");
const ENABLED_HEADER = ["# Integrations AgentBar wires only because you asked, one id per line.",
                        "# Written by AgentBar (Settings > Agents) and the agentbar CLI."];
function loadWireEnabled() {
  try { return parseWireDisabled(fs.readFileSync(wireEnabledFile, "utf8").replace(/^﻿/, "")); }
  catch { return new Set(); }
}
function saveWireEnabled(ids) {
  if (!ids.size) { fs.rmSync(wireEnabledFile, { force: true }); return; }
  fs.mkdirSync(base, { recursive: true });
  const t = wireEnabledFile + "." + process.pid + ".tmp";
  fs.writeFileSync(t, ENABLED_HEADER.concat([...ids].sort()).join("\n") + "\n");
  fs.chmodSync(t, 0o644);
  fs.renameSync(t, wireEnabledFile);
}
// What every run acts on: switched off, plus each default-off id nobody switched on.
function effectiveDisabled(disabled = loadWireDisabled(), enabled = loadWireEnabled()) {
  const out = new Set(disabled);
  for (const id of DEFAULT_OFF) if (!enabled.has(id)) out.add(id);
  return out;
}

// MARK: - The Claude Code mod (env.CLAUDE_CODE_PLUGIN_DIRS) — ClaudeModWiring

const MOD_ENV = "CLAUDE_CODE_PLUGIN_DIRS";
const MOD_MARK = "/.agentbar/mods/";
const MOD_MIN = "2.1.287";
const modDir = path.join(base, "mods", "claude");
const modEntries = (v) => String(v || "").split(":").map((s) => s.trim()).filter(Boolean);
// Our directory last in the list, the person's own entries first and untouched,
// any AgentBar mod entry dropped. A value of the wrong type is refused, never fixed.
function modWired(root, dir) {
  if (root.env !== undefined && !isPlainObject(root.env)) return { plan: "refused", why: "`env` is not an object" };
  const env = Object.assign({}, root.env || {});
  if (env[MOD_ENV] !== undefined && typeof env[MOD_ENV] !== "string")
    return { plan: "refused", why: `\`env.${MOD_ENV}\` is not a string` };
  const next = modEntries(env[MOD_ENV]).filter((e) => !e.includes(MOD_MARK)).concat([dir]).join(":");
  if (next === env[MOD_ENV]) return { plan: "unchanged" };
  env[MOD_ENV] = next;
  return { plan: "write", root: Object.assign({}, root, { env }) };
}
// Without any AgentBar mod entry; an emptied key goes, and an emptied env with it.
function modUnwired(root) {
  if (!isPlainObject(root.env) || typeof root.env[MOD_ENV] !== "string") return { plan: "unchanged" };
  const all = modEntries(root.env[MOD_ENV]);
  const theirs = all.filter((e) => !e.includes(MOD_MARK));
  if (theirs.length === all.length) return { plan: "unchanged" };
  const env = Object.assign({}, root.env);
  if (theirs.length) env[MOD_ENV] = theirs.join(":"); else delete env[MOD_ENV];
  const out = Object.assign({}, root);
  if (Object.keys(env).length) out.env = env; else delete out.env;
  return { plan: "write", root: out };
}
const modIsWired = (root) => isPlainObject(root) && isPlainObject(root.env)
  && typeof root.env[MOD_ENV] === "string" && modEntries(root.env[MOD_ENV]).some((e) => e.includes(MOD_MARK));
function compareVersions(a, b) {
  const parts = (s) => (String(s).match(/^[0-9.]+/) || [""])[0].split(".").map((n) => Number(n) || 0);
  const x = parts(a), y = parts(b);
  for (let i = 0; i < Math.max(x.length, y.length); i++) {
    const l = x[i] || 0, r = y[i] || 0;
    if (l !== r) return l < r ? -1 : 1;
  }
  return 0;
}
// False only for a Claude Code known to be too old; an older one ignores the setting.
const modSupports = (v) => !v || compareVersions(v, MOD_MIN) >= 0;
// The cheap places first (ClaudeQuota.installedCLIVersion), then `claude --version`.
function claudeVersion() {
  const H = os.homedir();
  try {
    const names = fs.readdirSync(path.join(H, ".local/share/claude/versions")).filter((n) => /^[0-9]/.test(n))
      .sort((a, b) => compareVersions(a, b));
    if (names.length) return names[names.length - 1];
  } catch {}
  for (const d of claudeDirsOnDisk()) {
    const o = readJSON(path.join(d, ".last-update-result.json"));
    if (o && typeof o.version_to === "string") return o.version_to;
    if (o && typeof o.version_from === "string") return o.version_from;
  }
  try {
    const out = require("child_process").execFileSync("claude", ["--version"],
      { encoding: "utf8", timeout: 5000, stdio: ["ignore", "pipe", "ignore"] });
    const m = out.match(/\b\d+\.\d+[0-9.]*/);
    return m ? m[0] : null;
  } catch { return null; }
}
// ~/.claude and every ~/.claude-* — WeightReader.claudeConfigDirs.
function claudeDirsOnDisk() {
  const H = os.homedir();
  let names = [];
  try { names = fs.readdirSync(H).filter((n) => n === ".claude" || n.startsWith(".claude-")).sort(); } catch {}
  return names.map((n) => path.join(H, n));
}
// Each bundled mod into ~/.agentbar/mods/<name>, replaced whole when it differs;
// config.json — the person's — is never touched.
function copyMods(src, dest) {
  if (!fs.existsSync(src)) return;
  fs.mkdirSync(dest, { recursive: true });
  const tree = (root) => {
    const out = {};
    const walk = (d, rel) => {
      for (const e of fs.readdirSync(d, { withFileTypes: true })) {
        const p = path.join(d, e.name), r = rel ? rel + "/" + e.name : e.name;
        if (e.isDirectory()) walk(p, r); else if (e.isFile()) out[r] = fs.readFileSync(p);
      }
    };
    try { walk(root, ""); } catch { return null; }
    return out;
  };
  const same = (a, b) => a && b && Object.keys(a).length === Object.keys(b).length
    && Object.keys(a).every((k) => b[k] && b[k].equals(a[k]));
  for (const name of fs.readdirSync(src)) {
    if (name === "config.json" || name.startsWith(".")) continue;
    const target = path.join(dest, name);
    if (same(tree(path.join(src, name)), fs.existsSync(target) ? tree(target) : null)) continue;
    fs.rmSync(target, { recursive: true, force: true });
