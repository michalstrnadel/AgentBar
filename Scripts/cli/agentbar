  for (const cfgDir of on("claude") ? claudeDirs : []) {
    const file = path.join(cfgDir, "settings.json");
    const root = readConfig(file);
    if (root === null) continue;
    const hooks = root.hooks && typeof root.hooks === "object" ? root.hooks : {};
    for (const [ev, rules] of Object.entries(hooks)) {
      if (!Array.isArray(rules)) continue;
      const kept = rules.filter((rule) => !((rule.hooks || []).some((h) => String(h.command || "").includes("/.agentbar/hooks/claude/"))));
      if (kept.length) hooks[ev] = kept; else delete hooks[ev];
    }
    for (const [ev, cmd, matcher, timeout] of claudeEvents) {
      const entry = { type: "command", command: cmd };
      if (timeout) entry.timeout = timeout;
      const rule = { hooks: [entry] };
      if (matcher) rule.matcher = "*";
      hooks[ev] = (hooks[ev] || []).concat([rule]);
    }
    root.hooks = hooks;
    report(`claude  ${file}`, writeIfChanged(file, root));
  }

  // Codex — ~/.codex/config.toml notify hook (append-only, never rewrite TOML)
  const codexDir = path.join(os.homedir(), ".codex");
  // Present-and-unreadable or not UTF-8 is skipped, never read as empty (readCodexConfig).
  const codexFile = path.join(codexDir, "config.toml");
  const codexText = on("codex") && fs.existsSync(codexDir) ? readCodexConfig(codexFile) : null;
  if (codexText !== null) {
    const file = codexFile;
    let toml = codexText;
    const ours = `notify = ["${node}", "${path.join(hooksDir, "codex", "notify.js")}"]`;
    // Both keys are worked out on `toml` and written ONCE at the end, through
    // writeConfig (diff, backup, tmp+rename). Two writes used to happen here, and the
    // second one started from the text as it was before the first: a node that moved
    // repaired the notify line, then the hooks block was written over the original
    // and put the dead path back. One write also means one backup of the file as the
    // person had it, rather than one of a halfway state.
    const original = toml;
    // AgentBar's own hooks block, cut out before any "is notify already ours?"
    // question — it carries the same path on every line, and a blind match would
    // read it as a wired notify and never install notify again.
    const withoutBlock = (t) => {
      const b = t.indexOf(CODEX_BEGIN);
      if (b < 0) return t;
      const e = t.indexOf(CODEX_END, b);
      return e < 0 ? t : t.slice(0, b) + t.slice(e + CODEX_END.length);
    };
    // A bare key written after a [table] header belongs to that table, so notify
    // must go above the first header (or above our own block), never at the end
    // of a file that has one — the same placement HookInstaller.codexPlan makes.
    const rootEnd = (t) => {
      const h = t.search(/^[ \t]*\[{1,2}[^\[\],=\n]*\]{1,2}[ \t]*(#.*)?$/m);
      const b = t.indexOf(CODEX_BEGIN);
      const found = [h, b].filter((i) => i >= 0);
      return found.length ? Math.min(...found) : -1;
    };
    const atRoot = (t) => {
      const end = rootEnd(t);
      if (end >= 0) return t.slice(0, end) + ours + "\n" + t.slice(end);
      return (t && !t.endsWith("\n") ? t + "\n" : t) + ours + "\n";
    };
    const line = toml.match(/^[ \t]*notify[ \t]*=[ \t]*\[[^\]]*\/\.agentbar\/hooks\/codex\/[^\]]*\]/m);
    if (line) {
      // Ours already — but "ours" is not "working". Every other config here is
      // rewritten whenever its content differs, so a moved node heals on the next
      // run. Codex used to stop at the marker, which made it the one integration
      // where a stale interpreter was permanent. Re-verify the interpreter.
      const interp = (line[0].match(/"([^"]*)"/) || [])[1];
      let alive = false;
      try { fs.accessSync(interp, fs.constants.X_OK); alive = true; } catch {}
      // Below a table header (where an older release appended it) the key is that
      // table's, Codex sees no top-level notify, and this branch said "ok" forever.
      const end = rootEnd(toml);
      if (end >= 0 && line.index > end) {
        toml = atRoot(toml.slice(0, line.index) + toml.slice(line.index + line[0].length).replace(/^\n/, ""));
        report("codex   " + file, true);
      } else if (alive) report("codex   " + file, false);
      else { toml = toml.replace(line[0], ours); report("codex   " + file, true); }
    }
    // Our marker somewhere the line regex could not read (hand-edited formatting,
    // a comment): leave it alone rather than appending a second notify key.
    else if (withoutBlock(toml).includes("/.agentbar/hooks/codex/")) report("codex   " + file, false);
    else if (/^\s*notify\s*=/m.test(toml)) console.error(`skip: ${file} already has a notify hook — left untouched`);
    else {
      toml = atRoot(toml);
      report("codex   " + file, true);
    }

    // The hooks block — the real integration. Codex speaks Claude's dialect, so
    // these point at the shared claude/ scripts through codex/hook.js, which is
    // where AGENTBAR_AGENT and the row prefix get set (Codex handlers have no
    // `env` field). Array-of-tables, not dotted keys, because Codex writes its own
    // [hooks.state] when a human trusts a hook and a dotted `hooks.X` would make
    // that a redefinition. Appended at the end, because a bare key written after a
    // [[table]] header belongs to that table.
    const shim = path.join(hooksDir, "codex", "hook.js");
    const codexEvents = [
      ["SessionStart", "lifecycle.js start", 5],
      ["SessionEnd", "lifecycle.js end", 3],      // Codex clamps this one to 3s
      ["UserPromptSubmit", "update.js prompt", 5],
      ["PreToolUse", "update.js pre", 5],
      ["PostToolUse", "update.js post", 5],
      ["Stop", "update.js stop", 5],
      // Above permission.js's own 600s wait, so the hook gives up first and falls
      // through to Codex's prompt rather than being killed mid-wait.
      ["PermissionRequest", "permission.js", 630],
    ];
    const blockLines = [CODEX_BEGIN];
    for (const [event, tail, timeout] of codexEvents) {
      blockLines.push(`[[hooks.${event}]]`, `[[hooks.${event}.hooks]]`, 'type = "command"',
                      `command = "\\"${node}\\" \\"${shim}\\" ${tail}"`, `timeout = ${timeout}`);
      if (event === "PermissionRequest") blockLines.push('statusMessage = "Waiting for you in AgentBar"');
      blockLines.push("");
    }
    blockLines.push(CODEX_END);
    const block = blockLines.join("\n");

    const b = toml.indexOf(CODEX_BEGIN);
    const e = b < 0 ? -1 : toml.indexOf(CODEX_END, b);
    if (b >= 0 && e >= 0) {
      const current = toml.slice(b, e + CODEX_END.length);
      if (current === block) report("codex hooks   " + file, false);
      else { toml = toml.slice(0, b) + block + toml.slice(e + CODEX_END.length); report("codex hooks   " + file, true); }
    } else {
      if (toml && !toml.endsWith("\n")) toml += "\n";
      if (toml) toml += "\n";
      toml += block + "\n";
      report("codex hooks   " + file, true);
    }
    if (toml !== original) writeConfig(file, toml);
  }

  // Cursor — ~/.cursor/hooks.json (command is a single executable path)
  const cursorDir = path.join(os.homedir(), ".cursor");
  if (on("cursor") && fs.existsSync(cursorDir)) {
    const file = path.join(cursorDir, "hooks.json");
    const root = readConfig(file);
    if (root !== null) {
      root.version = root.version || 1;
      const hooks = root.hooks && typeof root.hooks === "object" ? root.hooks : {};
      for (const ev of ["sessionStart", "sessionEnd", "preToolUse", "postToolUse", "afterAgentResponse", "stop"]) {
        hooks[ev] = (Array.isArray(hooks[ev]) ? hooks[ev] : [])
          .filter((r) => !String(r.command || "").includes("/.agentbar/hooks/cursor/"))
          .concat([{ command: cursorJs }]);
      }
      root.hooks = hooks;
      report("cursor  " + file, writeIfChanged(file, root));
    }
  }

  // Antigravity — ~/.gemini/antigravity{,-cli}/hooks.json. Top level is named rule
  // groups; we own exactly one key ("agentbar") and never touch the rest. The script
  // runs via its shebang, and the stdin payload carries no event name, so the event
  // rides along as an argument. Observational only: PreToolUse writes no stdout.
  const antigravityJs = path.join(hooksDir, "antigravity", "antigravity.js");
  const antigravityDirs = ["antigravity", "antigravity-cli"]
    .map((d) => path.join(os.homedir(), ".gemini", d))
    .filter((d) => fs.existsSync(d));
  if (on("antigravity") && antigravityDirs.length) {
    pinNodeShebang(antigravityJs);
    const group = {};
    for (const ev of ["PreInvocation", "PreToolUse", "PostToolUse", "PostInvocation", "Stop"]) {
      const rule = { hooks: [{ type: "command", command: `"${antigravityJs}" ${ev}`, timeout: 5 }] };
      if (ev.endsWith("ToolUse")) rule.matcher = "*";
      group[ev] = [rule];
    }
    for (const agDir of antigravityDirs) {
      const file = path.join(agDir, "hooks.json");
      const root = readConfig(file);
      if (root === null) continue;
      root.agentbar = group;
      report("antigr  " + file, writeIfChanged(file, root));
    }
  }

  // Gemini — ~/.gemini/settings.json (timeout in ms)
  const geminiDir = path.join(os.homedir(), ".gemini");
  if (on("gemini") && fs.existsSync(geminiDir)) {
    const file = path.join(geminiDir, "settings.json");
    const root = readConfig(file);
    if (root !== null) {
      const hooks = root.hooks && typeof root.hooks === "object" ? root.hooks : {};
      const cmd = `"${node}" "${path.join(hooksDir, "gemini", "gemini.js")}"`;
      const ours = (g) => (g.hooks || []).some((h) => String(h.command || "").includes("/.agentbar/hooks/gemini/"));
      for (const ev of ["SessionStart", "SessionEnd", "BeforeAgent", "BeforeTool", "AfterTool", "AfterAgent"]) {
        hooks[ev] = (Array.isArray(hooks[ev]) ? hooks[ev] : []).filter((g) => !ours(g))
          .concat([{ hooks: [{ type: "command", command: cmd, timeout: 5000 }] }]);
      }
      root.hooks = hooks;
      report("gemini  " + file, writeIfChanged(file, root));
    }
  }

  // Qwen Code — ~/.qwen/settings.json. Qwen speaks Claude-style hooks (same event
  // names, same stdin JSON), so the claude/ scripts serve it as-is with
  // AGENTBAR_AGENT naming the rows — the same reuse the macOS installer does.
  // Observational events only: Qwen's PermissionRequest decision contract is
  // unverified against permission.js, and a blocking hook must never be wired on
  // faith. Timeouts here are milliseconds (Qwen), not seconds (Claude).
  const qwenDir = path.join(os.homedir(), ".qwen");
  if (on("qwen") && fs.existsSync(qwenDir)) {
    const file = path.join(qwenDir, "settings.json");
    const root = readConfig(file);
    if (root !== null) {
      const hooks = root.hooks && typeof root.hooks === "object" ? root.hooks : {};
      for (const [ev, rules] of Object.entries(hooks)) {
        if (!Array.isArray(rules)) continue;
        const kept = rules.filter((rule) => !((rule.hooks || []).some((h) => String(h.command || "").includes("/.agentbar/hooks/claude/"))));
        if (kept.length) hooks[ev] = kept; else delete hooks[ev];
      }
      const qwenEvents = [
        ["SessionStart", `"${node}" "${dir}/lifecycle.js" start`, false],
        ["SessionEnd", `"${node}" "${dir}/lifecycle.js" end`, false],
        ["UserPromptSubmit", `"${node}" "${dir}/update.js" prompt`, false],
        ["PreToolUse", `"${node}" "${dir}/update.js" pre`, true],
        ["PostToolUse", `"${node}" "${dir}/update.js" post`, true],
        // Qwen splits the failure paths into their own events; without them a
        // turn that errors out keeps animating as if it were still working.
        ["PostToolUseFailure", `"${node}" "${dir}/update.js" post`, true],
        ["Stop", `"${node}" "${dir}/update.js" stop`, false],
        ["StopFailure", `"${node}" "${dir}/update.js" fail`, false],
      ];
      for (const [ev, cmd, matcher] of qwenEvents) {
        const rule = { hooks: [{ type: "command", command: cmd, timeout: 5000, env: { AGENTBAR_AGENT: "qwen" } }] };
        if (matcher) rule.matcher = "*";
        hooks[ev] = (hooks[ev] || []).concat([rule]);
      }
      root.hooks = hooks;
      report(`qwen    ${file}`, writeIfChanged(file, root));
    }
  }

  // GitHub Copilot CLI — ~/.copilot/hooks/agentbar.json (or $COPILOT_HOME/hooks).
  // The PascalCase event names deliver the VS Code/Claude payload shape, so the
  // claude/ scripts serve Copilot unchanged, same reuse as Qwen above.
  // `exec` + `args` runs node directly: a bash wrapper would make the hook's parent
  // a shell that exits at once, and ppid is the liveness handle rows are pruned by.
  // permissionRequest blocks and decides, which is what remote Allow/Deny needs; it
  // stayed unwired until its payload had been logged off a real session rather than
  // taken on faith (Scripts/hooks/copilot/README.md). Not preToolUse: those are
  // fail-CLOSED on a crash, so one unhandled exception would silently deny a tool call.
  // AgentBar owns this whole file; Copilot loads every *.json in the dir, so the
  // user's own hooks live in theirs and are never touched.
  const copilotDir = process.env.COPILOT_HOME || path.join(os.homedir(), ".copilot");
  if (on("copilot") && fs.existsSync(copilotDir)) {
    const file = path.join(copilotDir, "hooks", "agentbar.json");
    const copilotEvents = [
      ["SessionStart", "lifecycle.js", "start"],
      ["SessionEnd", "lifecycle.js", "end"],
      ["UserPromptSubmit", "update.js", "prompt"],
      ["PreToolUse", "update.js", "pre"],
      ["PostToolUse", "update.js", "post"],
      // A failed tool call is still mid-turn: keep the session working.
      ["PostToolUseFailure", "update.js", "post"],
      ["Stop", "update.js", "stop"],
      // Only Copilot reports errors as their own event; update.js reads the
      // payload's `recoverable` so a retry doesn't end the turn early.
      ["ErrorOccurred", "update.js", "fail"],
    ];
    const hooks = {};
    for (const [ev, script, arg] of copilotEvents) {
      hooks[ev] = [{ type: "command", exec: node, args: [`${dir}/${script}`, arg],
                     timeoutSec: 5, env: { AGENTBAR_AGENT: "copilot" } }];
    }
    // The blocking one. Its timeout sits ABOVE the hook's own wait (600s) so the
    // hook gives up first and exits silently into the terminal prompt — the other
    // way round, Copilot would kill it mid-wait. Claude's entry uses 630 likewise.
    hooks.permissionRequest = [{ type: "command", exec: node,
                                 args: [`${dir}/permission.js`],
                                 timeoutSec: 630, env: { AGENTBAR_AGENT: "copilot" } }];
    fs.mkdirSync(path.dirname(file), { recursive: true });
    report(`copilot ${file}`, writeIfChanged(file, { version: 1, hooks }));
  }

  // OpenCode — ~/.config/opencode/plugins/agentbar.js. OpenCode loads JS plugins
  // from its config dir; ours observes the event bus and mirrors it into state
  // files. Copied on change, same refresh-with-the-installer rule as macOS — and,
  // like there, not diffed or backed up: it is AgentBar's own code, not a setting
  // of the person's, and an old copy of it is nothing to go back to.
  const opencodeDir = path.join(os.homedir(), ".config", "opencode");
  if (on("opencode") && fs.existsSync(opencodeDir)) {
    const file = path.join(opencodeDir, "plugins", "agentbar.js");
    const src = fs.readFileSync(path.join(hooksDir, "opencode", "agentbar.js"), "utf8");
    let changed = true;
    try { changed = fs.readFileSync(file, "utf8") !== src; } catch {}
    if (changed) {
      fs.mkdirSync(path.dirname(file), { recursive: true });
      const t = file + "." + process.pid + ".tmp";
      fs.writeFileSync(t, src);
      fs.renameSync(t, file);
    }
    report("opencode " + file, changed);
  }

  // The Claude Code mod — copied every run (it is inert until Claude Code is told
  // where it is), wired only when switched on: ~/.agentbar/wire-enabled, which
  // `agentbar wire claude-mod`, `--only …,claude-mod` and the app's switch write.
  copyMods(path.join(__dirname, "..", "mods"), path.join(base, "mods"));
  if (on("claude-mod")) wireClaudeMod(claudeDirs);
  console.log("Done. Start a NEW agent session to see it (hooks snapshot at session start).");
  if (backupsKept) console.log(`Each settings file changed above was kept as it was, beside itself (*${BACKUP_MARK}<time>; the last ${BACKUP_KEEP} stay).`);
}

// MARK: - report (bring your own agent)

// One session row for an agent AgentBar has no hooks for: a wrapper script, a
// bridge in another language, an agent that exists only on your machine. Same
// schema and mechanics as the hooks (Scripts/hooks/claude/update.js), so a row
// written here is indistinguishable from one written there — except that there is
// deliberately no `permission` state. An approval is a rendezvous with a hook that
// blocks while the human decides; a one-shot call has nothing waiting on the
// answer, so a report can never create one and never touches requests.d.
const REPORT_STATES = { idle: 1, thinking: 1, tool: 1, question: 1, done: 1, error: 1, end: 1 };
const REPORT_FLAGS = ["agent", "state", "label", "name", "project", "cwd", "session", "pid", "prompt", "recap"];
// The hooks' rules, copied rather than shared: the CLI is one file with no imports.
const rSafeId = (s) => String(s || "").replace(/[^A-Za-z0-9_.-]/g, "").slice(0, 64) || "unknown";
const rPaired = (k, v) => (typeof v === "string"
  ? v.replace(/[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/g, "")
  : v);
const rSliceSafe = (s, n) => {
  const cut = s.slice(0, n);
  const last = cut.charCodeAt(cut.length - 1);
  return last >= 0xd800 && last <= 0xdbff ? cut.slice(0, -1) : cut;
};
// \s covers newlines and tabs; the other control characters (an ESC from a
// coloured log line) are dropped, not spaced, so a label cannot repaint a terminal.
const rOneLine = (s, n) => rSliceSafe(String(s).replace(/[\u0000-\u0008\u000E-\u001F\u007F-\u009F]/g, "")
  .replace(/\s+/g, " ").trim(), n);

function reportSession(argv) {
  const usage = "usage: agentbar report --agent ID --state STATE [--label L] [--name N] [--project P]"
    + " [--cwd C] [--session S] [--pid N] [--prompt T] [--recap T]";
  const refuse = (msg) => { console.error("agentbar report: " + msg); console.error(usage); process.exit(2); };
  const o = {};
  for (let i = 0; i < argv.length; i++) {
    const m = /^--([a-z]+)(?:=(.*))?$/s.exec(argv[i]);
    if (!m || !REPORT_FLAGS.includes(m[1])) refuse(`unknown argument ${JSON.stringify(argv[i])}`);
    let v = m[2];
    if (v === undefined) {
      if (i + 1 >= argv.length) refuse(`--${m[1]} needs a value`);
      v = argv[++i];
    }
    o[m[1]] = v;
  }
  const agent = o.agent || "";
  // Not sanitised into shape: an id is what every frontend keys a sprite, a quota
  // and a history line by, and a silently rewritten one is a second agent.
  if (!/^[a-z0-9-]{1,32}$/.test(agent))
    refuse(`--agent must be 1-32 characters of a-z, 0-9 and "-" (got ${JSON.stringify(agent)})`);
  const state = o.state || "";
  if (state === "permission")
    refuse(`"permission" is not a state a report can set: an approval needs a hook that waits for the answer,`
      + ` and a report has none. Use "question" when the agent is waiting on its user.`);
  if (!REPORT_STATES[state]) refuse(`--state must be one of ${Object.keys(REPORT_STATES).join("|")} (got ${JSON.stringify(state)})`);
  let pid = process.ppid;
  if (o.pid !== undefined) {
    if (!/^[0-9]+$/.test(o.pid) || Number(o.pid) <= 0) refuse(`--pid must be a positive integer (got ${JSON.stringify(o.pid)})`);
    pid = Number(o.pid);
  }
  const cwd = path.resolve(o.cwd !== undefined && o.cwd !== "" ? o.cwd : process.cwd());
  // Default identity: one row per agent per project directory. The cwd is what a
  // wrapper's successive one-shot calls share; the caller's pid is not (every call
  // is a new process) and the ppid only is when every call comes from the same
  // shell. Two runs of one agent in one directory need --session to stay two rows.
  const dir = path.basename(cwd);
  const sessionId = rSafeId(o.session !== undefined ? o.session : `${agent}-${dir || pid}`);
  const file = path.join(stateDir, sessionId + ".json");

  if (state === "end") {
    // Removing the file is the protocol's `end` (state "end" is never written).
    try { fs.rmSync(file, { force: true }); } catch (e) { console.error("agentbar report: " + e.message); process.exit(1); }
    return;
  }

  const prev = readJSON(file) || {};
  const ts = now();
  const out = {
    ...prev,
    agent, state,
    // A hint for the CURRENT state, so it is not carried into the next one: a row
    // that went from "Editing" to done must not still say "Editing".
    label: o.label !== undefined ? rOneLine(o.label, 80) : "",
    project: o.project !== undefined ? rOneLine(o.project, 80) : (prev.project || dir),
    cwd, sessionId,
    entrypoint: prev.entrypoint || "cli",
    term_program: process.env.TERM_PROGRAM || prev.term_program || "",
    pid, started: true,
    started_at: prev.started_at || ts,
    ts,
  };
  if (o.name !== undefined) {
    const n = rOneLine(o.name, 24);
    if (n) out.agent_name = n; else delete out.agent_name;
  }
  if (o.prompt !== undefined) {
    out.prompt = rOneLine(o.prompt, 120);
    // A new prompt starts a new task: the previous turn's recap and steps are not
    // this one's (protocol: writers MUST drop them, not carry them forward).
    delete out.recap; delete out.activity;
  }
  if (o.recap !== undefined) {
    const r = rOneLine(o.recap, 160);
    if (r) out.recap = r; else delete out.recap;
  }
  try {
    fs.mkdirSync(stateDir, { recursive: true });
    writeAtomic(file, out, rPaired);
  } catch (e) { console.error("agentbar report: " + e.message); process.exit(1); }
}

// MARK: - Main

const [cmd, ...argv] = process.argv.slice(2);
const json = argv.includes("--json");
// Required rather than run — by Scripts/test/shared-fixtures.js, which holds this
// file's half of every rule the app implements too to Tests/Fixtures — nothing
// runs; the functions the fixtures pin are handed over instead.
if (require.main !== module) {
  module.exports = { readRules, decisionShape, decisionShapeOfCall, decisionVerb, parseWireDisabled, loadWireDisabled,
                     loadWireEnabled, effectiveDisabled, modWired, modUnwired,
                     displayName, sessions, plausibleTime };
} else switch (cmd) {
  case "status": case undefined: printStatus(json); break;
  case "requests": printRequests(json); break;
  case "approve": case "allow": decide("allow", argv); break;
  case "deny": decide("deny", argv); break;
  case "answer": answerCmd(argv.filter((a) => a !== "--json")); break;
  case "watch": watch(argv); break;
  case "waybar": waybar(); break;
  case "history": printHistory(argv, json); break;
  case "usage": printUsage(json); break;
  case "approvals": printApprovals(argv, json); break;
  case "rules": printRules(json); break;
  case "forget": forget(); break;
  case "doctor": doctor(json); break;
  case "install-hooks": refuseUnderCustomBase(cmd); installHooks({ args: argv }); break;
  case "wire": refuseUnderCustomBase(cmd); setWired(argv, true); break;
  case "unwire": refuseUnderCustomBase(cmd); setWired(argv, false); break;
  case "report": reportSession(argv); break;
  case "--help": case "help": default:
    console.log(`agentbar — AI coding agents' status & remote approval (file protocol: ${shownBase})

  agentbar [status] [--json]      live sessions
  agentbar requests [--json]      pending approvals with detail
  agentbar approve [n] [--always] answer newest (or n-th) permission
  agentbar deny [n] [--note TEXT]  refuse; the note tells the agent what to do instead
  agentbar answer [n] <label|num>... answer a pending question by option
  agentbar watch [-i SEC]         live view + keys (a allow/A always/d deny/f defer/1-9 answer/q quit);
                                  enables remote approval
  agentbar waybar                 JSON for waybar/polybar (poll <= 30s)
  agentbar history [--days N]     what finished today (or over N days) [--json]
  agentbar usage [--json]         what's left of each provider's quota
  agentbar approvals [--days N]   prompts you keep answering + how long they waited [--json]
                                  --export writes the decisions themselves as CSV
  agentbar rules                  the rules you wrote and what each one has done [--json]
  agentbar forget                 empty the decision ledger
  agentbar doctor [--json]        why an agent isn't showing up: hooks, node path, permissions
  agentbar report --agent ID --state STATE [--label L] [--name N] [--project P] [--cwd C]
                 [--session S] [--pid N] [--prompt T] [--recap T]
                                  show any agent: one row per call; STATE is
                                  idle|thinking|tool|question|done|error|end (end removes it).
                                  Pass --pid with the agent's pid from a one-shot call.
                                  Status only — never an approval
  agentbar install-hooks [--skip a,b] [--only a,b]
                                  wire Claude/Codex/Cursor/Antigravity/Gemini/Qwen/Copilot/OpenCode hooks
                                  (Linux installer); agents in ~/.agentbar/wire-disabled are unwired instead.
                                  --skip adds to that list, --only turns off every agent not named.
                                  The Claude Code mod (claude-mod) is off unless switched on
                                  (~/.agentbar/wire-enabled): \`agentbar wire claude-mod\`
  agentbar unwire <id>            take one agent out (its settings restored, the choice remembered)
  agentbar wire <id>              put it back`);
    break;
}
