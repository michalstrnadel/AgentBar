    case "copilot": {
      const file = path.join(process.env.COPILOT_HOME || path.join(H, ".copilot"), "hooks", "agentbar.json");
      said(`copilot ${file}`, removeConfig(file));
      break;
    }
    case "opencode": {
      const file = path.join(H, ".config", "opencode", "plugins", "agentbar.js");
      said(`opencode ${file}`, removeConfig(file));
      break;
    }
