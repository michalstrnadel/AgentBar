  for (const e of p.events) {
    if (p.kind === "mod" && e.name === "tool.check") add(`can approve or refuse ${tool(e.filter.tool)} without asking you`);
    if (p.kind === "mod" && e.name === "classic.PermissionRequest") add("can answer Claude Code's permission prompts");
    if (p.kind === "mod" && e.name === "tool.call") add(`can hold or refuse ${tool(e.filter.tool)} before ${e.filter.tool ? "they run" : "it runs"}`);
    if (p.kind === "mod" && e.name === "classic.PreToolUse") add(`can allow or block ${tool(e.filter.matcher)} before it runs`);
    if (p.kind === "hooks" && e.name === "PermissionRequest") add("runs a hook on every permission prompt, and that hook can answer it");
    if (p.kind === "hooks" && e.name === "PreToolUse") add(`runs a hook before ${!e.filter.matcher || e.filter.matcher === "*" ? "every tool call" : e.filter.matcher + " calls"} that can allow or block it`);
