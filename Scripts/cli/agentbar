function unwireClaudeMod(claudeDirs) {
  for (const d of claudeDirs) {
    const file = path.join(d, "settings.json");
    if (!fs.existsSync(file)) continue;
    const root = readConfigFile(file);
    if (!isPlainObject(root)) continue;
    const r = modUnwired(root);
    if (r.plan === "write" && writeConfig(file, sortedStringify(r.root) + "\n")) console.log(`unwired  claude-mod ${file}`);
  }
}

// MARK: - Claude Code plugins that can answer for you — PluginInventory, sources only

// Which enabled plugins could settle a prompt before AgentBar sees it: a classic
// PreToolUse/PermissionRequest hook, or a mod on tool.call/tool.check. Read from the
// files and the module sources — doctor never starts `claude`.
const ANSWERING_MOD = new Set(["tool.check", "tool.call", "classic.PreToolUse", "classic.PermissionRequest"]);
const ANSWERING_HOOK = new Set(["PreToolUse", "PermissionRequest"]);
function scanModSource(text) {
  const out = [];
  const re = /\bon\(\s*["']([A-Za-z][A-Za-z0-9_.]*)["']\s*(?:,\s*\{([^{}]*)\})?/g;
  for (let m; (m = re.exec(text));) {
    const filter = {};
    for (const pair of (m[2] || "").split(",")) {
      const [k, v] = pair.split(/:(.*)/s).map((s) => (s || "").trim().replace(/^["']|["']$/g, ""));
      if (k && v) filter[k] = v;
    }
    out.push({ name: m[1], filter });
  }
  return out;
}
function pluginHooks(installPath) {
  let manifest = null;
  try { manifest = JSON.parse(fs.readFileSync(path.join(installPath, ".claude-plugin/plugin.json"), "utf8")); } catch {}
  const files = [path.join(installPath, "hooks/hooks.json")];
  if (manifest && typeof manifest.hooks === "string") files.unshift(path.join(installPath, manifest.hooks));
  const parse = (o, dir) => {
    const modules = (Array.isArray(o.modules) ? o.modules : []).filter((m) => typeof m === "string" && m)
      .map((m) => path.resolve(dir, m));
    const classic = [];
    for (const [ev, rules] of Object.entries(isPlainObject(o.hooks) ? o.hooks : {})) {
      const list = Array.isArray(rules) ? rules : [];
      if (!list.length) classic.push({ name: ev, filter: {} });
      for (const r of list) classic.push({ name: ev, filter: r && typeof r.matcher === "string" ? { matcher: r.matcher } : {} });
    }
    return { modules, classic };
  };
  for (const f of files) {
    const o = readJSON(f);
    if (isPlainObject(o)) return parse(o, path.dirname(f));
  }
  if (manifest && isPlainObject(manifest.hooks)) return parse(manifest.hooks, installPath);
  return { modules: [], classic: [] };
}
