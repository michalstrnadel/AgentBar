      // A default-off integration is never listed in wire-disabled for being left
      // out — it is off already; --only naming it is what switches it on.
      next = new Set([...next].filter((id) => !WIRABLE.includes(id))
        .concat(WIRABLE.filter((id) => !keep.includes(id) && !DEFAULT_OFF.has(id))));
      for (const id of DEFAULT_OFF) { if (keep.includes(id)) enabled.add(id); else enabled.delete(id); }
    }
    for (const id of skipList.length ? wireIds(skipList, "install-hooks --skip") : []) { next.add(id); enabled.delete(id); }
    saveWireDisabled(next);
    saveWireEnabled(enabled);
    console.log(next.size ? `Left alone: ${[...next].sort().join(", ")} (${wireDisabledFile})`
