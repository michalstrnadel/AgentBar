function wireClaudeMod(claudeDirs) {
  const v = claudeVersion();
  if (!modSupports(v)) {
    console.error(`skip   claude-mod  Claude Code ${v} predates mods (${MOD_MIN} or later loads them)`);
    return;
  }
  if (!fs.existsSync(modDir)) { console.error(`skip   claude-mod  ${modDir} is missing — run from a repo checkout`); return; }
  for (const d of claudeDirs) {
    if (!fs.existsSync(d)) continue;
    const file = path.join(d, "settings.json");
    const root = readConfigFile(file);
    if (root === null) continue;
    const r = modWired(root, modDir);
    if (r.plan === "refused") { console.error(`skip: ${file}: ${r.why} — the Claude Code mod is not wired there`); continue; }
    console.log(`${r.plan === "write" && writeConfig(file, sortedStringify(r.root) + "\n") ? "wired" : "ok   "}  claude-mod ${file}`);
  }
}
// Quiet when there was nothing of ours: it is off for nearly everybody, and every
